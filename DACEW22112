        local function addDef(def)
            local old = CM.editing and CM.defs[CM.editing] -- the macro being edited (it may have been renamed)
            local at = old and table.find(CM.defs, old)
            for i = #CM.defs, 1, -1 do
                local d = CM.defs[i]
                if d == old or d.name == def.name then
                    setButton(d, false)
                    Macros[idOf(d)] = nil
                    table.remove(CM.defs, i)
                end
            end
            if old and def.button then def.bx, def.by = old.bx or def.bx, old.by or def.by end
            table.insert(CM.defs, math.min(at or (#CM.defs + 1), #CM.defs + 1), def) -- keeps its place in the list
            register(def)
            if def.button then setButton(def, true) end
            saveDefs()
        end

        -- rename from the list (re-registers the macro and moves its screen button to the new id)
        CM.rename = function(def, text)
            local name = CM.cleanName(text)
            local idx = table.find(CM.defs, def)
            if name == "" or name == def.name or not idx then return false end
            local copy = CM.copyDef(def)
            copy.name = CM.uniqueName(name, def)
            CM.editing = idx
            addDef(copy)
            CM.editing = nil
            return true
        end

        -- the copy sits right under the original, with no key and no screen button (so nothing double-fires)
        CM.duplicate = function(def)
            local copy = CM.copyDef(def)
            copy.name = CM.uniqueName(CM.cleanName(def.name .. " copy"), nil)
            copy.key, copy.button, copy.bx, copy.by = nil, false, nil, nil
            local idx = table.find(CM.defs, def)
            CM.editing = nil
            addDef(copy)
            if idx then
                table.insert(CM.defs, idx + 1, table.remove(CM.defs))
                saveDefs()
            end
        end

