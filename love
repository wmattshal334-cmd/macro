-- ==========================================
-- ASSIST ENGINE (projectile-aware). Snowball launchers only; the RPG never uses it.
-- ==========================================
local AssistSettings = {
    Enabled = false,             -- OFF by default (beta); target tracking still runs every frame regardless
    TargetPlayer = "Auto (Closest)",
    SkipFriends = false,         -- Auto mode never targets your Roblox friends
    Ignored = {},                -- player names the assist never targets in Auto mode
    Effectiveness = 400,
    Solver = false,              -- true = intercept solver (Smart / Custom), false = legacy (Classic / Aggressive)
    Smoothing = 0.6,             -- Solver: how far the click moves from your mouse to the aim point (1 = full)
                                 -- Legacy: lerp strength, same as before
    Prediction = 0.12,           -- legacy modes only (seconds of lead)
    Lead = 1.0,                  -- Solver: multiplier on total lead time (tune if shots land early/late)
    CustomSmoothing = 1.0,
    CustomLead = 1.0,
    SpeedAuto = true,            -- true = use learned projectile speed, false = ManualSpeed
    ManualSpeed = 300,
    ArcComp = true,              -- aim higher to cancel projectile drop (uses learned drop)
    LatencyComp = true,          -- adds half your ping to the lead time
    Marker = true,               -- shows the predicted impact point on screen
    RadiusPresets = { 150, 250, 400, 600, 9999 },
    CrossOn = false,             -- custom aim point (a crosshair you can move): unaimed clicks and the aim start from here
    CrossFrac = Vector2.new(0.5, 0.5), -- its place on screen as a fraction of the screen (0.5, 0.5 = the middle)
}

local WEAPONS = { "golden", "normal", "rpg" } -- Golden + Normal Snowball Launchers, and the RPG (slot 5)

-- ---------- projectile calibration (learned from the real projectiles) ----------
local CAL_FILE = "Exotica_Aim_Calibration.json"
local Projectile = { speed = {}, drop = {}, n = {}, onUpdate = nil }
-- Until a real shot of yours is measured, these are the guessed speeds (studs/second). Snowball launcher shots are fast: a low
-- guess makes Smart lead the target far too much, so the guess is high; the RPG is slower.
local GUESS_SPEED = { golden = 300, normal = 300, rpg = 150 }
local CAL_VERSION = 2 -- bump to throw away saved numbers that may have come from a wrong measurement
for _, w in ipairs(WEAPONS) do
    Projectile.speed[w] = GUESS_SPEED[w] or 200
    Projectile.drop[w] = 0
    Projectile.n[w] = 0
end
-- which of your weapons a tool is (nil when it isn't one of the three)
Projectile.weaponOf = function(tool)
    local tn = tool and tool.Name:lower() or ""
    if tn:find("rpg", 1, true) then return "rpg" end
    if tn:find("gold", 1, true) then return "golden" end
    if tn:find("snow", 1, true) then return "normal" end
    return nil
end

if readfile and isfile and isfile(CAL_FILE) then
    pcall(function()
        local d = HttpService:JSONDecode(readfile(CAL_FILE))
        if d.v ~= CAL_VERSION then return end -- an older file: measure again
        for _, w in ipairs(WEAPONS) do
            local e = d[w]
            if type(e) == "table" and type(e.speed) == "number" and e.speed >= 40 then
                Projectile.speed[w] = e.speed
                Projectile.drop[w] = tonumber(e.drop) or 0
                Projectile.n[w] = math.min(tonumber(e.n) or 0, 5)
            end
        end
    end)
end

local saveQueued = false
local function saveCalibration()
    if not writefile or saveQueued then return end
    saveQueued = true
    task.delay(2, function()
        saveQueued = false
        pcall(function()
            local d = { v = CAL_VERSION }
            for _, w in ipairs(WEAPONS) do
                d[w] = { speed = Projectile.speed[w], drop = Projectile.drop[w], n = Projectile.n[w] }
            end
            writefile(CAL_FILE, HttpService:JSONEncode(d))
        end)
    end)
end

local function updateEstimate(weapon, speed, drop)
    if speed < 40 or speed > 1500 then return end -- slower than that is not a launcher shot (a stray part was matched)
    local n = Projectile.n[weapon] or 0
    local cur = Projectile.speed[weapon]
    if n >= 3 and (speed < cur * 0.5 or speed > cur * 2) then return end -- outlier (wrong part matched)
    if n == 0 then
        Projectile.speed[weapon] = speed
    else
        Projectile.speed[weapon] = cur + (speed - cur) * ((n < 3) and 0.5 or 0.3) -- the first few shots count for more
    end
    if drop and math.abs(drop) < 400 then
        Projectile.drop[weapon] = (n == 0) and drop or (Projectile.drop[weapon] + (drop - Projectile.drop[weapon]) * 0.2)
    end
    Projectile.n[weapon] = n + 1
    saveCalibration()
    if Projectile.onUpdate then pcall(Projectile.onUpdate) end
end

local function currentSpeed(weapon)
    if not AssistSettings.SpeedAuto then return AssistSettings.ManualSpeed end
    return Projectile.speed[weapon] or 120
end

local function myRoot()
    local c = p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

-- Every aimed click is logged. The next new small part that appears near you within
-- 0.8s is matched to the oldest unmatched shot, then its real speed and drop are measured.
local pendingShots = {}
local trackedGroups = setmetatable({}, { __mode = "k" })

local function registerShot(weapon)
    if table.find(WEAPONS, weapon) then
        table.insert(pendingShots, { weapon = weapon, t = clock() })
        if #pendingShots > 12 then table.remove(pendingShots, 1) end
    end
end

local function isCharacterPart(inst)
    for _, plr in ipairs(Players:GetPlayers()) do
        local c = plr.Character
        if c and inst:IsDescendantOf(c) then return true end
    end
    return false
end

local function trackProjectile(part, weapon)
    task.spawn(function()
        local samples = {}
        local startT = clock()
        while part.Parent and clock() - startT < 0.45 do
            table.insert(samples, { t = clock(), p = part.Position })
            RunService.Heartbeat:Wait()
        end
        if #samples < 4 then return end
        local a, b = samples[2], samples[#samples] -- skip the spawn frame
        local dt = b.t - a.t
        if dt < 0.08 then return end
        -- speed from the first quarter second of flight only (later on the arc bends and it may hit something)
        local sb = b
        for i = #samples, 3, -1 do
            if samples[i].t - a.t <= 0.25 then sb = samples[i] break end
        end
        local sdt = sb.t - a.t
        if sdt < 0.08 then sb, sdt = b, dt end
        local speed = (sb.p - a.p).Magnitude / sdt

        local drop = nil
        if #samples >= 7 then
            local m = samples[math.floor((#samples + 2) / 2)]
            if m.t > a.t and b.t > m.t then
                local vy1 = (m.p.Y - a.p.Y) / (m.t - a.t)
                local vy2 = (b.p.Y - m.p.Y) / (b.t - m.t)
                drop = -((vy2 - vy1) / ((b.t - a.t) / 2)) -- positive = falls
            end
        end
        updateEstimate(weapon, speed, drop)
    end)
end

workspace.DescendantAdded:Connect(function(inst)
    if #pendingShots == 0 or not inst:IsA("BasePart") then return end
    local now = clock()
    while pendingShots[1] and now - pendingShots[1].t > 0.8 do table.remove(pendingShots, 1) end
    local shot = pendingShots[1]
    local root = myRoot()
    if not (shot and root) then return end
    if inst.Size.Magnitude > 6 then return end
    if (inst.Position - root.Position).Magnitude > 25 then return end
    if isCharacterPart(inst) then return end
    local group = inst:FindFirstAncestorOfClass("Model") or inst
    if trackedGroups[group] then return end
    trackedGroups[group] = true
    table.remove(pendingShots, 1)
    trackProjectile(inst, shot.weapon)
end)

