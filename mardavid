        rowLabel(row, labelText, 66)

        local track = Instance.new("TextButton")
        track.AnchorPoint = Vector2.new(1, 0.5)
        track.Size = UDim2.new(0, 54, 0, 32)
        track.Position = UDim2.new(1, -12, 0.5, 0)
        track.BackgroundColor3 = initial and COLORS.green or COLORS.gray
        track.BackgroundTransparency = 0.05
        track.BorderSizePixel = 0
        track.Text = ""
        track.AutoButtonColor = false
        track.Parent = row
        corner(track, 16)

        local knob = Instance.new("Frame")
        knob.AnchorPoint = Vector2.new(0, 0.5)
        knob.Size = UDim2.new(0, 28, 0, 28)
        knob.Position = initial and UDim2.new(1, -30, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
        knob.BackgroundColor3 = COLORS.pure
