    -- High-ping watch: when your connection lags, the aim assist and Auto Slot Fix get slower and less accurate,
    -- so you're told once (and the backpack visits pause until it recovers).
    task.spawn(function()
        local Stats = game:GetService("Stats")
        local samples, lastWarn = {}, -1000
        local function readPing()
            local ok, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
            if ok and type(v) == "number" and v > 0 then return v end
            local ok2, v2 = pcall(function() return p:GetNetworkPing() * 2000 end)
            return (ok2 and type(v2) == "number") and v2 or 0
        end
        while isCurrentInstance() do
            task.wait(1)
            samples[#samples + 1] = readPing()
            if #samples > 5 then table.remove(samples, 1) end
            local sum = 0
            for _, x in ipairs(samples) do sum = sum + x end
            local avg = sum / #samples
            if not HighPing and #samples >= 4 and avg > 250 then
                HighPing = true
                if os.clock() - lastWarn > 90 then
                    lastWarn = os.clock()
                    pcall(showNotification, {
                        title = "High Ping Detected",
                        badge = "!",
                        color = COLORS.warn,
                        width = 330,
                        duration = 10,
                        hint = "Connection",
                        sounds = { "popup", "warning" },
                        items = {
                            string.format("Your ping is about %d ms.", math.floor(avg + 0.5)),
                            "While you're laggy, the aim assist and Auto Slot Fix can be slower and less accurate.",
                            "They work normally again as soon as your connection recovers.",
                        },
                    })
                end
            elseif HighPing and avg < 180 then
                HighPing = false
            end
        end
    end)

    ------------------------------------------------------------
    -- Custom Macros (ALPHA): build your own macros from the weapons you own. Saved to a file, run with a key,
    -- a screen button, or the Run button. Includes a "Grenade Launcher" preset (board -> grenade -> click -> board).
    ------------------------------------------------------------
    xpcall(function()
        local KEYS = { "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine", "Zero" }
        local HttpService = game:GetService("HttpService")
        local CM = { defs = {}, file = "ExoticaMacros_custom.json", page = "list", draft = nil, editing = nil, W = 330 }
        local capture = nil -- when set, the next key you press is handed to it

        local function say(title, body)
            if showNotification then
                pcall(showNotification, { title = title, badge = "!", color = COLORS.accent2, body = body, bodyHeight = 30,
                    hint = "Tap to dismiss", duration = 4, sounds = {} })
            end
        end
        local function saveDefs()
            AutoFixMemory.customMacros = CM.defs
            pcall(function() if writefile then writefile(CM.file, HttpService:JSONEncode(CM.defs)) end end)
        end
        local function loadDefs()
            local ok, data = pcall(function()
                if isfile and isfile(CM.file) then return HttpService:JSONDecode(readfile(CM.file)) end
                return AutoFixMemory.customMacros
            end)
            if not (ok and type(data) == "table") then return end
            local clean, used = {}, {}
            for _, def in ipairs(data) do
                if type(def) == "table" and type(def.name) == "string" and def.name ~= "" and type(def.steps) == "table" then
                    local steps = {}
                    for _, st in ipairs(def.steps) do
                        if type(st) == "table" then
                            local good = st.t == "click" or st.t == "wait"
                                or (st.t == "weapon" and type(st.name) == "string")
                                or (st.t == "slot" and type(st.slot) == "number" and KEYS[st.slot] ~= nil)
                                or (st.t == "key" and CM.keyCode(st.key) ~= nil)
                            if good then
                                if st.t == "wait" then st.sec = type(st.sec) == "number" and math.clamp(st.sec, 0, 10) or 0.1 end
                                if st.t == "click" then st.aim = st.aim == true end
                                steps[#steps + 1] = st
                            end
                        end
                    end
                    def.steps = steps
                    local name, n = def.name, 1
                    while used[name] do n = n + 1; name = def.name .. " " .. n end -- two macros can never share an id
                    used[name] = true
                    def.name = name
                    if type(def.key) ~= "string" then def.key = nil end
                    def.button = def.button == true
                    def.loops = CM.loopsOf(def)
                    if type(def.bx) ~= "number" then def.bx = nil end
                    if type(def.by) ~= "number" then def.by = nil end
                    clean[#clean + 1] = def
                end
            end
            CM.defs = clean
        end
        local function idOf(def) return "Custom: " .. def.name end
        -- does any saved custom macro switch to a weapon whose (letters-only) name contains `key`? The slot planner uses
        -- this to leave the Water Balloon Gun alone on the hotbar while a macro needs it.
        ConfigStore.macroUses = function(key)
            for _, def in ipairs(CM.defs) do
                for _, st in ipairs(def.steps or {}) do
                    if st.t == "weapon" and type(st.name) == "string" then
                        local letters = st.name:lower():gsub("[^%w]", "")
                        if letters:find(key, 1, true) then return true end
                    end
                end
            end
            return false
        end

        ------------------------------------------------------------
        -- Builder helpers (fields of CM, so no extra locals)
        ------------------------------------------------------------
        CM.LOOP_MAX = 20
        CM.MAX_STEPS = 60
        CM.loopsOf = function(def)
            return math.clamp(math.floor(tonumber(def.loops) or 1), 1, CM.LOOP_MAX)
        end
        CM.keyCode = function(name)
            if type(name) ~= "string" then return nil end
            local ok, code = pcall(function() return KC[name] end)
            return ok and code or nil
        end
        CM.KEY_LABEL = { One = "1", Two = "2", Three = "3", Four = "4", Five = "5", Six = "6", Seven = "7",
            Eight = "8", Nine = "9", Zero = "0", LeftShift = "Shift" }
        CM.keyLabel = function(name) return CM.KEY_LABEL[name] or tostring(name) end
        CM.fmtTime = function(ms)
            if ms < 1000 then return string.format("%d ms", math.floor(ms + 0.5)) end
            return string.format("%.2f s", ms / 1000)
        end
        CM.cleanName = function(s)
            s = tostring(s or ""):gsub("%c", " ")
            s = s:gsub("^%s+", ""):gsub("%s+$", "")
            return s:sub(1, 30)
        end
        CM.uniqueName = function(name, except)
            local function taken(s)
                for _, d in ipairs(CM.defs) do
                    if d ~= except and d.name == s then return true end
                end
                return false
            end
            local try, n = name, 1
            while taken(try) do n = n + 1; try = name .. " " .. n end
            return try
        end
        CM.copyDef = function(def)
            local c = { name = def.name, loops = def.loops, key = def.key, button = def.button, bx = def.bx, by = def.by, steps = {} }
            for _, st in ipairs(def.steps) do
                local s = {}
                for k, v in pairs(st) do s[k] = v end
                c.steps[#c.steps + 1] = s
            end
            return c
        end
        -- wait length steps: fine under 0.5 s, coarser above
        CM.nudge = function(sec, dir)
            sec = tonumber(sec) or 0.1
            local big = (dir > 0 and sec >= 2) or (dir < 0 and sec > 2)
            local mid = (dir > 0 and sec >= 0.5) or (dir < 0 and sec > 0.5)
            local s = big and 1 or (mid and 0.25 or 0.05)
            return math.clamp(math.floor((sec + dir * s) * 20 + 0.5) / 20, 0, 10)
        end
        CM.textH = function(text, size)
            local ok, v = pcall(function()
