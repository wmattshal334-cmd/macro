    -- UI polish: press / hover animations on the menu buttons, hover sound (mouse), and a slow shimmer on the title
    xpcall(function()
        local TweenService = game:GetService("TweenService")
        local function polishButton(b)
            if b:GetAttribute("Polished") then return end
            b:SetAttribute("Polished", true)
            local sc = b:FindFirstChildOfClass("UIScale")
            if not sc then
                sc = Instance.new("UIScale")
                sc.Parent = b
            end
            b.MouseEnter:Connect(function()
                playEmbedded("hover", 0.22, 0.94 + math.random() * 0.14, 0.3)
                tween(sc, { Scale = 1.04 }, 0.12)
            end)
            b.MouseLeave:Connect(function() tween(sc, { Scale = 1 }, 0.12) end)
            b.InputBegan:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    tween(sc, { Scale = 0.93 }, 0.07)
                end
            end)
            b.InputEnded:Connect(function(i)
                if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                    tween(sc, { Scale = 1 }, 0.14, Enum.EasingStyle.Back)
                end
            end)
        end
        for _, tf in pairs(UI2.tabFrames or {}) do
            for _, d in ipairs(tf:GetDescendants()) do
                if d:IsA("TextButton") then polishButton(d) end
            end
        end
        -- the side panels, the welcome card and the target list get the same press / hover feel (and buttons added later too).
        -- Invisible drag handles are left alone, and so are the on-screen macro buttons and the aim point.
        local function wanted(d)
            return d:IsA("TextButton") and not (d.BackgroundTransparency >= 1 and d.Text == "")
        end
        local function polishTree(root)
            for _, d in ipairs(root:GetDescendants()) do
                if wanted(d) then polishButton(d) end
            end
            root.DescendantAdded:Connect(function(d)
                if wanted(d) then polishButton(d) end
            end)
        end
        for _, ch in ipairs(sg:GetChildren()) do
            if ch:IsA("Frame") and ch ~= main and ch.Name ~= "AimPoint" and ch.Name ~= "Loader" then pcall(polishTree, ch) end
        end
        for _, d in ipairs(main:GetChildren()) do
            if d:IsA("TextLabel") and d.Text == "Exotica Macros" then
                local g = Instance.new("UIGradient")
                g.Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0, COLORS.white),
                    ColorSequenceKeypoint.new(0.5, UI2.stage.color),
                    ColorSequenceKeypoint.new(1, COLORS.white),
                })
                g.Offset = Vector2.new(-1, 0)
                g.Parent = d
                TweenService:Create(g, TweenInfo.new(3.2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Offset = Vector2.new(1, 0) }):Play()
            end
        end
    end, function(err)
        warn("[Exotica] UI polish failed:", tostring(err))
        task.delay(4, function() pcall(ConfigStore.reportBug, "polish", err) end)
    end)

