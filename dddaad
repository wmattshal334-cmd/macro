-- a very soft tick every ~56px of scrolling (never faster than about ten a second, always the same pitch), only while the
-- panel is on screen
local function hookScrollSound(sf, root)
    local lastY = sf.CanvasPosition.Y
    local lastTime = 0
    sf:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        local y = sf.CanvasPosition.Y
        if root.Visible and math.abs(y - lastY) >= 56 and (clock() - lastTime) > 0.09 then
            lastY = y
            lastTime = clock()
            playEmbedded("tick", 0.26, 1, 0.3)
        end
    end)
end

