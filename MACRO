-- UI  (iOS 26 "Liquid Glass" style, matches the loader)
-- ==========================================
local listeningMacro = nil
local hasShownSlotWarning = false -- only the very first macro trigger (any of the 3) shows the warning
local triggerMacro -- forward-declared: assigned below
local core = (gethui and gethui()) or game:GetService("CoreGui")

-- ==========================================
-- SOUNDS: the mp3s are embedded below, written to your executor's workspace folder
-- on first run, then played through getcustomasset. If your executor can't do that,
-- the startup/warning sounds fall back to a built-in Roblox ping and the small UI
-- sounds are simply skipped, so nothing breaks.
-- ==========================================
local SoundService = game:GetService("SoundService")
local ContentProvider = game:GetService("ContentProvider")
local FALLBACK_SOUND = "rbxasset://sounds/electronicpingshort.wav"
local FALLBACK_KEYS = { startup = true, warning = true }
local SoundsEnabled = true -- the "Sounds" switch in the panel flips this
local AutoFixEnabled = true -- the "Auto Slot Fix" switch in the panel flips this
local AutoAccessoryEnabled = true -- the "Auto Accessories" switch flips this
local SCRIPT_VERSION = "2.2 Beta"
local HighPing = false -- set by the ping watch further down
local AutoEquipEnabled = true -- the "Auto Equip" switch flips this
local LastUserInput = os.clock() -- when you last touched the screen/keys (auto-fix waits until you're still)
local SynthDragging = false -- true only while the script's own virtual drag is running
local LastCombat = os.clock() - 100 -- last time you fought (took damage, swung a tool, fired a macro)
local AutoFixMemory = {} -- survives re-running the script in the same game session (executor memory), when available
pcall(function()
    local env = getgenv()
    env.__ExoticaAutoFixMemory = env.__ExoticaAutoFixMemory or {}
    AutoFixMemory = env.__ExoticaAutoFixMemory
end)
do
    local uis = game:GetService("UserInputService")
    uis.InputBegan:Connect(function() if not SynthDragging then LastUserInput = os.clock() end end)
    uis.InputChanged:Connect(function() if not SynthDragging then LastUserInput = os.clock() end end)
end

