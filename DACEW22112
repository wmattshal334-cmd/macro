            local rep = slotGlow.comboReport()
            if rep.ready then
                if #rep.missing == 0 and #rep.low == 0 then return end
                local quiet = activeToast == nil and os.clock() - LastUserInput > 5 and os.clock() - LastCombat > 8
                if quiet then
                    if #rep.missing > 0 and not shownMissing then
                        shownMissing = true
                        local list = {}
                        for i = 1, math.min(#rep.missing, 5) do list[#list + 1] = rep.missing[i] end
                        pcall(showNotification, {
                            title = "Incompatible Weapons Detected",
                            badge = "!",
                            color = COLORS.warn,
                            width = 340,
                            duration = 16,
                            hint = "Weapon combo screen",
                            sounds = { "popup", "warning" },
                            items = {
                                "The script may not work properly because you don't have the required weapons in your slots.",
                                "Missing: " .. table.concat(list, ", ") .. ".",
                                "Go to the weapon combo screen to get the weapons you need.",
                            },
                        })
                    elseif #rep.low > 0 and not shownLow then
                        shownLow = true
                        pcall(showNotification, {
                            title = "Low-Grade Combo Detected",
                            badge = "!",
                            color = COLORS.warn,
                            width = 340,
                            duration = 14,
                            hint = "Weapon Tiers menu",
                            sounds = { "pop" },
                            items = {
                                "Your combo uses low-grade weapons: " .. table.concat(rep.low, ", ") .. ".",
                                "Performance and results will be weaker than they could be. Get better weapons for the best experience.",
                                "Open Weapon Tiers in the menu to see what's best.",
                            },
                        })
                    end
                    if (shownMissing or #rep.missing == 0) and (shownLow or #rep.low == 0) then return end
                end
            end
            task.wait(4)
        end
    end)

    -- What's-new notice, shown every time the script starts, but never right away: it waits until
    -- you've been idle for a few seconds (no taps, clicks, movement or macros) and nothing else is on
    -- screen, so it can actually be read. It is the lowest priority banner: if another one (slot
    -- warning, assist beta heads-up) bumps it off before it finishes, it waits for quiet and returns.
    local updateNoticeDone = false
    local lastInput = clock() -- starts now, so the very first moments after launch never count as idle
    UIS.InputBegan:Connect(function() lastInput = clock() end)
    UIS.InputChanged:Connect(function() lastInput = clock() end)

    local function tryShowUpdateNotice(attempt)
        if updateNoticeDone then return end
        local quiet = activeToast == nil and Engine.run == nil
            and (clock() - lastMacroTime) > 4
            and (clock() - lastInput) > 8
        if not quiet then
            if attempt < 900 then -- keep checking about once a second, for up to ~15 minutes
                task.delay(1, function() tryShowUpdateNotice(attempt + 1) end)
            end
            return
        end
        updateNoticeDone = true
        local noticeItems = {
            "3.6: a new aurora intro, a restyled Custom Macros panel, and a Templates gallery (Snowball Burst, RPG Snipe, Board Swing and more).",
            "3.5: Custom Macros rebuilt: add, reorder and delete steps, set exact wait times, repeat, a live time preview, a Test button, rename and duplicate.",
            "3.4: new cinematic loading screen, a movable aim point, screen buttons always tap on phones, and Auto Slot Fix stays out of fights and only moves items it recognises (switch: Evict unknown items).",
            "3.3: phone slot switching no longer uses key presses, sliders ignore a second finger, Grenade shots no longer feed the Normal launcher's speed, Auto Slot Fix stays on its fast drag method, and Crew Spray is kept off the hotbar.",
            "3.2: fixed phone macros freezing your movement, stuck taps and screen buttons, plus Auto Slot Fix and Custom Macros fixes.",
            "Phone fixes: on touch devices the macros now tap the middle of the screen (your shift-lock reticle) instead of moving a mouse. A new Shot method button lets you pick Mouse, Screen tap or Tool.",
            "Screen buttons only react to the finger that pressed them, so moving with your thumb no longer cancels a tap. The button sound is gone.",
            "Your settings are now remembered: switches, aim mode, target and more. Auto-save is on, and there's a Save now button.",
            "The normal Kitty Stanley is no longer mistaken for the Spiked one.",
            "Still Alpha, so expect bugs. Tell me what you find.",
        }
        if DISCORD_TAG ~= "" then
            table.insert(noticeItems, #noticeItems, "Need help? Tap the blue Need help? button in the menu to copy my Discord tag.")
        end
        local ok = pcall(showNotification, {
            title = "Update " .. SCRIPT_VERSION .. " " .. SCRIPT_STAGE .. ": What's New",
            badge = "NEW",
            badgeSize = 10,
            color = UI2.stage.color,
            width = 340,
            duration = 34,
            hint = "Tap to dismiss",
            sounds = { "reveal" },
            onClose = function(reason)
                if reason == "replaced" then -- bumped off by another banner before it was read
                    updateNoticeDone = false
                    task.delay(1, function() tryShowUpdateNotice(1) end)
                end
            end,
            items = noticeItems,
        })
        if not ok then updateNoticeDone = true end -- a rendering problem must never loop or block anything
    end
    task.delay(1, function() tryShowUpdateNotice(1) end)

    ------------------------------------------------------------
    -- Input handling (keybinds fire the macros)
    ------------------------------------------------------------
    UIS.InputBegan:Connect(function(input, gpe)
        local k = input.KeyCode
        if k == KC.Unknown then return end
        if gpe and input.UserInputType == Enum.UserInputType.Keyboard then return end
        -- a key the Custom Macros panel is capturing / just captured is not a macro trigger
        if UI2.swallow == input or (UI2.isCapturing and UI2.isCapturing()) then return end

        if listeningMacro then
            local name = listeningMacro
            Config[name].Key = k
            keyButtons[name].Text = k.Name
            keyButtons[name].TextColor3 = COLORS.accent
            listeningMacro = nil
            UI2.swallow = input -- so a custom macro bound to this key doesn't fire too
            task.delay(0.2, function() if UI2.swallow == input then UI2.swallow = nil end end)
            saveKeybinds()
            playEmbedded("confirm", 0.55, 1.1, 1.3)
            return
        end

        for name, cfg in pairs(Config) do
            -- Thumbstick1 is an axis and never fires InputBegan; a stick click is ButtonL3
            if k == cfg.Key or (cfg.Key == KC.Thumbstick1 and k == KC.ButtonL3) then
                triggerMacro(name)
                break
            end
        end
    end)
end, function(err)
