                local skipped = info.skippedAt[i]
                newLabel(row, { Size = UDim2.new(0, descW, 0, 16), Position = UDim2.new(0, 10, 0, 4), Font = Enum.Font.GothamMedium,
                    Text = i .. ". " .. describe(st) .. (skipped and "  ⚠" or ""), TextSize = 11,
                    TextColor3 = skipped and COLORS.warn or COLORS.white,
                    TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
                newLabel(row, { Size = UDim2.new(0, descW, 0, 12), Position = UDim2.new(0, 10, 0, 22),
                    Text = string.format("at %.2f s", (info.at[i] or 0) / 1000), TextSize = 9, TextColor3 = COLORS.muted,
                    TextXAlignment = Enum.TextXAlignment.Left })
                if isWait then
                    mkBtn(row, "−", 86, 8, 24, 24, COLORS.gray, function()
                        CM.edit(function() st.sec = CM.nudge(st.sec, -1) end)
                    end)
                    local box = Instance.new("TextBox")
                    box.Position = UDim2.new(0, 112, 0, 8)
                    box.Size = UDim2.new(0, 56, 0, 24)
                    box.BackgroundColor3 = COLORS.white
                    box.BackgroundTransparency = 0.85
                    box.BorderSizePixel = 0
                    box.Font = Enum.Font.GothamBold
                    box.TextSize = 11
                    box.TextColor3 = COLORS.accent
                    box.ClearTextOnFocus = true
                    box.Text = string.format("%.2f s", st.sec or 0.1)
                    box.Parent = row
                    corner(box, 8)
                    box.FocusLost:Connect(function()
                        local v = tonumber((box.Text:gsub("[^%d%.]", "")))
                        if not v then box.Text = string.format("%.2f s", st.sec or 0.1) return end
                        v = math.clamp(math.floor(v * 100 + 0.5) / 100, 0, 10)
                        if v == st.sec then box.Text = string.format("%.2f s", v) return end -- unchanged: no redraw, so a tap elsewhere still lands
                        CM.edit(function() st.sec = v end)
                    end)
                    mkBtn(row, "+", 170, 8, 24, 24, COLORS.gray, function()
                        CM.edit(function() st.sec = CM.nudge(st.sec, 1) end)
