            -- live time preview
            local card = mkRow(y, 44)
            local headline
            if nSteps == 0 then headline = "No steps yet"
            elseif info.loops > 1 then
                headline = string.format("🕒 %s per run · %d× = %s total", CM.fmtTime(info.per), info.loops, CM.fmtTime(info.total))
            else headline = "⏱ " .. CM.fmtTime(info.per) .. " total" end
            newLabel(card, { Size = UDim2.new(1, -20, 0, 18), Position = UDim2.new(0, 10, 0, 6), Font = Enum.Font.GothamBold, Text = headline,
                TextSize = 12, TextColor3 = COLORS.accent, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd })
            newLabel(card, { Size = UDim2.new(1, -20, 0, 14), Position = UDim2.new(0, 10, 0, 25),
