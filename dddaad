        local down, grabbed, moved, pressedAt, startMouse, startPos = false, false, false, 0, Vector2.new(), b.Position
        local myInput = nil -- the exact finger / mouse press that started on this button
        local function finished(inp)
            local s = inp.UserInputState
            return s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel
        end
        b.InputBegan:Connect(function(i)
            local t = i.UserInputType
            if not (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) then return end
            -- a previous press that ended / was cancelled without us hearing about it must not block this one
            if down and myInput and myInput ~= i and finished(myInput) then
                down = false
                sc.Scale = 1
            end
            if down then return end
            myInput = i
            down, grabbed, moved = true, false, false
            pressedAt = os.clock()
            startMouse = Vector2.new(i.Position.X, i.Position.Y)
            startPos = b.Position
