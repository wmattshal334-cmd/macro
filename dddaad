                CM.sync()
                keyBtn.Text = "Press a key..."
                capture = function(k)
                    if k == "Escape" then d.key = nil
                    elseif k ~= "Unknown" then
                        d.key = k
                        for name, cfg in pairs(Config) do
                            if cfg.Key.Name == k then
                                say("Key already used", k .. " also runs the " .. name .. " macro. Both would fire.")
                            end
                        end
                        for _, other in ipairs(CM.defs) do
                            if other.key == k and other.name ~= d.name then
                                say("Key already used", k .. " also starts \"" .. other.name .. "\". Both would fire.")
                            end
                        end
                    end
