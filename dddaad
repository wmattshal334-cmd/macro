        local kids = {}
        for _, k in ipairs(parent:GetChildren()) do
            if k:IsA("GuiObject") and k.Visible and UI2.fx[k] and k.Position.Y.Offset >= (opts.minY or -1e9) then
                kids[#kids + 1] = k
            end
        end
        table.sort(kids, function(a, b)
            if layout then return a.LayoutOrder < b.LayoutOrder end
            return a.Position.Y.Offset < b.Position.Y.Offset
        end)
        local dx, step = opts.dx or 26, opts.step or 0.045
