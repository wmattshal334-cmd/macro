        -- everything above is faded in and out with the card; the page contents below do their own animation
        local ctrl = makePanelController(panel, pScale, makeFader(panel))

        local TextService = game:GetService("TextService")
        local rowW = GW - 28 - 6
        local function plain(s) return (s:gsub("<[^>]+>", "")) end
        -- remembers the normal look of an element (and everything inside it) so it can be faded in and out
        local function gather(root)
            local list = {}
            local function one(inst)
                if inst:IsA("GuiObject") then
                    list[#list + 1] = { inst = inst, prop = "BackgroundTransparency", orig = inst.BackgroundTransparency }
                    if inst:IsA("TextLabel") or inst:IsA("TextButton") then
                        list[#list + 1] = { inst = inst, prop = "TextTransparency", orig = inst.TextTransparency }
                    end
                elseif inst:IsA("UIStroke") then
                    list[#list + 1] = { inst = inst, prop = "Transparency", orig = inst.Transparency }
                end
            end
            one(root)
            for _, d in ipairs(root:GetDescendants()) do one(d) end
            return list
        end

