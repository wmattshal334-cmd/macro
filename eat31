            local idx = table.find(CM.defs, def)
            if name == "" or name == def.name or not idx then return false end
            local copy = CM.copyDef(def)
            copy.name = CM.uniqueName(name, def)
            CM.editing = idx
            addDef(copy)
            CM.editing = nil
            return true
        end

