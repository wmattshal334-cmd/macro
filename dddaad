            mkBtn(sr, d.button and "On" or "Off", ROW_W - 134, 8, 126, 28, d.button and COLORS.green or COLORS.gray, function()
                CM.edit(function() d.button = not d.button end)
            end)
            y = y + 52

            -- things worth knowing
            local notes = {}
            if #info.missing > 0 then
                notes[#notes + 1] = { "⚠ Not on your hotbar right now: " .. table.concat(info.missing, ", ")
                    .. ". Those steps are skipped until the weapon is back.", COLORS.warn }
            end
            local hasAim = false
            for _, st in ipairs(d.steps) do if st.t == "click" and st.aim then hasAim = true break end end
            if hasAim and not AssistSettings.Enabled then
                notes[#notes + 1] = { "ℹ Aimed clicks only aim while the Assist switch is on. With it off they click the screen centre.", COLORS.muted }
            end
            if hasAim and ClickMode == "Tool" then
                notes[#notes + 1] = { "ℹ Shot method is Tool, which can't aim. Switch it to Mouse click or Screen tap.", COLORS.muted }
            end
            local lastSt = d.steps[nSteps]
            if lastSt and lastSt.t == "wait" and loops == 1 then
                notes[#notes + 1] = { "ℹ A wait at the very end changes nothing unless the macro repeats.", COLORS.muted }
            end
            if info.total > 20000 then
                notes[#notes + 1] = { "❗ This runs for " .. CM.fmtTime(info.total) .. ". Use Stop in Test, or trigger it again to restart it.", COLORS.warn }
