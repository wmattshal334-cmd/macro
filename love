        CM.addTemplate = function(tpl, thenEdit)
            local steps, err = tpl.build()
            if not steps then say("Can't add " .. tpl.name, err or "Something it needs is missing.") return end
            local def = { name = CM.uniqueName(tpl.name, nil), loops = tpl.loops or 1, steps = steps, button = false }
            if thenEdit then -- open it in the editor first; nothing is saved until you press Save
                CM.draft, CM.editing, CM.dirty = def, nil, true
