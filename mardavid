        "Version: " .. SCRIPT_VERSION .. " " .. SCRIPT_STAGE,
        "Kind: " .. tostring(kind),
        "Detail: " .. string.sub(tostring(detail), 1, 400),
        "Place: " .. tostring(game.PlaceId) .. " | Touch device: " .. tostring(touch) .. " | High ping: " .. tostring(HighPing),
    }, "\n")
    warn("[Exotica] BUG " .. code .. " | " .. tostring(kind) .. ": " .. string.sub(tostring(detail), 1, 200))
    local copied, saved = false, false
    pcall(function() if setclipboard then setclipboard(text) copied = true end end)
    pcall(function() if writefile then writefile("ExoticaMacros_bugreport.txt", text) saved = true end end)
    local tag = (DISCORD_TAG ~= "" and DISCORD_TAG) or "the developer"
    local shownOk = false
    if ConfigStore.notify and not forceBox then
        local items = { "Please tell " .. tag .. " and send this bug code:" }
        if saved then items[#items + 1] = "A report was saved as ExoticaMacros_bugreport.txt." end
        shownOk = pcall(ConfigStore.notify, {
            title = "Bug Detected",
            badge = "!",
            color = Color3.fromRGB(255, 99, 90),
            width = 330,
            duration = 40,
            items = items,
            code = code,
            hint = copied and "Details copied. Tap to copy again" or "Tap to dismiss",
            onTap = function() pcall(function() if setclipboard then setclipboard(text) end end) end,
            sounds = { "error" },
        })
    end
    if not shownOk then
        ConfigStore.bugBox({ "Something went wrong.", "Please tell " .. tag .. " and send this bug code:", code, "(Tap to close. The details were " .. (copied and "copied to your clipboard." or "printed in the console.") .. ")" })
    end
    return code
end
