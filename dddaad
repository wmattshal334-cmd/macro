    local lastMacroTime = -100 -- when a macro last fired (the update notice waits for a quiet moment)
    triggerMacro = function(name)
        if not Macros[name] then return end
        lastMacroTime = clock()
        LastCombat = os.clock()
        if not hasShownSlotWarning then
            hasShownSlotWarning = true
            pcall(showSlotWarning) -- a toast rendering issue must never block the macro from firing
        end
        Macros[name]()
    end

