    local function glassRow(height)
        if container == tabRoot then beginGroup() end
        rowCount += 1
        local row = Instance.new("Frame")
        row.Size = UDim2.new(1, 0, 0, height)
        row.BackgroundTransparency = 1
        row.BorderSizePixel = 0
        row.LayoutOrder = rowCount
        row.Parent = container
        local sep = Instance.new("Frame") -- hairline under the row
        sep.Name = "Sep"
        sep.Size = UDim2.new(1, -56, 0, 1)
        sep.Position = UDim2.new(0, 52, 1, -1)
        sep.BackgroundColor3 = Color3.new(1, 1, 1)
        sep.BackgroundTransparency = 0.93
        sep.BorderSizePixel = 0
        sep.Parent = row
        local grp = container
        row:GetPropertyChangedSignal("Visible"):Connect(function() refreshSeps(grp) end)
        refreshSeps(grp)
        return row
    end

    local function splitEmoji(text) -- "🎯 Assist" -> "🎯", "Assist"
        local emoji, rest = text:match("^([^%w%s%p]+)%s+(.+)$")
        if emoji and rest then return emoji, rest end
        return nil, text
    end
    -- a leading emoji becomes a small frosted-glass tile at the left of the row
    local function iconTile(row, emoji)
        local icon = Instance.new("Frame")
        icon.Size = UDim2.new(0, 30, 0, 30)
        icon.Position = UDim2.new(0, 14, 0.5, -15)
        icon.BackgroundColor3 = Color3.new(1, 1, 1)
        icon.BorderSizePixel = 0
        icon.Parent = row
        corner(icon, 9)
        local ig = Instance.new("UIGradient")
        ig.Rotation = 55
        ig.Transparency = NumberSequence.new(0.72, 0.9)
        ig.Parent = icon
        edgeGradient(stroke(icon, Color3.new(1, 1, 1), 0.5, 1))
        newLabel(icon, { Size = UDim2.new(1, 0, 1, 0), Text = emoji, TextSize = 16, Font = Enum.Font.GothamBold })
    end
    -- the row's text label; rightW = how much room the control on the right needs
    local function rowLabel(row, text, rightW)
        local emoji, rest = splitEmoji(text)
        local x = 16
        if emoji then
            iconTile(row, emoji)
            x = 54
            text = rest
        end
        return newLabel(row, {
            Size = UDim2.new(1, -(rightW + x + 6), 1, 0),
            Position = UDim2.new(0, x, 0, 0),
            Font = Enum.Font.GothamMedium,
            Text = text,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        })
    end

