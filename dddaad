                while mine == S.tok and ctrl.open and S.page == 1 do
                    for _, c in ipairs(S.caps) do
                        if mine ~= S.tok then return end
                        tween(c.cap, { Position = UDim2.new(0, c.x, 0, 3), BackgroundTransparency = 0.55 }, 0.09)
                        task.wait(0.16)
                        tween(c.cap, { Position = UDim2.new(0, c.x, 0, 0), BackgroundTransparency = 0.84 }, 0.3, Enum.EasingStyle.Back)
