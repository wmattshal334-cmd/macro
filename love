-- soft tick every ~40px of scrolling, only while the panel is on screen
local function hookScrollSound(sf, root)
    local lastY = sf.CanvasPosition.Y
    local lastTime = 0
    sf:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        local y = sf.CanvasPosition.Y
        if root.Visible and math.abs(y - lastY) >= 40 and (clock() - lastTime) > 0.05 then
            lastY = y
            lastTime = clock()
            playEmbedded("tick", 0.45, 0.95 + math.random() * 0.15, 0.6)
        end
    end)
end

