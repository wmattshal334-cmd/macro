            table.sort(names, function(a, b) return a.Name:lower() < b.Name:lower() end)
            for _, plr in ipairs(names) do
                addRow(plr.DisplayName .. " (@" .. plr.Name .. ")", plr.Name, true)
            end
            contentH = y
            scroll.CanvasSize = UDim2.new(0, 0, 0, y)
        end

        UI2.openTargets = function()
            local screen = sg.AbsoluteSize
            rebuild()
            panel.Size = UDim2.new(0, TW, 0, math.min(contentH + 60, screen.Y * 0.8))
            local px, py = main.Position.X, main.Position.Y
