            f.BackgroundColor3 = fixed or COLORS.accent
            f.BorderSizePixel = 0
            f.ZIndex = z or 70
            f.Parent = cross
            if round then corner(f, round) end
            parts.live[#parts.live + 1] = f
            if not fixed then parts.fills[#parts.fills + 1] = f end
            return f
        end
        local function ringPart(d, thick, tr)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(0, d, 0, d)
            f.AnchorPoint = Vector2.new(0.5, 0.5)
            f.Position = UDim2.new(0.5, 0, 0.5, 0)
            f.BackgroundTransparency = 1
            f.ZIndex = 70
            f.Parent = cross
            corner(f, d / 2)
            parts.live[#parts.live + 1] = f
            parts.strokes[#parts.strokes + 1] = stroke(f, COLORS.accent, tr or 0.05, thick)
            return f
        end
        local function centerDot(d)
            part(d, d, 0, 0, 0, d / 2, 71, COLORS.pure)
        end
        local BUILD = {
            classic = function()
                ringPart(24, 2)
                part(2, 10, 0, -20) part(2, 10, 0, 20) part(10, 2, -20, 0) part(10, 2, 20, 0)
                centerDot(4)
            end,
            dot = function() part(8, 8, 0, 0, 0, 4) centerDot(3) end,
            plus = function()
                part(2, 9, 0, -11) part(2, 9, 0, 11) part(9, 2, -11, 0) part(9, 2, 11, 0)
                centerDot(3)
            end,
            small = function()
                part(2, 4, 0, -5) part(2, 4, 0, 5) part(4, 2, -5, 0) part(4, 2, 5, 0)
                centerDot(2)
            end,
            ring = function() ringPart(20, 2) centerDot(3) end,
            xmark = function()
                part(2, 9, -7, -7, -45) part(2, 9, 7, 7, -45) part(2, 9, 7, -7, 45) part(2, 9, -7, 7, 45)
            end,
            none = function() end, -- nothing to see; a faint ring appears only while you are placing it
