    -- Loading screen: your avatar, your name and the script's name, a progress bar, and the startup sound.
    -- The menu appears when it finishes. If anything in here fails, the menu simply opens straight away.
    ------------------------------------------------------------
    UI2.runLoader = function(done)
        local finished = false
        local overlay = Instance.new("Frame")
        overlay.Name = "Loader"
        local topInset = 0
        pcall(function() topInset = game:GetService("GuiService"):GetGuiInset().Y end)
        if sg.IgnoreGuiInset then topInset = 0 end
        overlay.Position = UDim2.fromOffset(0, -topInset) -- the menu layer starts below the top bar: reach up over it
        overlay.Size = UDim2.new(1, 0, 1, topInset)
        overlay.BackgroundColor3 = Color3.fromRGB(6, 8, 16)
        overlay.BackgroundTransparency = 1
        overlay.BorderSizePixel = 0
        overlay.ZIndex = 200
        overlay.Active = true
        overlay.Parent = sg

        local card = makeGlass(overlay, 30)
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.Position = UDim2.new(0.5, 0, 0.5, 0)
        card.Size = UDim2.new(0, 330, 0, 250)
        card.ZIndex = 201
        local cScale = Instance.new("UIScale")
        cScale.Parent = card
        local ctrl = makePanelController(card, cScale, makeFader(card))

        -- avatar with a spinning color ring
        local ring = Instance.new("Frame")
        ring.AnchorPoint = Vector2.new(0.5, 0)
        ring.Position = UDim2.new(0.5, 0, 0, 22)
        ring.Size = UDim2.new(0, 100, 0, 100)
        ring.BackgroundColor3 = Color3.new(1, 1, 1)
        ring.BorderSizePixel = 0
        ring.Parent = card
        corner(ring, 50)
        local grad = Instance.new("UIGradient")
        grad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.5, Color3.fromRGB(128, 146, 196)),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
        })
        grad.Parent = ring
        local avatar = Instance.new("ImageLabel")
        avatar.AnchorPoint = Vector2.new(0.5, 0.5)
        avatar.Position = UDim2.new(0.5, 0, 0.5, 0)
        avatar.Size = UDim2.new(0, 90, 0, 90)
        avatar.BackgroundColor3 = COLORS.glass
        avatar.BorderSizePixel = 0
        avatar.ScaleType = Enum.ScaleType.Crop
        avatar.Parent = ring
        corner(avatar, 45)
        task.spawn(function()
            local okT, img = pcall(function()
                return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
            end)
            if okT and img then avatar.Image = img end
        end)

        newLabel(card, {
            Size = UDim2.new(1, -20, 0, 26), Position = UDim2.new(0, 10, 0, 130),
            Font = Enum.Font.GothamBold, Text = "Exotica Macros", TextSize = 20,
        })
        newLabel(card, {
            Size = UDim2.new(1, -20, 0, 18), Position = UDim2.new(0, 10, 0, 156),
            Font = Enum.Font.GothamMedium, Text = "Welcome, " .. p.DisplayName, TextSize = 13, TextColor3 = COLORS.subtext,
        })
        local ver = newLabel(card, {
            Size = UDim2.new(0, 110, 0, 18), Position = UDim2.new(0.5, -55, 0, 178),
            Font = Enum.Font.GothamBold, Text = "v" .. SCRIPT_VERSION .. " " .. string.upper(SCRIPT_STAGE), TextSize = 11,
            TextColor3 = UI2.stage.color, BackgroundTransparency = 0.86, BackgroundColor3 = Color3.new(1, 1, 1),
        })
        corner(ver, 9)
        edgeGradient(stroke(ver, Color3.new(1, 1, 1), 0.5, 1))
        local track = Instance.new("Frame")
        track.Size = UDim2.new(1, -60, 0, 6)
        track.Position = UDim2.new(0, 30, 0, 210)
        track.BackgroundColor3 = COLORS.white
        track.BackgroundTransparency = 0.88
        track.BorderSizePixel = 0
        track.Parent = card
        corner(track, 3)
        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(0, 0, 1, 0)
        fill.BackgroundColor3 = Color3.new(1, 1, 1)
        fill.BorderSizePixel = 0
        fill.Parent = track
        corner(fill, 3)
        local fillGrad = Instance.new("UIGradient")
        fillGrad.Color = ColorSequence.new(Color3.fromRGB(190, 202, 232), Color3.new(1, 1, 1))
        fillGrad.Parent = fill
        local status = newLabel(card, {
            Size = UDim2.new(1, -20, 0, 16), Position = UDim2.new(0, 10, 0, 222),
            Font = Enum.Font.GothamMedium, Text = "Starting up", TextSize = 11, TextColor3 = COLORS.muted,
        })

        local function finish() -- always runs exactly once, so the menu can never get stuck behind the loader
            if finished then return end
            finished = true
            pcall(function() overlay:Destroy() end)
            done()
        end
        task.delay(6, finish) -- safety net

        -- go
        playStartupChime()
        tween(overlay, { BackgroundTransparency = 0.35 }, 0.4)
        ctrl.show()
        local spin = RunService.RenderStepped:Connect(function(dt) grad.Rotation = (grad.Rotation + dt * 200) % 360 end)
        tween(fill, { Size = UDim2.new(1, 0, 1, 0) }, 2.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
        local steps = {
            { 0.5, "Loading sounds" }, { 1.1, "Reading your inventory" },
            { 1.7, "Getting your slots ready" }, { 2.3, "Almost there" },
        }
        for _, st in ipairs(steps) do
            task.delay(st[1], function() if status.Parent then status.Text = st[2] end end)
        end
        task.delay(2.7, function()
            if status.Parent then
                status.Text = "Ready"
                fill.BackgroundColor3 = COLORS.green
            end
            playEmbedded("loaded", 0.8, 1, 1.4)
        end)
        task.delay(3.3, function()
            pcall(function()
                spin:Disconnect()
                ctrl.hide()
                tween(overlay, { BackgroundTransparency = 1 }, 0.4)
            end)
            task.delay(0.45, finish)
        end)
    end


    ------------------------------------------------------------
    -- Welcome card: on the first 3 launches it asks whether you want the guided tutorial or the How To Use page.
    -- The tutorial walks through the tabs one by one (switching the menu to each) and says what everything does.
    -- "Don't show again" or finishing the tutorial stops the prompts; Tools > Tutorial replays it any time.
    ------------------------------------------------------------
    UI2.welcome = (function()
        local WW = 320
        local H_CHOICE, H_TOUR = 332, 276
        local FILE = "ExoticaMacros_welcome.txt"
        local MAX_RUNS = 3
        local STEPS = {
            { "🎮", "Macros tab", "Macros", "Each key runs a whole combo for you. Tap a key box, then press the key you want to rebind it. Custom Macros builds your own combos, and Screen Buttons adds on-screen buttons for touch." },
            { "🎯", "Aim tab", "Aim", "Turn on Assist to help your shots land. Aim Mode and the sliders tune how it leads a moving target, Target picks who it aims at, and Custom aim point lets you place your own crosshair and pick its style." },
            { "🧲", "Setup tab", "Setup", "Auto Slot Fix sorts your hotbar by itself whenever you open your backpack. Auto Equip puts your gear back on after you respawn (Equip gear picks which pieces), and Hotbar Guard spaces out the script's equips so the game's spam check stays quiet." },
            { "🧰", "Tools tab", "Tools", "Slots shows what each hotbar key should hold, Weapon Tiers is the order the script prefers, How To Use is the full guide, Tutorial replays this tour, and Need help? has the Discord." },
            { "🎒", "You're set", nil, "Open your backpack and Auto Slot Fix takes over: it sorts the hotbar, equips your gear and moves out what doesn't belong. You can replay this tour any time from Tools, then Tutorial." },
        }
        local M = { tok = 0, step = 1, mode = "choice" }

        -- how many times the script has been launched, and whether the prompts were switched off
        local function readData()
            local d
            pcall(function()
                if isfile and isfile(FILE) then d = HttpService:JSONDecode(readfile(FILE)) end
            end)
            local mem = AutoFixMemory.welcome
            if type(d) ~= "table" then d = {} end
            if type(d.runs) ~= "number" then d.runs = (type(mem) == "table" and mem.runs) or 0 end
            d.done = (d.done == true) or (type(mem) == "table" and mem.done == true) or false
            return d
        end
        local function writeData(d)
            AutoFixMemory.welcome = d
            pcall(function() if writefile then writefile(FILE, HttpService:JSONEncode(d)) end end)
        end

        local card = makeGlass(sg, 28)
        card.Name = "WelcomeCard"
        card.AnchorPoint = Vector2.new(0.5, 0.5)
        card.Size = UDim2.new(0, WW, 0, H_CHOICE)
        card.Position = UDim2.new(0.5, 0, 0.5, 0)
        card.Active = true
        local cScale = Instance.new("UIScale")
        cScale.Parent = card

        local header = Instance.new("TextButton")
        header.Size = UDim2.new(1, 0, 0, 48)
        header.BackgroundTransparency = 1
        header.Text = ""
        header.AutoButtonColor = false
        header.Parent = card
        makeDraggable(header, card)
        local titleLbl = newLabel(card, {
            Size = UDim2.new(1, -110, 0, 24), Position = UDim2.new(0, 45, 0, 13),
            Font = Enum.Font.GothamBold, Text = "Welcome", TextSize = 16,
        })
        local closeBtn = Instance.new("TextButton")
        closeBtn.Size = UDim2.new(0, 14, 0, 14)
        closeBtn.Position = UDim2.new(0, 18, 0, 18)
        closeBtn.BackgroundColor3 = COLORS.red
        closeBtn.BorderSizePixel = 0
        closeBtn.Text = ""
        closeBtn.AutoButtonColor = false
        closeBtn.Parent = card
        corner(closeBtn, 7)
        local counter = newLabel(card, {
            Size = UDim2.new(0, 56, 0, 16), Position = UDim2.new(1, -70, 0, 17),
            Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = COLORS.muted, Text = "",
            TextXAlignment = Enum.TextXAlignment.Right,
        })

        local function pill(parent, text, x, y, w, h, anchorX, bold)
            local b = Instance.new("TextButton")
            b.AnchorPoint = Vector2.new(anchorX or 0, 0)
            b.Position = UDim2.new(anchorX == 1 and 1 or 0, x, 0, y)
            b.Size = UDim2.new(0, w, 0, h)
            b.BackgroundColor3 = Color3.new(1, 1, 1)
            b.BackgroundTransparency = 0.86
            b.BorderSizePixel = 0
            b.AutoButtonColor = false
            b.Font = bold and Enum.Font.GothamBold or Enum.Font.GothamMedium
            b.TextSize = 12
            b.TextColor3 = bold and COLORS.pure or COLORS.muted
            b.Text = text
            b.Parent = parent
            corner(b, h / 2)
            edgeGradient(stroke(b, Color3.new(1, 1, 1), 0.45, 1))
            return b
        end
        local function chipFor(parent, d, cx, cy, textSize)
            local chip = Instance.new("Frame")
            chip.AnchorPoint = Vector2.new(0.5, 0.5)
            chip.Position = UDim2.new(0, cx, 0, cy)
            chip.Size = UDim2.fromOffset(d, d)
            chip.BackgroundColor3 = Color3.new(1, 1, 1)
            chip.BackgroundTransparency = 0.84
            chip.BorderSizePixel = 0
            chip.Parent = parent
            corner(chip, d / 2)
            edgeGradient(stroke(chip, Color3.new(1, 1, 1), 0.4, 1))
            local icon = newLabel(chip, { Size = UDim2.new(1, 0, 1, 0), Text = "", TextSize = textSize })
            return chip, icon
        end
        local bodyColor = BRIGHT and Color3.fromRGB(40, 48, 78) or Color3.fromRGB(235, 235, 245)

        ---------------- view 1: the question
        local choice = Instance.new("Frame")
        choice.Size = UDim2.new(1, 0, 1, 0)
        choice.BackgroundTransparency = 1
        choice.BorderSizePixel = 0
        choice.Parent = card
        newLabel(choice, {
            Size = UDim2.new(1, -36, 0, 40), Position = UDim2.new(0, 18, 0, 54),
            Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = bodyColor, TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
            Text = "Want a quick tour? Pick how you'd like to learn what everything does.",
        })
        local function bigChoice(y, emoji, title, sub)
            local b = Instance.new("TextButton")
            b.Position = UDim2.new(0, 14, 0, y)
            b.Size = UDim2.new(1, -28, 0, 64)
            b.BackgroundColor3 = Color3.new(1, 1, 1)
            b.BackgroundTransparency = 0.88
            b.BorderSizePixel = 0
            b.AutoButtonColor = false
            b.Text = ""
            b.Parent = choice
            corner(b, 18)
            edgeGradient(stroke(b, Color3.new(1, 1, 1), 0.4, 1))
            local _, ic = chipFor(b, 38, 33, 32, 20)
            ic.Text = emoji
            newLabel(b, {
                Size = UDim2.new(1, -86, 0, 20), Position = UDim2.new(0, 62, 0, 11), Font = Enum.Font.GothamBold,
                TextSize = 14, Text = title, TextXAlignment = Enum.TextXAlignment.Left,
            })
            newLabel(b, {
                Size = UDim2.new(1, -86, 0, 16), Position = UDim2.new(0, 62, 0, 33), Font = Enum.Font.GothamMedium,
                TextSize = 11, TextColor3 = COLORS.muted, Text = sub, TextXAlignment = Enum.TextXAlignment.Left,
            })
            return b
        end
        local tourPick = bigChoice(104, "🧭", "Guided tutorial", "A one-minute tour, tab by tab")
        local guidePick = bigChoice(178, "📘", "How To Use page", "Read it at your own pace")
        newLabel(choice, {
            Size = UDim2.new(1, -36, 0, 14), Position = UDim2.new(0, 18, 0, 252),
            Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = COLORS.muted,
            Text = "Shown on your first " .. MAX_RUNS .. " launches.",
        })
        local skipBtn = pill(choice, "Skip for now", 14, 280, 118, 30, 0, false)
        local neverBtn = pill(choice, "Don't show again", -14, 280, 138, 30, 1, false)

        ---------------- view 2: the tour
        local tour = Instance.new("Frame")
        tour.Size = UDim2.new(1, 0, 1, 0)
        tour.BackgroundTransparency = 1
        tour.BorderSizePixel = 0
        tour.Visible = false
        tour.Parent = card
        local chipFrame, chipIcon = chipFor(tour, 46, 44, 82, 24)
        local chipScale = Instance.new("UIScale")
        chipScale.Parent = chipFrame
        local stepTitle = newLabel(tour, {
            Size = UDim2.new(1, -96, 0, 22), Position = UDim2.new(0, 76, 0, 62),
            Font = Enum.Font.GothamBold, TextSize = 15, Text = "", TextXAlignment = Enum.TextXAlignment.Left,
        })
        local stepSub = newLabel(tour, {
            Size = UDim2.new(1, -96, 0, 16), Position = UDim2.new(0, 76, 0, 85),
            Font = Enum.Font.GothamMedium, TextSize = 11, TextColor3 = COLORS.muted, Text = "",
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        local stepBody = newLabel(tour, {
            Size = UDim2.new(1, -36, 0, 100), Position = UDim2.new(0, 18, 0, 118),
            Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = bodyColor, TextWrapped = true, Text = "",
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
        })
        -- footer (stays put while the step text slides): Back, the dots, Next
        local backBtn = pill(card, "Back", 14, 0, 76, 30, 0, true)
        backBtn.Position = UDim2.new(0, 14, 1, -43)
        local nextBtn = pill(card, "Next", -14, 0, 76, 30, 1, true)
        nextBtn.Position = UDim2.new(1, -14, 1, -43)
        local dotsHolder = Instance.new("Frame")
        dotsHolder.AnchorPoint = Vector2.new(0.5, 0.5)
        dotsHolder.Position = UDim2.new(0.5, 0, 1, -28)
        dotsHolder.Size = UDim2.new(0, 110, 0, 8)
        dotsHolder.BackgroundTransparency = 1
        dotsHolder.BorderSizePixel = 0
        dotsHolder.Parent = card
        local dl = Instance.new("UIListLayout")
        dl.FillDirection = Enum.FillDirection.Horizontal
        dl.HorizontalAlignment = Enum.HorizontalAlignment.Center
        dl.VerticalAlignment = Enum.VerticalAlignment.Center
        dl.Padding = UDim.new(0, 6)
        dl.Parent = dotsHolder
        local dots = {}
        for i = 1, #STEPS do
            local d = Instance.new("Frame")
            d.Size = UDim2.new(0, 6, 0, 6)
            d.BackgroundColor3 = COLORS.muted
            d.BorderSizePixel = 0
            d.LayoutOrder = i
            d.Parent = dotsHolder
            corner(d, 3)
            dots[i] = d
        end
        backBtn.Visible, nextBtn.Visible, dotsHolder.Visible = false, false, false

        UI2.prep(choice)
        UI2.prep(tour)
        local fader = makeFader(card)
        local ctrl = makePanelController(card, cScale, fader)
        M.ctrl, M.card = ctrl, card

        local function setMode(m, instant)
            M.mode = m
            local isTour = (m == "tour")
            choice.Visible = not isTour
            tour.Visible = isTour
            backBtn.Visible, nextBtn.Visible, dotsHolder.Visible = isTour, isTour, isTour
            counter.Text = ""
            titleLbl.Text = isTour and "Tutorial" or "Welcome"
            local h = isTour and H_TOUR or H_CHOICE
            local pos = isTour and UDim2.new(0.5, 0, 1, -(h // 2) - 24) or UDim2.new(0.5, 0, 0.5, 0)
            if instant then
                card.Size, card.Position = UDim2.new(0, WW, 0, h), pos
            else
                tween(card, { Size = UDim2.new(0, WW, 0, h), Position = pos }, 0.5, Enum.EasingStyle.Quint)
            end
        end

        local function goStep(i, dir)
            M.step = i
            M.tok += 1
            local st = STEPS[i]
            chipIcon.Text = st[1]
            stepTitle.Text = st[2]
            stepSub.Text = "Step " .. i .. " of " .. #STEPS
            stepBody.Text = st[4]
            counter.Text = i .. " / " .. #STEPS
            if st[3] and UI2.selectTab then pcall(UI2.selectTab, st[3]) end
            chipScale.Scale = 0.5
            tween(chipScale, { Scale = 1 }, 0.6, Enum.EasingStyle.Back)
            for j, d in ipairs(dots) do
                local on = (j == i)
                tween(d, { Size = UDim2.new(0, on and 18 or 6, 0, 6), BackgroundColor3 = on and COLORS.white or COLORS.muted }, 0.35, Enum.EasingStyle.Back)
            end
            backBtn.Visible = i > 1
            nextBtn.Text = (i == #STEPS) and "Done" or "Next"
            pcall(UI2.cascade, tour, { dx = (dir or 1) * 26, step = 0.07, delay = 0.02 })
        end

        local function startTour()
            if not mainCtrl.open then mainCtrl.show() end
            setMode("tour")
            if not ctrl.open then ctrl.show() end
            goStep(1, 1)
        end
        M.open = function(mode)
            if mode == "tour" then startTour() return end
            setMode("choice", true)
            ctrl.show()
            pcall(UI2.cascade, choice, { step = 0.07, delay = 0.12 })
        end
        -- counts this launch; true while the prompt is still due (first MAX_RUNS launches, unless switched off)
        M.due = function()
            local ok, due = pcall(function()
                local d = readData()
                d.runs += 1
                writeData(d)
                return (not d.done) and d.runs <= MAX_RUNS
            end)
            return ok and due == true
        end
        local function stopAsking()
            local d = readData()
            d.done = true
            writeData(d)
        end

        tourPick.Activated:Connect(function()
            playEmbedded("cycle", 0.5, 1.122, 1)
            startTour()
        end)
        guidePick.Activated:Connect(function()
            ctrl.hide()
            task.delay(0.3, function() UI2.openGuide() end)
        end)
        skipBtn.Activated:Connect(function() ctrl.hide() end)
        neverBtn.Activated:Connect(function()
            stopAsking()
            ctrl.hide()
            if showNotification then
                pcall(showNotification, {
                    title = "Got it", badge = "i", color = UI2.stage.color, width = 300,
                    items = { "The welcome prompt will not show again." },
                    hint = "Tools > Tutorial replays the tour any time", duration = 4, sounds = {},
                })
            end
        end)
        backBtn.Activated:Connect(function()
            if M.step > 1 then playEmbedded("cycle", 0.5, 0.891, 1) goStep(M.step - 1, -1) end
        end)
        nextBtn.Activated:Connect(function()
            if M.step < #STEPS then
                playEmbedded("cycle", 0.5, 1.122, 1)
                goStep(M.step + 1, 1)
            else
                stopAsking() -- finished: no more prompts
                ctrl.hide()
