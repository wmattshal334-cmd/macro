    ------------------------------------------------------------
    -- Loading screen: your avatar and name, then the EXOTICA wordmark. Everything on it follows ONE clock, the playback position of the
    -- startup track (a soft pad that opens, then a tech ident that swells underneath it), so the picture moves with the music: the
    -- avatar ring lights up on the pad's notes, the glow, the sparkles and the progress bar follow the loudness, and when the swell
    -- arrives the wordmark ignites. Tap anywhere to skip. If anything in here fails, the menu simply opens straight away.
    ------------------------------------------------------------
    UI2.runLoader = function(done)
        -- cue sheet of the startup track, measured from the audio itself: when the swell arrives (reveal), when it starts to settle,
        -- when the screen leaves, and how loud the track is 20 times a second (0-9) overall, in the lows and in the sparkle
        local CUE = { reveal = 2.9, settle = 4.3, out = 4.85, outLen = 0.5, length = 7.9 }
        local NOTES = { 0.145, 0.449, 0.758, 1.042 } -- the pad's first four notes
        local ENV = {
            all = "00176665476467677765557666566567687677787778789877877787788888889987988898899889889988988898799879878887887686688767677766766565676655565544544233332201000000",
            lo = "00110011122112120122332333333455655455576657678866876687688868779886987697699868879987988798699869878886887686688757667765766565576655555543544233232201000000",
            hi = "00000000001001111443354333333333344434434444444445556777788999999999999999999999999889988888877677666666555555545555454444444343333334233232221110000000000000",
        }

        local function clamp01(x) if x < 0 then return 0 elseif x > 1 then return 1 end return x end
        local function smooth(x) x = clamp01(x) return x * x * (3 - 2 * x) end
        local function outBack(x) x = clamp01(x) local c = x - 1 return 1 + 2.70158 * c * c * c + 1.70158 * c * c end
        local function outCubic(x) x = clamp01(x) local c = 1 - x return 1 - c * c * c end
        local function envAt(key, t) -- loudness 0..1 of the track at time t
            local s, x = ENV[key], t * 20
            local i = math.floor(x)
            if i < 0 then return 0 end
            local a, b = string.byte(s, i + 1) or 48, string.byte(s, i + 2) or 48
            return ((a - 48) + (b - a) * (x - i)) / 9
        end

        local PAL = { -- cyan, azure, violet, pink: the colours the whole screen is made of
            Color3.fromRGB(70, 222, 255), Color3.fromRGB(92, 140, 255), Color3.fromRGB(160, 100, 255), Color3.fromRGB(255, 96, 214),
        }
        local WHITE = Color3.new(1, 1, 1)
        local GHOST = Color3.fromRGB(120, 140, 190)
        local function pal(u) -- u loops 0..1 through the four colours and back to the first
            u = (u % 1) * #PAL
            local i = math.floor(u)
            return PAL[i % #PAL + 1]:Lerp(PAL[(i + 1) % #PAL + 1], u - i)
        end
        local function mk(class, props, parent)
            local o = Instance.new(class)
            for k, v in pairs(props) do o[k] = v end
            o.Parent = parent
            return o
        end
        local C5 = Vector2.new(0.5, 0.5)
        local function at(x, y) return UDim2.new(0.5, x, 0.5, y) end
        local function px(w, h) return UDim2.fromOffset(w, h or w) end
        local function round(o) return mk("UICorner", { CornerRadius = UDim.new(0.5, 0) }, o) end

        local finished, doneCalled, skipped, frameErrors = false, false, false, 0
        local conns = {}
        local created = os.clock()

        -- screen cover (reaches up over the top bar) with a soft blur of the game behind it
        local topInset = 0
        pcall(function() topInset = game:GetService("GuiService"):GetGuiInset().Y end)
        if sg.IgnoreGuiInset then topInset = 0 end
        local blur
        pcall(function()
            local L = game:GetService("Lighting")
            for _, o in ipairs(L:GetChildren()) do if o.Name == "ExoticaLoaderBlur" then o:Destroy() end end
            blur = Instance.new("BlurEffect")
            blur.Name = "ExoticaLoaderBlur"
            blur.Size = 0
            blur.Parent = L
        end)
        local overlay = mk("Frame", {
            Name = "Loader", Position = UDim2.fromOffset(0, -topInset), Size = UDim2.new(1, 0, 1, topInset),
            BackgroundColor3 = Color3.fromRGB(4, 6, 14), BackgroundTransparency = 1, BorderSizePixel = 0,
            ZIndex = 200, Active = true, ClipsDescendants = true,
        }, sg)
        local function fit()
            local vp = Vector2.new(1066, 600)
            pcall(function() vp = workspace.CurrentCamera.ViewportSize end)
            return math.clamp(math.min(vp.X / 520, vp.Y / 400), 0.5, 1.25)
        end
        local fitScale = fit()
        local stage = mk("Frame", {
            Name = "Stage", AnchorPoint = C5, Position = UDim2.new(0.5, 0, 0.5, 0), Size = px(460, 360),
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 4,
        }, overlay)
        local stageScale = mk("UIScale", { Scale = fitScale }, stage)

        -- where things sit (design units, from the middle of the stage)
        local AV_Y, HELLO_Y, NAME_Y, USER_Y, WM_Y, SUB_Y, BAR_Y, STAT_Y = -112, -36, -14, 10, 62, 108, 138, 156

        -- soft light: sixteen stacked circles, each a little smaller than the last, so the centre is the brightest
        local function glow(w, h, color, y)
            local layers = {}
            for i = 1, 16 do
                local k = 1 - (i - 1) * 0.055
                layers[i] = mk("Frame", {
                    AnchorPoint = C5, Position = at(0, y), Size = px(w * k, h * k), BackgroundColor3 = color,
                    BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1,
                }, stage)
                round(layers[i])
            end
            return layers
        end
        local function setGlow(layers, strength) -- strength = opacity at the centre
            local a = 1 - (1 - clamp01(strength)) ^ (1 / 16)
            for _, f in ipairs(layers) do f.BackgroundTransparency = 1 - a end
        end
        local glowAv = glow(320, 320, PAL[2], AV_Y)
        local glowAv2 = glow(210, 210, PAL[1], AV_Y)
        local glowWm = glow(520, 130, PAL[3], WM_Y)
        local glowWm2 = glow(320, 80, PAL[4], WM_Y)

        -- avatar: photo in a circle, a colour ring that turns, and a halo that breathes with the lows
        local avWrap = mk("Frame", { AnchorPoint = C5, Position = at(0, AV_Y), Size = px(112), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, stage)
        local avScale = mk("UIScale", { Scale = 0.6 }, avWrap)
        local halo = mk("Frame", { AnchorPoint = C5, Position = UDim2.new(0.5, 0, 0.5, 0), Size = px(104), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 1 }, avWrap)
        round(halo)
