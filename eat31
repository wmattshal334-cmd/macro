    -- First-trigger slot warning: an iOS-style notification banner that drops in once,
    -- the first time any macro fires. Tap it to open Slot Setup; otherwise it slides
    -- away on its own after 5 seconds.
    ------------------------------------------------------------

    local activeToast = nil -- dismiss function of the banner that's currently on screen

    -- Glass notification banner. opts: title, body, hint, bodyHeight, color, duration, onTap,
    -- and optionally width, badge (the symbol in the circle) and sounds (list of embedded sound keys)
    showNotification = function(opts)
        if activeToast then activeToast() end -- only one banner at a time

        local screenSz = sg.AbsoluteSize
        local toastW = math.min(opts.width or 308, math.max(220, screenSz.X - 24)) -- never wider than the screen
        local bodyH = opts.bodyHeight or 30
        -- optional bullet list: each item is measured exactly, and a long list is cut short ("+2 more") so the
        -- banner never grows taller than a third of the screen
        local shown, itemHeights, moreAt
        if opts.items then
            local TextService = game:GetService("TextService")
            local textW = toastW - 94
            local cap = math.min(opts.maxBody or 118, math.max(60, math.floor(screenSz.Y * 0.3)))
            shown, itemHeights = {}, {}
            bodyH = 0
            for _, t in ipairs(opts.items) do
                local sz = TextService:GetTextSize(t, 11, Enum.Font.Gotham, Vector2.new(textW, 10000))
                local h = math.ceil(sz.Y) + 1
                local nextH = bodyH + (#shown > 0 and 7 or 0) + h
                if nextH > cap and #shown > 0 then break end
                shown[#shown + 1] = t
                itemHeights[#shown] = h
                bodyH = nextH
            end
            if #shown < #opts.items then
                local left = #opts.items - #shown
                shown[#shown + 1] = "+" .. left .. " more"
                itemHeights[#shown] = 14
                moreAt = #shown
                bodyH = bodyH + 7 + 14
            end
        end
        local textH = bodyH
        if opts.code then bodyH = bodyH + 34 end -- room for the code chip under the text
        local toastH = 94 + (bodyH - 30)
        local color = opts.color or COLORS.warn
        local duration = opts.duration or 5

        local toast = makeGlass(sg, 24)
        toast.Name = "Notification"
        toast.AnchorPoint = Vector2.new(0.5, 0)
        toast.Size = UDim2.new(0, toastW, 0, toastH)
        toast.Position = UDim2.new(0.5, 0, 0, -(toastH + 30))
        local tScale = Instance.new("UIScale")
        tScale.Scale = 0.9
        tScale.Parent = toast

        local hit = Instance.new("TextButton") -- whole banner is tappable
        hit.Size = UDim2.new(1, 0, 1, 0)
        hit.BackgroundTransparency = 1
        hit.Text = ""
        hit.AutoButtonColor = false
        hit.Parent = toast

        -- the badge is a little glass disc; only its symbol carries the colour
        local badge = newLabel(toast, {
            Size = UDim2.new(0, 36, 0, 36),
            Position = UDim2.new(0, 16, 0, 16),
            BackgroundTransparency = 0.84,
            BackgroundColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.GothamBold,
            Text = opts.badge or "!",
            TextSize = opts.badgeSize or 20,
            TextColor3 = color,
        })
        corner(badge, 18)
        edgeGradient(stroke(badge, Color3.new(1, 1, 1), 0.4, 1))

        newLabel(toast, {
            Size = UDim2.new(1, -80, 0, 18),
            Position = UDim2.new(0, 64, 0, 13),
            Font = Enum.Font.GothamBold,
            Text = opts.title,
            TextSize = 14,
            TextColor3 = COLORS.white,
            TextXAlignment = Enum.TextXAlignment.Left,
        })
        if shown then
            local y = 32
            for i, t in ipairs(shown) do
                if i ~= moreAt then
                    local dot = Instance.new("Frame")
                    dot.Size = UDim2.new(0, 5, 0, 5)
                    dot.Position = UDim2.new(0, 64, 0, y + 4)
                    dot.BackgroundColor3 = color
                    dot.BorderSizePixel = 0
                    dot.Parent = toast
                    corner(dot, 3)
                end
                newLabel(toast, {
                    Size = UDim2.new(1, -94, 0, itemHeights[i]),
                    Position = UDim2.new(0, 78, 0, y),
                    Text = t,
                    TextSize = 11,
                    TextColor3 = (i == moreAt) and COLORS.muted or COLORS.white,
                    TextWrapped = true,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                })
                y = y + itemHeights[i] + 7
            end
        else
            newLabel(toast, {
                Size = UDim2.new(1, -80, 0, textH),
                Position = UDim2.new(0, 64, 0, 32),
                Text = opts.body,
                TextSize = 11,
                TextColor3 = COLORS.white,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
            })
        end
        if opts.code then -- e.g. a bug code: a glass chip you can read at a glance
            local chip = newLabel(toast, {
                Size = UDim2.new(1, -80, 0, 26),
                Position = UDim2.new(0, 64, 0, 32 + textH + 5),
                BackgroundTransparency = 0.84,
                BackgroundColor3 = Color3.new(1, 1, 1),
                Font = Enum.Font.GothamBold,
                Text = opts.code,
                TextSize = 14,
                TextColor3 = COLORS.white,
            })
            corner(chip, 13)
            edgeGradient(stroke(chip, Color3.new(1, 1, 1), 0.4, 1))
        end
        newLabel(toast, {
            Size = UDim2.new(1, -80, 0, 12),
            Position = UDim2.new(0, 64, 0, 32 + bodyH + 2),
            Font = Enum.Font.GothamMedium,
            Text = opts.hint or "Tap to dismiss",
            TextSize = 10,
            TextColor3 = COLORS.muted,
            TextXAlignment = Enum.TextXAlignment.Left,
        })

        -- countdown bar along the bottom edge
        local barTrack = Instance.new("Frame")
        barTrack.Size = UDim2.new(1, -32, 0, 3)
        barTrack.Position = UDim2.new(0, 16, 1, -10)
        barTrack.BackgroundColor3 = COLORS.white
        barTrack.BackgroundTransparency = 0.88
        barTrack.BorderSizePixel = 0
        barTrack.Parent = toast
        corner(barTrack, 2)
        local barFill = Instance.new("Frame")
        barFill.Size = UDim2.new(1, 0, 1, 0)
        barFill.BackgroundColor3 = color
        barFill.BorderSizePixel = 0
        barFill.Parent = barTrack
        corner(barFill, 2)

        -- draw above everything else in the ScreenGui, and the contents above the card
        toast.ZIndex = 50
        for _, d in ipairs(toast:GetDescendants()) do
            if d:IsA("GuiObject") then d.ZIndex = 52 end
        end
        toast:FindFirstChild("Sheen").ZIndex = 51

        local fader = makeFader(toast)
        fader.hideNow()

        if opts.sounds then
            for i, key in ipairs(opts.sounds) do
                playEmbedded(key, i == 1 and 0.7 or 0.55, 1, 1.3)
            end
        else
            playEmbedded("popup", 0.7, 1, 1)
            playEmbedded("warning", 0.6)
        end

        -- slide down + fade in
        tween(toast, { Position = UDim2.new(0.5, 0, 0, 14) }, 0.6, Enum.EasingStyle.Back)
        tween(tScale, { Scale = 1 }, 0.6, Enum.EasingStyle.Back)
        fader.set(true, 0.35)
        tween(barFill, { Size = UDim2.new(0, 0, 1, 0) }, duration, Enum.EasingStyle.Linear)

        local dismissed = false
        local function dismiss(reason) -- reason: "tap", "timeout", or nil when another banner replaced this one
            if dismissed then return end
            dismissed = true
            if activeToast == dismiss then activeToast = nil end
            if opts.onClose then pcall(opts.onClose, reason or "replaced") end
            playEmbedded("slideout", 0.6, 1, 1)
            tween(toast, { Position = UDim2.new(0.5, 0, 0, -(toastH + 30)) }, 0.45, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
            tween(tScale, { Scale = 0.92 }, 0.45)
            fader.set(false, 0.4)
            task.delay(0.5, function() toast:Destroy() end)
        end
        activeToast = dismiss

        hit.Activated:Connect(function()
            playEmbedded("deepclick", 0.7, 1, 1)
            if opts.onTap then opts.onTap() end
            dismiss("tap")
        end)

        task.delay(duration, function() dismiss("timeout") end)
    end
