        local ROW_W = CM.W - 28 - 6
        local function mkBtn(parent, text, x, y, w, h, color, cb)
            local b = Instance.new("TextButton")
            b.Position = UDim2.new(0, x, 0, y)
            b.Size = UDim2.new(0, w, 0, h)
            b.BackgroundColor3 = color
            b.BackgroundTransparency = 0.58
            b.BorderSizePixel = 0
            b.AutoButtonColor = false
            b.Font = Enum.Font.GothamBold
            b.TextSize = 11
            b.TextColor3 = COLORS.pure
            b.Text = text
            b.Parent = parent
            corner(b, h / 2)
            edgeGradient(stroke(b, Color3.new(1, 1, 1), 0.4, 1)) -- tinted glass with a bright rim
            local press = Instance.new("UIScale")
            press.Parent = b
            b.InputBegan:Connect(function(i)
                local t = i.UserInputType
                if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then tween(press, { Scale = 0.94 }, 0.08) end
            end)
            b.InputEnded:Connect(function(i)
                local t = i.UserInputType
                if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
                    tween(press, { Scale = 1 }, 0.16, Enum.EasingStyle.Back)
                end
            end)
            b.Activated:Connect(function()
                playEmbedded("pop", 0.6, 1, 0.5)
                cb()
            end)
            return b
        end
        local function mkLabel(parent, text, x, y, w, h, size, color)
            return newLabel(parent, { Size = UDim2.new(0, w, 0, h), Position = UDim2.new(0, x, 0, y), Text = text, TextSize = size or 11,
                TextColor3 = color or COLORS.white, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top })
        end
        local function mkRow(y, h, accent)
            local f = Instance.new("Frame")
            f.Size = UDim2.new(0, ROW_W, 0, h)
            f.Position = UDim2.new(0, 0, 0, y)
            f.BackgroundColor3 = accent or COLORS.white
            f.BackgroundTransparency = accent and 0.82 or 0.9
            f.BorderSizePixel = 0
            f.Parent = body
            corner(f, 12)
            stroke(f, accent or COLORS.white, accent and 0.78 or 0.88, 1)
            if accent then
                local fade = Instance.new("UIGradient") -- tinted on the left, clear on the right
                fade.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 0.55) })
                fade.Parent = f
                local bar = Instance.new("Frame")
                bar.Size = UDim2.new(0, 3, 1, -16)
                bar.Position = UDim2.new(0, 0, 0, 8)
                bar.BackgroundColor3 = accent
                bar.BorderSizePixel = 0
                bar.Parent = f
                corner(bar, 2)
            end
