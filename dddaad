                end)
                if i == nSteps then dn.BackgroundTransparency = 0.8 end
                mkBtn(row, "×", ROW_W - 32, 7, 26, 26, COLORS.red, function()
                    CM.edit(function() table.remove(d.steps, i) end)
                end)
                y = y + 44
            end
            mkBtn(body, "＋ Add step", 0, y, ROW_W, 36, COLORS.blue, function() CM.go("add") end)
