        local function classify(name)
            local n = nz(name)
            for _, e in ipairs(WEAPONS) do
                local hit
                if e.exact then
                    hit = false
                    for _, k in ipairs(e.exact) do if n == k then hit = true end end
                elseif e.all then
                    hit = true
                    for _, k in ipairs(e.all) do if not n:find(k, 1, true) then hit = false end end
                else
                    hit = hasAny(n, e.any)
                    if hit and e.none and hasAny(n, e.none) then hit = false end
                end
                if hit then return e end
            end
            return nil
        end

        -- a tool's own name can be a skin name ("Purrse of Doom"), so when the name isn't recognised the text the game
        -- stores on the tool (attributes, string values) is tried too, in case it names the base weapon
        local toolClassCache = setmetatable({}, { __mode = "k" })
        local unknownSeen = {}
        WEAPONS.tool = function(t)
            local c = toolClassCache[t]
            if c then return c end
            local e = classify(t.Name)
            if not e then
                pcall(function()
                    for _, v in pairs(t:GetAttributes()) do
                        if type(v) == "string" and not e then e = classify(v) end
                    end
                    for _, ch in ipairs(t:GetChildren()) do
                        if ch:IsA("StringValue") and not e then e = classify(ch.Value) end
                    end
                end)
            end
            if e then toolClassCache[t] = e
            elseif not unknownSeen[t.Name] then
                unknownSeen[t.Name] = true
                local parts = {}
                pcall(function() for k, v in pairs(t:GetAttributes()) do parts[#parts + 1] = tostring(k) .. "=" .. tostring(v) end end)
                warn("[AutoFix] unrecognised tool:", t.Name, #parts > 0 and ("| attributes: " .. table.concat(parts, ", ")) or "")
            end
            return e
        end

        local PLAN = { slotTool = {}, accessory = {}, equip = {}, equipAll = {}, owned = {}, allTools = {}, noHotbar = {}, handsOff = {} }
        local function planWeapons(tools)
            local rpg, taser, fist
            local dps, acc, equips = {}, {}, {}
            local hasKnuckle = false
            local board
            for _, t in ipairs(tools) do
                local e = WEAPONS.tool(t)
                if e then
                    if e.kind == "loveboard" then
                        board = board or t
                    elseif e.kind == "rpg" then
                        if not rpg or e.tier > rpg.e.tier then rpg = { t = t, e = e } end
                    elseif e.kind == "taser" then taser = taser or t
                    elseif e.kind == "fist" then fist = fist or t
                    elseif e.kind == "dps" then dps[#dps + 1] = { t = t, e = e }
                    elseif e.kind == "acc" then acc[#acc + 1] = { t = t, e = e }
                    elseif e.kind == "equip" then
                        equips[#equips + 1] = { t = t, e = e }
                        if e.group == "knuckle" then hasKnuckle = true end
                    end
                end
            end
            local out = { slotTool = {}, accessory = {}, equip = {}, equipAll = {}, owned = {}, allTools = {}, noHotbar = {}, handsOff = {} }
            for _, t in ipairs(tools) do out.allTools[#out.allTools + 1] = t end
            for _, t in ipairs(tools) do
                local en = WEAPONS.tool(t)
                if en and en.kind == "nohotbar" then
                    if en.macroKey and ConfigStore.macroUses and ConfigStore.macroUses(en.macroKey) then
                        out.handsOff[#out.handsOff + 1] = t -- a custom macro uses it: it may stay on the hotbar and is left alone
                    else
                        out.noHotbar[#out.noHotbar + 1] = t
                    end
                end
            end
            for _, t in ipairs(tools) do
                local e0 = WEAPONS.tool(t)
                if e0 and e0.kind ~= "skip" then out.owned[#out.owned + 1] = t end
            end
            for _, q in ipairs(equips) do out.equipAll[#out.equipAll + 1] = q.t end
            if rpg then out.slotTool["5"] = rpg.t end
            if board then out.slotTool["6"] = board end
            if taser then out.slotTool["1"] = taser end

            local pool = {}
            for _, w in ipairs(dps) do
                if not (w.e.noKnuckles and hasKnuckle) then pool[#pool + 1] = w end -- claws never go with knuckles
            end
            table.sort(pool, function(a, b)
                if a.e.tier ~= b.e.tier then return a.e.tier > b.e.tier end
                return a.t.Name < b.t.Name
            end)
            local free = { ["4"] = true, ["0"] = true, ["8"] = not hasKnuckle, ["1"] = (taser == nil) }
            local placed = {}
            for _, w in ipairs(pool) do
                for _, sl in ipairs(w.e.slots) do
                    local k = tostring(sl)
                    if k ~= "1" and free[k] then
                        out.slotTool[k] = w.t
                        free[k] = false
                        placed[w] = true
                        break
                    end
                end
            end
            -- no Taser: the best weapon left over (one that is allowed in more than one slot) takes slot 1
            if free["1"] then
                for _, w in ipairs(pool) do
                    if not placed[w] and #w.e.slots >= 2 then
                        out.slotTool["1"] = w.t
                        out.slot1Fallback = w.t
                        placed[w] = true
                        break
                    end
                end
            end
            -- the Fist uses your knuckles, so with any knuckles it lives in slot 8; without them it's a last resort
            if fist and not out.slotTool["8"] then out.slotTool["8"] = fist end

            table.sort(acc, function(a, b)
                if a.e.tier ~= b.e.tier then return a.e.tier > b.e.tier end
                return a.t.Name < b.t.Name
            end)
            for i = 1, math.min(4, #acc) do out.accessory[i] = acc[i].t end

            local bestOf = {}
            for _, q in ipairs(equips) do
                local cur = bestOf[q.e.group]
                if not cur or q.e.tier > cur.e.tier then bestOf[q.e.group] = q end
            end
            for _, grp in ipairs({ "knuckle", "boots", "cloak", "crown", "gorilla", "mask", "skates" }) do
                if bestOf[grp] then out.equip[#out.equip + 1] = bestOf[grp].t end
            end
            return out
        end

        local function shortToolName(t)
            local e = WEAPONS.tool(t)
            if e and e.kind == "fist" then return "Fist" end
            return t.Name:sub(1, 14)
        end

        local function scanInventory()
            local tools = {}
            local bp = p:FindFirstChildOfClass("Backpack")
            if bp then
                for _, t in ipairs(bp:GetChildren()) do
                    if t:IsA("Tool") then tools[#tools + 1] = t end
                end
            end
            local ch = p.Character
            if ch then -- the tool you're holding lives in your Character, not the Backpack
                for _, t in ipairs(ch:GetChildren()) do
                    if t:IsA("Tool") then tools[#tools + 1] = t end
                end
            end
            local parts = {}
            for _, t in ipairs(tools) do
                parts[#parts + 1] = t.Name .. "(" .. tostring(imageId(t.TextureId) or "no icon") .. ")"
            end
            toolsDesc = table.concat(parts, ", ")
            local byIcon = {}
            for _, t in ipairs(tools) do
                local tid = imageId(t.TextureId)
                if tid then byIcon[tid] = t.Name end
            end
            toolByIcon = byIcon
            -- decide the best weapon for each variable slot from what you own, and aim the checks at it
            local okPlan, plan = pcall(planWeapons, tools)
            if okPlan and plan then
                PLAN = plan
                for _, slot in ipairs({ "1", "4", "5", "8", "0", "2", "3" }) do
                    PLANNED[slot] = true
                    local t = plan.slotTool[slot]
                    if slot == "2" or slot == "3" then
                        local names = {}
                        for _, a in ipairs(plan.accessory) do names[#names + 1] = a.Name end
                        CANDS[slot] = names
                    else
                        CANDS[slot] = t and { t.Name } or {}
                    end
                    for _, g in ipairs(glows) do
                        if g.slot == slot then
                            g.label = slot .. " · " .. (t and shortToolName(t) or ((SHORT[slot]) or "none"))
                        end
                    end
                end
                if plan.slotTool["6"] then -- Loveboard (or one of its skins) is in slot 6, whatever it's called
                    PLANNED["6"] = true
                    CANDS["6"] = { plan.slotTool["6"].Name }
                end
            end
            local result = {}
            for slot, cands in pairs(CANDS) do
                local set, found, images = {}, false, {}
                for _, t in ipairs(tools) do
                    for _, cand in ipairs(cands) do
                        if score(t.Name, cand) >= 0.6 then
                            set[norm(t.Name)] = true
                            local tid = imageId(t.TextureId)
                            if tid then images[tid] = true end
                            if t.ToolTip and t.ToolTip ~= "" then set[norm(t.ToolTip)] = true end
                            found = true
                            break
                        end
                    end
                end
                if not PLANNED[slot] then
                    for k in pairs(globalSet[slot] or {}) do set[k] = true end
                    for k in pairs(globalImg[slot] or {}) do images[k] = true end
                    for k in pairs(guiSet[slot] or {}) do set[k] = true end -- known name; does NOT mean you own it
                    for k in pairs(guiImg[slot] or {}) do images[k] = true end
                end
                result[slot] = { set = set, found = found, images = images }
            end
            expected = result
        end

        -- last-resort keyword check, used only when the inventory scan found no match for a slot
        local function keywordOk(slot, lower)
            local rule = MATCH[slot]
            if not rule or PLANNED[slot] then return false end
            local hit = false
            for _, w in ipairs(rule.any) do
                if lower:find(w, 1, true) then hit = true break end
            end
            if hit and rule.none then
                for _, w in ipairs(rule.none) do
                    if lower:find(w, 1, true) then hit = false break end
                end
            end
            return hit
        end

        -- icons drawn inside a slot. Roblox's hotbar shows a tool's picture INSTEAD of its name when
        -- the tool has one, so name text alone can't identify those tools (the fist, for example).
        local function readSlotImages(g)
            local f = slotFrameFor(g)
            if not f then return nil end
            local ids = {}
            local function take(d)
                if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Visible then
                    local id = imageId(d.Image)
                    if id then ids[id] = true end
                end
            end
            take(f)
            for _, d in ipairs(f:GetDescendants()) do take(d) end
            return ids
        end

        -- does a displayed name fit one of this slot's script items? (covers display names that
        -- differ a little from the tool's internal name)
        local function nameFitsSlot(slot, name)
            for _, cand in ipairs(CANDS[slot] or {}) do
                if score(name, cand) >= 0.6 then return true end
            end
            return false
        end

        -- Other names these weapons are known by (matched as whole words / parts of words).
        -- A slot holds only a handful of possible weapons, so a short list per slot is enough.
        local SYNONYMS = {
            ["8"] = { "fists", "punch", "punching", "hands", "hand", "knuckles", "brass", "boxing", "glove", "unarmed", "combat", "melee", "brawl" },
            ["4"] = { "yinyang", "stopsign", "pinksign" },
            ["0"] = { "umbrella", "slasher", "claws" },
        }

        -- how many letters differ between two strings (small = a typo / spelling variant)
        local function editDistance(a, b)
            local la, lb = #a, #b
            if math.abs(la - lb) > 2 then return 99 end
            local prev = {}
            for j = 0, lb do prev[j] = j end
            for i = 1, la do
                local cur = { [0] = i }
                for j = 1, lb do
                    local cost = (a:byte(i) == b:byte(j)) and 0 or 1
                    cur[j] = math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost)
                end
                prev = cur
            end
            return prev[lb]
        end

        -- is this text a close enough match for one of the slot's weapons?
        local function closeToSlot(slot, str)
            local n = norm(str)
            if #n < 3 or n:match("^%d+$") then return false end
            local nGold = n:find("gold", 1, true) ~= nil
            for _, cand in ipairs(CANDS[slot] or {}) do
                if score(str, cand) >= 0.6 then return true end
                local nc = norm(cand)
                if #nc >= 4 and (nc:find("gold", 1, true) ~= nil) == nGold
                    and editDistance(n, nc) <= math.max(1, math.floor(#nc / 4)) then
                    return true
                end
            end
            if not PLANNED[slot] then
                for _, syn in ipairs(SYNONYMS[slot] or {}) do
                    if n == syn or (#syn >= 5 and n:find(syn, 1, true)) then return true end
                end
            end
            return false
        end

        -- everything a slot's cell exposes that could be a weapon name: its text (even hidden text),
        -- its own name, attributes, and any value objects hung on it
        local function harvestSlotStrings(g)
            local f = slotFrameFor(g)
            if not f then return nil end
            local list, seen = {}, {}
            local function add(s)
                if type(s) ~= "string" then return end
                local n = norm(s)
                if #n >= 3 and not n:match("^%d+$") and not seen[n] then
                    seen[n] = true
                    list[#list + 1] = s
                end
            end
            local function look(o)
                if o:IsA("TextLabel") or o:IsA("TextButton") then add(o.Text) end
                if o:IsA("StringValue") then add(o.Value) end
                if o:IsA("ObjectValue") and o.Value then add(o.Value.Name) end
                for _, v in pairs(o:GetAttributes()) do add(v) end
            end
            add(f.Name)
            look(f)
            local cnt = 0
            for _, d in ipairs(f:GetDescendants()) do
                cnt = cnt + 1
                if cnt > 60 then break end
                look(d)
            end
            return list
        end

        -- statuses: ok = right weapon in the slot, bad = wrong/empty slot,
        --           missing = weapon isn't in your inventory at all, unknown = couldn't read the slot
        local function checkSlot(g)
            local exp = expected[g.slot]
            local name = readSlotName(g)
            local imgs = readSlotImages(g)
            local n = name and norm(name) or ""

            local okByName = n ~= "" and ((exp and exp.set[n]) or nameFitsSlot(g.slot, name) or keywordOk(g.slot, name:lower()))
            -- also try everything else the slot exposes, plus the name of whichever tool owns the slot's picture
            local strs = harvestSlotStrings(g) or {}
            for id in pairs(imgs or {}) do
                local tn = toolByIcon[id]
                if tn then strs[#strs + 1] = tn end
            end
            if not okByName then
                for _, s in ipairs(strs) do
                    if closeToSlot(g.slot, s) then okByName = true break end
                end
            end
            local okByImage = false
            if exp and exp.images and imgs then
                for id in pairs(imgs) do
                    if exp.images[id] then okByImage = true break end
                end
            end

            local status
            if okByName or okByImage then
                status = "ok"
            elseif exp and exp.found then
                status = (name ~= nil or imgs ~= nil) and "bad" or "unknown"
            elseif name ~= nil or imgs ~= nil then
                status = "missing"
            else
                status = exp and "missing" or "unknown"
            end

            -- the Graffiti Spray Can / Water Balloon Gun: whatever slot you keep them in is left alone
            if status ~= "ok" and holdsHandsOff and holdsHandsOff(g.frame) then status = "ok" end

            -- accessory slots 2 and 3: whatever you put there is right; only an EMPTY one is a problem
            if g.slot == "2" or g.slot == "3" then
                local filled = (name ~= nil and name ~= "") or (imgs ~= nil and next(imgs) ~= nil)
                if filled then
                    -- only accessory weapons belong here; anything else, even something unknown, is wrong
                    status = (accessoryForeign and accessoryForeign(g)) and "bad" or "ok"
                end
            end

            -- one console line whenever a slot looks wrong, so a mismatch can be diagnosed
            if (status == "bad" or status == "missing") and g.slot ~= "2" and g.slot ~= "3" then
                local have, want = {}, {}
                for id in pairs(imgs or {}) do have[#have + 1] = id end
                for id in pairs(exp and exp.images or {}) do want[#want + 1] = id end
                local msg = string.format("slot %s shows text=%q icons=[%s] | expected icons=[%s] | your tools: %s",
                    g.slot, tostring(name), table.concat(have, ","), table.concat(want, ","), toolsDesc)
                if msg ~= g.lastDbg then
                    g.lastDbg = msg
                    print("[Exotica]", msg)
                end
            end

            if status ~= g.status then
                g.status = status
                local c = (status == "ok") and OK_COLOR
                    or (status == "bad") and BAD_COLOR
                    or (status == "missing") and COLORS.warn
                    or g.base
                g.edge.Color, g.haloEdge.Color = c, c
                g.box.BackgroundColor3, g.tag.TextColor3 = c, c
                local mark = (status == "ok") and "✅ "
                    or (status == "bad") and "❌ "
                    or (status == "missing") and "⚠ "
                    or ""
                g.tag.Text = mark .. g.label
            end
        end

        ------------------------------------------------------------
        -- Auto Slot Fix: when the backpack is open and a needed weapon is sitting in the wrong place
        -- (in the inventory grid, or in another hotbar slot), drag it into the slot it belongs in.
        -- Safe by design: only runs while the backpack is open, only after you've been still for a moment,
        -- never during a macro, tries each slot at most twice per time you open the backpack, and
        -- only moves weapons the scan has actually found in your inventory.
        ------------------------------------------------------------
        local MAXTRIES = 6 -- one try per way of moving an item (see moveWith)
        local autoFix = { busy = false, tries = {}, openSince = 0, nextTick = 0, nextClosed = 0, cool = 0,
            closedCycles = 0, badStreak = 0, forceUntil = 0, lastPrompt = -1000, silent = false, key = nil, method = AutoFixMemory.method, addInset = AutoFixMemory.addInset, calibrated = false,
            guiInset = setmetatable({}, { __mode = "k" }), calibTried = setmetatable({}, { __mode = "k" }),
            equipDone = {}, equipHow = {}, equipTries = {}, rearmAt = 0, relaxUntil = 0, scrolled = {},
            lastFailSig = "", lastFailAt = 0 }
        local GuiService_ = game:GetService("GuiService")

        -- Does AbsolutePosition leave the top-bar inset out? Measured once with a throw-away GUI, so
        -- the virtual mouse lands on the exact spot instead of ~36px off.
        local insetNeeded
        local function probeInset()
            if insetNeeded ~= nil then return insetNeeded end
            local inset = GuiService_:GetGuiInset()
            if inset.Y <= 0.5 then insetNeeded = false return false end
            local ok, res = pcall(function()
                local t = Instance.new("ScreenGui")
                t.IgnoreGuiInset = false
                t.ResetOnSpawn = false
                t.Parent = core
                local f = Instance.new("Frame")
                f.Size = UDim2.fromOffset(4, 4)
                f.BackgroundTransparency = 1
                f.Parent = t
                RunService.RenderStepped:Wait()
                RunService.RenderStepped:Wait()
                local y = f.AbsolutePosition.Y
                t:Destroy()
                return y < inset.Y * 0.5
            end)
            insetNeeded = ok and res or false
            return insetNeeded
        end

        local function afLog(...) warn("[AutoFix]", ...) end

        -- Does the AbsolutePosition of things on this cell's screen leave out the top bar (so the mouse point is the position
        -- plus the bar's height)? A measurement made on that very screen wins, then the screen's own setting; a value
        -- measured on a different screen is never borrowed (a hotbar and an inventory can sit on different ones).
        local function insetFor(owner)
            local gui = owner and owner:FindFirstAncestorWhichIsA("ScreenGui")
            if gui and autoFix.guiInset[gui] ~= nil then return autoFix.guiInset[gui] end
            if not gui and autoFix.addInset ~= nil then return autoFix.addInset end
            return (not (gui and gui.IgnoreGuiInset) and probeInset()) and true or false
        end

        local function toMouse(absCenter, owner)
            if insetFor(owner) then absCenter = absCenter + GuiService_:GetGuiInset() end
            return absCenter
        end

        -- Listens on a cell (and what's inside it) so we can SEE whether the virtual mouse/finger really
        -- reached it: did the pointer enter it, did a press land on it, did a release land on it.
        local function watchHits(obj)
            local rec = { began = 0, ended = 0, entered = false, conns = {} }
            local function hook(o)
                if not o:IsA("GuiObject") then return end
                rec.conns[#rec.conns + 1] = o.InputBegan:Connect(function(i)
                    local t = i.UserInputType
                    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then rec.began = rec.began + 1 end
                end)
                rec.conns[#rec.conns + 1] = o.InputEnded:Connect(function(i)
                    local t = i.UserInputType
                    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then rec.ended = rec.ended + 1 end
                end)
                rec.conns[#rec.conns + 1] = o.MouseEnter:Connect(function() rec.entered = true end)
            end
            hook(obj)
            local n = 0
            for _, d in ipairs(obj:GetDescendants()) do
                n = n + 1
                if n > 40 then break end
                hook(d)
            end
            function rec.stop() for _, c in ipairs(rec.conns) do c:Disconnect() end end
            return rec
        end

        -- Double-check the top-bar offset on the cell's own screen by hovering it, once per screen. Two probes, each of which can
        -- only land INSIDE the cell under one reading: a point just inside the cell's top edge (inside only if no offset is
        -- needed) and a point just inside its bottom edge, moved down by the bar (inside only if the offset is needed). If the
        -- cell notices exactly one of them, that is the answer; if it notices both or neither, nothing is stored and the
        -- screen's own setting stays in charge. (A probe on the cell's centre can't tell: a tall cell contains both readings.)
        local function calibrateOffset(cell)
            if not (cell and cell.Parent) then return end
            local gui = cell:FindFirstAncestorWhichIsA("ScreenGui")
            if gui then
                if autoFix.guiInset[gui] ~= nil or autoFix.calibTried[gui] then return end
                autoFix.calibTried[gui] = true
            else
                if autoFix.addInset ~= nil or autoFix.calibrated then return end
                autoFix.calibrated = true
            end
            local inset = GuiService_:GetGuiInset()
            local ap, az = cell.AbsolutePosition, cell.AbsoluteSize
            if inset.Y <= 0.5 then
                if gui then autoFix.guiInset[gui] = false end
                return
            end
            if az.X < 16 or az.Y < 16 then return end
            local cam = workspace.CurrentCamera
            local screenSize = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local cx = ap.X + az.X / 2
            local probes = {
                [false] = Vector2.new(cx, ap.Y + 3),                  -- no offset needed: lands inside the top edge
                [true] = Vector2.new(cx, ap.Y + az.Y - 3) + inset,    -- offset needed: lands inside the bottom edge
            }
            local noticed = {}
            SynthDragging = true
            for _, add in ipairs({ false, true }) do
                local pt = probes[add]
                if pt.Y < screenSize.Y - 2 and pt.X > 0 and pt.X < screenSize.X then
                    local rec = watchHits(cell)
                    pcall(function()
                        local startY = (pt.Y + 160 < screenSize.Y) and (pt.Y + 160) or math.max(2, pt.Y - 160)
                        VIM:SendMouseMoveEvent(pt.X + 160, startY, game) -- start well outside, so entering is a real event
                        task.wait(0.1)
                        VIM:SendMouseMoveEvent(pt.X, pt.Y, game)
                        task.wait(0.2)
                    end)
                    noticed[add] = rec.entered
                    rec.stop()
                end
            end
            SynthDragging = false
            local decided
            if noticed[false] and not noticed[true] then decided = false
            elseif noticed[true] and not noticed[false] then decided = true end
            afLog("calibrate: top-bar offset on", gui and gui.Name or "?", "->",
                decided == nil and "undecided (using the screen's own setting)" or (decided and "added" or "not added"))
            if decided ~= nil then
                if gui then autoFix.guiInset[gui] = decided end
                autoFix.addInset = decided
                AutoFixMemory.addInset = decided
            end
        end

        -- The part of a GUI object that is really on screen, in the same coordinates as AbsolutePosition: its own box cut down by
        -- every ancestor that clips it (scrolling lists, ClipsDescendants frames) and by the screen. A cell half-scrolled out of
        -- its list is only clickable where it is still visible, so that is where the click is aimed.
        autoFix.visibleRect = function(o)
            local ap, az = o.AbsolutePosition, o.AbsoluteSize
            local x1, y1, x2, y2 = ap.X, ap.Y, ap.X + az.X, ap.Y + az.Y
            local a = o.Parent
            for _ = 1, 30 do
                if not a or not a:IsA("GuiObject") then break end
                if a:IsA("ScrollingFrame") or a.ClipsDescendants then
                    local pp, ps = a.AbsolutePosition, a.AbsoluteSize
                    if a:IsA("ScrollingFrame") then ps = a.AbsoluteWindowSize end
                    x1, y1 = math.max(x1, pp.X), math.max(y1, pp.Y)
                    x2, y2 = math.min(x2, pp.X + ps.X), math.min(y2, pp.Y + ps.Y)
                end
                a = a.Parent
            end
            local cam = workspace.CurrentCamera
            if cam then
                local vs = cam.ViewportSize
                x1, y1 = math.max(x1, 0), math.max(y1, 0)
                x2, y2 = math.min(x2, vs.X), math.min(y2, vs.Y)
            end
            return x1, y1, x2, y2
        end

        -- A cell that is partly (or fully) scrolled out of its list is scrolled into the middle of the list first.
        autoFix.reveal = function(cell)
            local sf = cell:FindFirstAncestorWhichIsA("ScrollingFrame")
            if not sf then return end
            local ap, az = cell.AbsolutePosition, cell.AbsoluteSize
            local wp, wz = sf.AbsolutePosition, sf.AbsoluteWindowSize
            if ap.Y >= wp.Y + 3 and ap.Y + az.Y <= wp.Y + wz.Y - 3 and ap.X >= wp.X + 3 and ap.X + az.X <= wp.X + wz.X - 3 then return end
            local cp = sf.CanvasPosition
            local maxY = math.max(0, sf.AbsoluteCanvasSize.Y - wz.Y)
            local maxX = math.max(0, sf.AbsoluteCanvasSize.X - wz.X)
            local ny = math.max(0, math.min(maxY, cp.Y + (ap.Y + az.Y / 2) - (wp.Y + wz.Y / 2)))
            local nx = math.max(0, math.min(maxX, cp.X + (ap.X + az.X / 2) - (wp.X + wz.X / 2)))
            if math.abs(ny - cp.Y) < 1 and math.abs(nx - cp.X) < 1 then return end
            if not autoFix.scrollHome then autoFix.scrollHome = { sf = sf, pos = cp } end
            sf.CanvasPosition = Vector2.new(nx, ny)
            task.wait(0.05)
        end

        local function cellCenter(cell)
            return toMouse(cell.AbsolutePosition + cell.AbsoluteSize / 2, cell)
        end

        -- centre of a slot's target position (its own cell, or where the row says it would be)
        local function targetCenter(g)
            local f = g.frame
            if f and f.Parent and f.AbsoluteSize.X > 4 then return cellCenter(f) end
            if rowRef and rowRef.cell.Parent then
                local ref = rowRef.cell
                local abs = Vector2.new(ref.AbsolutePosition.X + (g.pos - rowRef.pos) * rowPitch, ref.AbsolutePosition.Y)
                return toMouse(abs + ref.AbsoluteSize / 2, ref)
            end
            return nil
        end

        -- is this cell holding a weapon that belongs in `slot`? (icon first, then any name it exposes)
        local function isBrassName(n)
            n = tostring(n):lower()
            return n:find("knuckle", 1, true) ~= nil or n:find("brass", 1, true) ~= nil
        end
        local function cellIsItemFor(cell, slot)
            local tmp = { frame = cell, slot = slot }
            local exp = expected[slot]
            local imgs = readSlotImages(tmp)
            -- slot 8 takes the FIST only. Brass Knuckles are never moved into it: they get equipped instead
            -- (the Fist then uses them), see equipBrass below.
            if slot == "8" then
                for id in pairs(imgs or {}) do
                    if toolByIcon[id] and isBrassName(toolByIcon[id]) then return false end
                end
                for _, str in ipairs(harvestSlotStrings(tmp) or {}) do
                    if isBrassName(str) then return false end
                end
            end
            if exp and imgs then
                for id in pairs(imgs) do if exp.images[id] then return true end end
            end
            local strs = harvestSlotStrings(tmp) or {}
            for id in pairs(imgs or {}) do
                local tn = toolByIcon[id]
                if tn then strs[#strs + 1] = tn end
            end
            for _, str in ipairs(strs) do
                if closeToSlot(slot, str) then return true end
            end
            return false
        end

        -- From a list of square-ish candidates (parents listed before their children), keep the real item cells and drop the
        -- frames the cells sit in (the page, the grid, a section). Without this, a grid that happens to be roughly square
        -- counted as ONE huge cell and the click went to the middle of it, between the items.
        -- Cells repeat: a real cell has same-sized siblings elsewhere on screen, a page or grid is one of a kind. So a frame
        -- is treated as a wrapper when it is one of a kind and has something smaller inside it, or when it holds three or
        -- more similar separate cells, or when it holds a wrapper. Everything inside a kept cell (its icon, its badge) is
        -- ignored, so the click always goes to the cell itself.
        local function outerCells(cand)
            local isCand, cparent, kids = {}, {}, {}
            for _, d in ipairs(cand) do isCand[d] = true end
            for _, d in ipairs(cand) do
                local a = d.Parent
                while a and not isCand[a] do a = a.Parent end
                if a then
                    cparent[d] = a
                    kids[a] = kids[a] or {}
                    kids[a][#kids[a] + 1] = d
                end
            end
            local function bucketOf(d)
                local s = d.AbsoluteSize
                return math.floor(s.X / 6 + 0.5), math.floor(s.Y / 6 + 0.5)
            end
            local bucket = {}
            for _, d in ipairs(cand) do
                local kx, ky = bucketOf(d)
                local k = kx * 1000 + ky
                bucket[k] = bucket[k] or {}
                bucket[k][#bucket[k] + 1] = d
            end
            local function related(a, b)
                local x = cparent[a]
                while x do
                    if x == b then return true end
                    x = cparent[x]
                end
                x = cparent[b]
                while x do
                    if x == a then return true end
                    x = cparent[x]
                end
                return false
            end
            local function repeating(d)
                local kx, ky = bucketOf(d)
                for dx = -1, 1 do
                    for dy = -1, 1 do
                        local list = bucket[(kx + dx) * 1000 + (ky + dy)]
                        if list then
                            for _, e in ipairs(list) do
                                if e ~= d and not related(d, e) then return true end
                            end
                        end
                    end
                end
                return false
            end
            local function overlaps(a, b)
                local ap, az, bp, bz = a.AbsolutePosition, a.AbsoluteSize, b.AbsolutePosition, b.AbsoluteSize
                return ap.X < bp.X + bz.X - 1 and bp.X < ap.X + az.X - 1 and ap.Y < bp.Y + bz.Y - 1 and bp.Y < ap.Y + az.Y - 1
            end
            local wrapper = {}
            for n = #cand, 1, -1 do -- children first, so a wrapper inside makes the frame around it a wrapper too
                local c = cand[n]
                local list = kids[c]
                if list then
                    local cw = c.AbsoluteSize.X
                    local isWrap = false
                    for _, k in ipairs(list) do
                        if wrapper[k] then isWrap = true break end
                    end
                    if not isWrap then
                        if not repeating(c) then
                            for _, k in ipairs(list) do
                                if k.AbsoluteSize.X <= cw * 0.8 then isWrap = true break end
                            end
                        else
                            for i = 1, #list do
                                local ref = list[i]
                                local rw = ref.AbsoluteSize.X
                                local same = 1
                                if rw <= cw * 0.8 then
                                    for j = 1, #list do
                                        local o = list[j]
                                        local ow = o.AbsoluteSize.X
                                        if j ~= i and ow <= cw * 0.8 and math.abs(ow - rw) <= 0.15 * math.max(ow, rw)
                                            and not overlaps(ref, o) then
                                            same = same + 1
                                        end
                                    end
                                end
                                if same >= 3 then isWrap = true break end
                            end
                        end
                    end
                    if isWrap then wrapper[c] = true end
                end
            end
            local cells = {}
            for _, d in ipairs(cand) do
                if not wrapper[d] then
                    local inside, a = false, cparent[d]
                    while a do
                        if not wrapper[a] then inside = true break end
                        a = cparent[a]
                    end
                    if not inside then cells[#cells + 1] = d end
                end
            end
            return cells
        end

        -- The "Search" box of the backpack screen (the one thing every backpack screen has), remembered while it is on screen.
        autoFix.findSearch = function()
            local s = autoFix.searchObj
            if s and s.Parent and chainShown(s) then return s end
            autoFix.searchObj = nil
            local pg = p:FindFirstChildOfClass("PlayerGui")
            if not pg then return nil end
            for _, d in ipairs(pg:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextBox") or d:IsA("TextButton")) and not d:IsDescendantOf(sg) then
                    local ph = d:IsA("TextBox") and d.PlaceholderText or ""
                    if (d.Text == "Search" or ph == "Search") and chainShown(d) then
                        autoFix.searchObj = d
                        return d
                    end
                end
            end
            return nil
        end

        -- The box the game treats as "the backpack": the biggest frame around `o` that is not the whole-screen holder and
        -- does not contain the hotbar. Dropping an item anywhere inside it puts the item back in the backpack.
        autoFix.panelAround = function(o)
            local cam = workspace.CurrentCamera
            local vs = cam and cam.ViewportSize or Vector2.new(1920, 1080)
            local hot = rowRef and rowRef.cell and rowRef.cell.Parent or nil
            local best
            local a = o
            for _ = 1, 14 do
                if not a or not a:IsA("GuiObject") then break end
                local sz = a.AbsoluteSize
                if sz.X >= vs.X * 0.97 and sz.Y >= vs.Y * 0.97 then break end
                if hot and (a == hot or hot:IsDescendantOf(a)) then break end
                if sz.X >= 200 and sz.Y >= 120 then best = a end
                a = a.Parent
            end
            return best
        end

        autoFix.findPanel = function()
            local s = autoFix.findSearch()
            return s and autoFix.panelAround(s) or nil
        end

        -- Keep the cells that belong to the same screen as most of them (a stray icon from the HUD in another screen is dropped,
        -- items in different sections of the same screen are all kept).
        autoFix.mainGroup = function(cells)
            local count, best = {}, nil
            for _, c in ipairs(cells) do
                local g = c:FindFirstAncestorWhichIsA("ScreenGui")
                if g then
                    count[g] = (count[g] or 0) + 1
                    if not best or count[g] > count[best] then best = g end
                end
            end
            if not best then return cells end
            local out = {}
            for _, c in ipairs(cells) do
                if c:FindFirstAncestorWhichIsA("ScreenGui") == best then out[#out + 1] = c end
            end
            return out
        end

        -- the item cells of the open inventory screen (outermost square-ish cells that hold a picture or a name)
        local function inventoryCells()
            local containers, seenC = {}, {}
            local function addC(o)
                if o and o.Parent and not seenC[o] and chainShown(o) then
                    seenC[o] = true
                    containers[#containers + 1] = o
                end
            end
            addC(invWatchDefault)
            addC(invWatchGrid)
            local cand, seenCand = {}, {}
            for _, root in ipairs(containers) do
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("GuiObject") and d.Visible and not seenCand[d] and not d:IsDescendantOf(sg)
                        and not (rowRef and rowRef.cell and rowRef.cell.Parent and d:IsDescendantOf(rowRef.cell.Parent)) then
                        local sz = d.AbsoluteSize
                        if sz.X >= 24 and sz.X <= 260 and sz.Y >= 24 and sz.Y <= 260
                            and sz.X / sz.Y >= 0.6 and sz.X / sz.Y <= 1.6 and chainShown(d) then
                            seenCand[d] = true
                            cand[#cand + 1] = d
                        end
                    end
                end
            end
            return outerCells(cand)
        end

        -- a slot needs fixing when its weapon is in your inventory but the slot doesn't show it
        -- (wrong thing in it, OR empty: an empty hotbar slot reads "unknown", so it counts too)
        local function needsFix(g)
            if (g.slot == "2" or g.slot == "3") and not AutoAccessoryEnabled then return false end
            local exp = expected[g.slot]
            return exp ~= nil and exp.found and g.status ~= "ok"
        end

        -- If the inventory screen's frame wasn't recognised, look at every picture-holding cell above the hotbar
        local function looseCells()
            local hotParent = rowRef and rowRef.cell and rowRef.cell.Parent
            local hotTop = (rowRef and rowRef.cell and rowRef.cell.Parent) and rowRef.cell.AbsolutePosition.Y - 8 or math.huge
            local pg = p:FindFirstChildOfClass("PlayerGui")
            -- inside the backpack panel (found by its Search box) when it is known, else anywhere on screen
            local roots = {}
            local panel = autoFix.findPanel()
            if panel then roots[#roots + 1] = panel end
            if pg then roots[#roots + 1] = pg end
            for _, root in ipairs(roots) do
                local cand = {}
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("GuiObject") and d.Visible and not d:IsDescendantOf(sg)
                        and not (hotParent and d:IsDescendantOf(hotParent)) then
                        local sz = d.AbsoluteSize
                        if sz.X >= 24 and sz.X <= 200 and sz.Y >= 24 and sz.Y <= 200
                            and sz.X / sz.Y >= 0.6 and sz.X / sz.Y <= 1.6
                            and d.AbsolutePosition.Y + sz.Y <= hotTop and chainShown(d) then
                            local imgs = readSlotImages({ frame = d, slot = "" })
                            if imgs and next(imgs) then cand[#cand + 1] = d end
                        end
                    end
                end
                local cells = outerCells(cand)
                if root == pg then cells = autoFix.mainGroup(cells) end -- (not needed inside the panel itself)
                if #cells > 0 then return cells end
            end
            return {}
        end

        -- A big backpack scrolls, and items below the fold have no cell on screen. Backup for that: walk the list top to
        -- bottom, ask rank(cell) about every cell (smaller number = better, nil = not wanted), then scroll back to the
        -- best one and return it with the cells now in view. The list goes back to where it was when the run ends.
        autoFix.scrollPick = function(rank)
            local function visible()
                local cs = inventoryCells()
                if #cs == 0 then cs = looseCells() end
                return cs
            end
            local cells = visible()
            local sf = cells[1] and cells[1]:FindFirstAncestorWhichIsA("ScrollingFrame")
            if not sf then return nil end
            local win, canvas = sf.AbsoluteWindowSize.Y, sf.AbsoluteCanvasSize.Y
            local maxY = math.max(0, canvas - win)
            if maxY < 8 then return nil end
            local startPos = sf.CanvasPosition
            if not autoFix.scrollHome then autoFix.scrollHome = { sf = sf, pos = startPos } end
            local best, bestY
            local step = math.max(48, win * 0.7)
            local y = 0
            while true do
                local at = math.min(y, maxY)
                sf.CanvasPosition = Vector2.new(startPos.X, at)
                task.wait(0.07)
                for _, c in ipairs(visible()) do
                    local r = rank(c)
                    if r and (not best or r < best) then best, bestY = r, at end
                end
                if y >= maxY then break end
                y = y + step
            end
            if not best then
                sf.CanvasPosition = startPos
                return nil
            end
            sf.CanvasPosition = Vector2.new(startPos.X, bestY)
            task.wait(0.08)
            local cs = visible()
            for _, c in ipairs(cs) do
                if rank(c) == best then
                    afLog("scrolled the backpack to find an item (offset " .. math.floor(bestY) .. ")")
                    return c, cs
                end
            end
            return nil
        end

        -- Last resort for finding a weapon on the open backpack screen: look for its picture (or its name) on
        -- ANY visible image/label outside the hotbar, no matter how the backpack's frames are arranged.
        local function iconSource(slot)
            local exp = expected[slot]
            local pg = p:FindFirstChildOfClass("PlayerGui")
            if not (exp and pg) then return nil end
            local hotParent = rowRef and rowRef.cell and rowRef.cell.Parent
            for _, d in ipairs(pg:GetDescendants()) do
                if (d:IsA("ImageLabel") or d:IsA("ImageButton")) and d.Visible and not d:IsDescendantOf(sg)
                    and not (hotParent and d:IsDescendantOf(hotParent)) then
                    local id = imageId(d.Image)
                    local sz = d.AbsoluteSize
                    if id and exp.images[id] and sz.X >= 16 and sz.Y >= 16 and chainShown(d) then
                        return d
                    end
                end
            end
            for _, d in ipairs(pg:GetDescendants()) do
                if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and not d:IsDescendantOf(sg)
                    and not (hotParent and d:IsDescendantOf(hotParent)) and #d.Text > 2 and chainShown(d)
                    and closeToSlot(slot, d.Text) then
                    local par = d.Parent
                    if par and par:IsA("GuiObject") and par.AbsoluteSize.X <= 260 then return par end
                    return d
                end
            end
            return nil
        end

        -- does this backpack/hotbar cell show this particular tool?
        local function sameStanley(a, b) -- normalised names: the Stanley Cup, Kitty Stanley and Spiked Kitty Stanley never match each other
            if not (a:find("stanl", 1, true) or b:find("stanl", 1, true)) then return true end
            return (a:find("kitty", 1, true) ~= nil) == (b:find("kitty", 1, true) ~= nil)
                and (a:find("spike", 1, true) ~= nil) == (b:find("spike", 1, true) ~= nil)
        end
        local function cellMatchesTool(cell, tool)
            local tid = imageId(tool.TextureId or "")
            local imgs = readSlotImages({ frame = cell, slot = "" })
            if tid and imgs and imgs[tid] then return true end
            local want = nz(tool.Name)
            for _, str in ipairs(harvestSlotStrings({ frame = cell }) or {}) do
                local n = nz(str)
                if #n >= 3 and sameStanley(n, want) and (n == want or n:find(want, 1, true)) then return true end
            end
            return false
        end

        holdsHandsOff = function(frame)
            if not (frame and frame.Parent) then return false end
            for _, tool in ipairs(PLAN.handsOff or {}) do
                if cellMatchesTool(frame, tool) then return true end
            end
            return false
        end

        -- true when what sits in this accessory slot is NOT an accessory weapon (a Phone, a Spray, the
        -- Loveboard, a high-DPS weapon, or anything the script doesn't recognise at all)
        accessoryForeign = function(g)
            if not (g.frame and g.frame.Parent) then return false end
            if holdsHandsOff(g.frame) then return false end
            for _, tool in ipairs(PLAN.allTools) do
                if cellMatchesTool(g.frame, tool) then
                    local e = WEAPONS.tool(tool)
                    return not (e ~= nil and e.kind == "acc")
                end
            end
            return ConfigStore.evictUnknown == true -- matches none of your tools: unknown, only moved if that switch is on
        end

        -- work out the next fix: returns slot entry, the cell to pick up
        local function planFix()
            local gridCells = autoFix.grid
            for _, g in ipairs(glows) do
                if needsFix(g) and (autoFix.tries[g.slot] or 0) < MAXTRIES then
                    if not gridCells then
                        gridCells = inventoryCells()
                        if #gridCells == 0 then gridCells = looseCells() end
                        autoFix.grid = gridCells -- reused for the rest of this pass (cleared at its start)
                    end
                    if g.slot == "2" or g.slot == "3" then
                        -- accessory slot: your best accessory weapon that isn't already on the hotbar
                        for _, tool in ipairs(PLAN.accessory) do
                            local inAccSlot, wrongBar = false, nil
                            for pos, hc in pairs(hotCellsByPos) do
                                if hc.Parent and cellMatchesTool(hc, tool) then
                                    if pos == 2 or pos == 3 then inAccSlot = true else wrongBar = hc end
                                end
                            end
                            if not inAccSlot then
                                if wrongBar and wrongBar ~= g.frame then return g, wrongBar end -- e.g. a purse in slot 7
                                for _, c in ipairs(gridCells) do
                                    if c ~= g.frame and cellMatchesTool(c, tool) then return g, c end
                                end
                            end
                        end
                        -- not in view: the backpack may be long, so scroll through it once for the best accessory
                        if not autoFix.scrolled[g.slot] then
                            autoFix.scrolled[g.slot] = true
                            local want = {}
                            for _, tool in ipairs(PLAN.accessory) do
                                local inAcc = false
                                for pos, hc in pairs(hotCellsByPos) do
                                    if hc.Parent and (pos == 2 or pos == 3) and cellMatchesTool(hc, tool) then inAcc = true end
                                end
                                if not inAcc then want[#want + 1] = tool end
                            end
                            local okS, c, cs = pcall(autoFix.scrollPick, function(cell)
                                if cell == g.frame then return nil end
                                for i, tool in ipairs(want) do
                                    if cellMatchesTool(cell, tool) then return i end
                                end
                            end)
                            if okS and c then gridCells = cs autoFix.grid = cs return g, c end
                        end
                    else
                        for _, c in ipairs(gridCells) do
                            if c ~= g.frame and cellIsItemFor(c, g.slot) then return g, c end
                        end
                        for pos, c in pairs(hotCellsByPos) do
                            if c ~= g.frame and c.Parent then
                                local owner
                                for _, o in ipairs(glows) do if o.pos == pos then owner = o break end end
                                if not (owner and owner.status == "ok") and cellIsItemFor(c, g.slot) then
                                    return g, c
                                end
                            end
                        end
                        local d = iconSource(g.slot)
                        if d and d ~= g.frame then return g, d end
                        -- still nothing: scroll through a long backpack once
                        if not autoFix.scrolled[g.slot] then
                            autoFix.scrolled[g.slot] = true
                            local okS, c, cs = pcall(autoFix.scrollPick, function(cell)
                                if cell ~= g.frame and cellIsItemFor(cell, g.slot) then return 1 end
                            end)
                            if okS and c then gridCells = cs autoFix.grid = cs return g, c end
                        end
                    end
                end
            end
            return nil
        end

        ------------------------------------------------------------
        -- Wrong item in a slot with nothing better to put there (for example the Brass Knuckles sitting in slot 1,
        -- or a random tool in slot 4): it's moved out of the way, into an empty accessory slot (2 or 3).
        ------------------------------------------------------------
        local EVICT_SLOTS = { ["1"] = true, ["4"] = true, ["5"] = true, ["6"] = true, ["7"] = true, ["8"] = true, ["9"] = true, ["0"] = true }
        local function slotFilled(g)
            local name = readSlotName(g)
            if name and name ~= "" then return true end
            local imgs = readSlotImages(g)
            return imgs ~= nil and next(imgs) ~= nil
        end
        local function slotItemName(g)
            local name = readSlotName(g)
            if name and name ~= "" then return (tostring(name):gsub("^%d+%s*", "")) end
            for id in pairs(readSlotImages(g) or {}) do
                if toolByIcon[id] then return toolByIcon[id] end
            end
            return "an item"
        end
        -- returns the slot entry whose item should be taken out of the hotbar and put back in the backpack:
        --  a wrong item in slots 1/4/5/8/0 with nothing better to put there, or a non-accessory weapon in slot 2/3
        local function planEvict()
            if not AutoFixEnabled then return nil end
            for _, g in ipairs(glows) do
                local isAcc = (g.slot == "2" or g.slot == "3")
                if (EVICT_SLOTS[g.slot] or isAcc) and (autoFix.tries["e" .. g.slot] or 0) < 4 and g.frame and g.frame.Parent then
                    if isAcc then
                        if slotFilled(g) and accessoryForeign and accessoryForeign(g) and not needsFix(g) then return g end
                    elseif slotFilled(g) then
                        local holdsGear = false
                        for _, tool in ipairs(PLAN.equipAll) do
                            if cellMatchesTool(g.frame, tool) then holdsGear = true break end
                        end
                        -- right item (by name or picture) = leave it. Anything else, known or not, goes back.
                        if not holdsGear and not holdsHandsOff(g.frame) and not cellIsItemFor(g.frame, g.slot) then
                            -- only things positively known to belong elsewhere are moved, unless "Evict unknown items" is on:
                            -- then anything that isn't the slot's own weapon goes back. Slots 6, 7 and 9 hold the Loveboard and the
                            -- two launchers; a Loveboard skin ("Cursed Board") or launcher whose name still says board / snowball
                            -- counts as that weapon, anything else in them is moved out.
                            local famSlot = (g.slot == "6" or g.slot == "7" or g.slot == "9")
                            if famSlot and ConfigStore.evictUnknown then
                                local isFam = false
                                for _, tool in ipairs(PLAN.owned) do
                                    if cellMatchesTool(g.frame, tool) then
                                        local fe = WEAPONS.tool(tool)
                                        if fe and (fe.kind == "loveboard" or fe.kind == "fixed") then isFam = true break end
                                    end
                                end
                                if not isFam then return g end
                            end
                            if famSlot or not ConfigStore.evictUnknown then
                                for _, tool in ipairs(PLAN.owned) do
                                    if cellMatchesTool(g.frame, tool) then return g end
                                end
                            else
                                return g
                            end
                        end
                    end
                end
            end
            return nil
        end

        -- true while you've told it to "fix now" (tap the prompt): it then ignores the idle / fight checks
        autoFix.forced = function() return os.clock() < autoFix.forceUntil end
        -- you are holding the mouse button yourself (dragging an item): the fixer must never start or continue then
        autoFix.userHolding = function()
            return (not SynthDragging) and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        end
        -- you (not a macro) have taken over: the fixer then leaves the backpack exactly as it is, open, for you
        autoFix.userTookOver = function()
            return Engine.run == nil and os.clock() - LastCombat > 3
                and (os.clock() - ConfigStore.pressAt < 0.25 or autoFix.userHolding())
        end

        -- would a click at this point really land on this cell? Checked against what is on screen right now. `strict` also
        -- requires that nothing ELSE that takes clicks (a button, an Active frame, another item) sits on top of the cell there:
        -- the first thing that takes the click must be the cell, something inside it, or a container around it.
        autoFix.hits = function(pt, cell, strict)
            local root = cell and cell.Parent and (cell:FindFirstAncestorWhichIsA("PlayerGui") or (cell:IsDescendantOf(core) and core or nil)) or nil
            if not root then return true end -- can't check: allow
            local inset = insetFor(cell) and GuiService_:GetGuiInset() or Vector2.new(0, 0)
            local okq, list = pcall(function() return root:GetGuiObjectsAtPosition(pt.X - inset.X, pt.Y - inset.Y) end)
            if not okq then return true end
            for _, o in ipairs(list) do
                if o == cell or o:IsDescendantOf(cell) then
                    return true
                elseif cell:IsDescendantOf(o) then
                    -- a container around the cell: look further down the list for the cell itself
                elseif strict and (o:IsA("GuiButton") or o:IsA("TextBox") or o.Active) and not o:IsDescendantOf(sg) then
                    return false -- something else takes the click first
                end
            end
            return false
        end

        -- Makes whatever would swallow a click at this point (a button, a text box, an Active frame, one of this script's own
        -- panels) pass the click through for a moment. The cell being clicked, what is inside it and what it sits in are left
        -- alone. Returns what was freed; give it to restoreClickPath when the click is done.
        autoFix.clear = function(pt, keep, owner)
            local okc, freed = pcall(function()
                local f = freeClickPath(pt.X, pt.Y, insetFor(owner) and true or false, function(o)
                    return keep ~= nil and (o == keep or o:IsDescendantOf(keep) or keep:IsDescendantOf(o))
                end)
                return f
            end)
            return okc and freed or {}
        end

        -- Waits until the cell has stopped moving (the backpack slides or fades in, and rows shuffle when something equips),
        -- so the point is read from where it really is. Gives up after maxWait seconds and uses what it has. A cell that was
        -- seen standing still a moment ago is not waited for again.
        autoFix.stillSig = setmetatable({}, { __mode = "k" })
        autoFix.settle = function(cell, maxWait)
            local t0 = os.clock()
            local last, still = nil, 0
            local function sigOf()
                local ap, az = cell.AbsolutePosition, cell.AbsoluteSize
                return math.floor(ap.X * 2) .. "," .. math.floor(ap.Y * 2) .. "," .. math.floor(az.X * 2) .. "," .. math.floor(az.Y * 2)
            end
            if cell and cell.Parent then
                local prev = autoFix.stillSig[cell]
                local s0 = sigOf()
                if prev and prev.sig == s0 and t0 - prev.t < 0.3 then
                    prev.t = t0
                    return true
                end
            end
            while os.clock() - t0 < (maxWait or 0.7) do
                if not (cell and cell.Parent) then return false end
                local sig = sigOf()
                if sig == last then still = still + 1 else still, last = 0, sig end
                if still >= 2 then
                    autoFix.stillSig[cell] = { sig = sig, t = os.clock() }
                    return true
                end
                RunService.Heartbeat:Wait()
            end
            return false
        end

        -- where in the cell to aim: the middle first, and a different spot inside it on every retry (a cell can have a dead
        -- corner or something lying across part of it)
        local AIM_SPOTS = { { 0, 0 }, { 0, -0.22 }, { 0, 0.22 }, { -0.22, 0 }, { 0.22, 0 }, { -0.18, -0.18 }, { 0.18, 0.18 } }

        -- the click point for a cell, verified. `attempt` picks where in the cell to aim. If every spot would miss (screen
        -- shifted, offset wrong), the offset is re-measured once; if it still misses, the move is skipped instead of clicking
        -- somewhere random.
        autoFix.safePoint = function(cell, attempt)
            if not (cell and cell.Parent) then return nil end
            autoFix.reveal(cell) -- half scrolled out of its list: bring it into view first
            autoFix.settle(cell)
            if not cell.Parent then return nil end
            local sz = cell.AbsoluteSize
            if sz.X < 4 or sz.Y < 4 then return nil end
            do
                local vx1, vy1, vx2, vy2 = autoFix.visibleRect(cell)
                if vx2 - vx1 < 6 or vy2 - vy1 < 6 then
                    afLog("aim:", cell.Name, "- it is not on screen (scrolled out of its list or hidden), skipped")
                    return nil
                end
            end
            local cam = workspace.CurrentCamera
            local function inScreen(v)
                return not cam or (v.X >= 0 and v.Y >= 0 and v.X <= cam.ViewportSize.X and v.Y <= cam.ViewportSize.Y)
            end
            local function spot(s)
                local x1, y1, x2, y2 = autoFix.visibleRect(cell)
                local w, h = x2 - x1, y2 - y1
                if w < 6 or h < 6 then return nil end
                return toMouse(Vector2.new(x1 + w / 2 + w * s[1], y1 + h / 2 + h * s[2]), cell)
            end
            local first = ((attempt or 1) - 1) % #AIM_SPOTS + 1
            local function search(strict)
                for i = 0, #AIM_SPOTS - 1 do
                    local idx = (first - 1 + i) % #AIM_SPOTS + 1
                    local pt = spot(AIM_SPOTS[idx])
                    if pt and inScreen(pt) and autoFix.hits(pt, cell, strict) then return pt, idx end
                end
                return nil
            end
            local pt, idx = search(true)
            if pt then
                if idx ~= first then afLog("aim:", cell.Name, "- the usual spot was covered, aimed at spot", idx, "instead") end
                return pt
            end
            pt, idx = search(false)
            if pt then
                afLog("aim:", cell.Name, "- something transparent sits over it, clicking anyway")
                return pt
            end
            local gui = cell:FindFirstAncestorWhichIsA("ScreenGui")
            if gui then autoFix.guiInset[gui], autoFix.calibTried[gui] = nil, nil end
            autoFix.addInset, autoFix.calibrated = nil, false
            AutoFixMemory.addInset = nil
            calibrateOffset(cell)
            pt = search(false)
            if pt then return pt end
            afLog("the click would have missed", cell.Name, "- skipped that move")
            return nil
        end

        local function release(pt)
            pcall(function() VIM:SendMouseButtonEvent(pt.X, pt.Y, 0, false, game, 0) end)
        end

        -- Six ways to move an item, fastest first. The script tries them in turn, remembers which one the
        -- game responds to, and uses that one first from then on (even if the script is re-run):
        --  1 = fast mouse drag   2 = standard mouse drag   3 = slow mouse drag   4 = mouse: tap item, tap slot
        --  5 = finger drag       6 = finger: tap item, tap slot
        local METHODS = 6
        local TOUCH_FIRST = game:GetService("UserInputService").TouchEnabled
            and not game:GetService("UserInputService").MouseEnabled
        -- Once a slow drag method (hold + long glide) has worked, it used to stay in use forever. Now the fast method
        -- is tried again about once a minute (only on a slot's first attempt); if it works it becomes the default again.
        autoFix.pickMethod = function(tries)
            local fast = game:GetService("UserInputService").MouseEnabled and 1 or 5
            local known = autoFix.method
            if known and known ~= fast and tries == 1 and os.clock() >= (autoFix.probeAt or 0) then
                autoFix.probeAt = os.clock() + 60
                return fast, true
            end
            return (((known or (TOUCH_FIRST and 5 or 1)) - 1 + tries - 1) % METHODS) + 1, false
        end
        -- `a` (the item) and `b` (where it goes) can be points, or functions that give the point right now. Functions are
        -- called when the item is pressed and again just before it is let go, so a backpack that slid or reshuffled in
        -- between doesn't make the drop land on the wrong spot.
        local function pointOf(v, fallback)
            if type(v) == "function" then
                local okf, r = pcall(v)
                if okf and r then return r end
                return fallback
            end
            return v
        end
        local function moveWith(method, a, b, ctx)
            local bF = b
            a = pointOf(a)
            b = pointOf(b)
            if not (a and b) then return false end
            local held = {}
            -- ctx = { keepA = the item, keepB = the list or slot it goes to }: anything on top of the press point or the release
            -- point that would swallow the click is made click-through for that moment (never the item or the list themselves)
            local function freeAt(pt, keep)
                if not (ctx and keep) then return end
                for _, o in ipairs(autoFix.clear(pt, keep, keep)) do held[#held + 1] = o end
            end
            local function relook() -- the drop point as it is now
                if type(bF) == "function" then b = pointOf(bF, b) or b end
            end
            local ok = pcall(function()
                if method >= 5 then
                    local id = 11
                    freeAt(a, ctx and ctx.keepA)
                    VIM:SendTouchEvent(id, 0, a.X, a.Y) -- finger down on the item
                    task.wait(0.06)
                    if method == 5 then
                        task.wait(0.2) -- hold, so it's treated as a drag and not a tap
                        for i = 1, 10 do
                            local t = i / 10
                            VIM:SendTouchEvent(id, 1, a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t)
                            task.wait(0.02)
                        end
                        task.wait(0.1)
                        relook()
                        freeAt(b, ctx and ctx.keepB)
                        VIM:SendTouchEvent(id, 1, b.X, b.Y)
                        VIM:SendTouchEvent(id, 2, b.X, b.Y) -- finger up on the slot
                    else
                        VIM:SendTouchEvent(id, 2, a.X, a.Y)
                        task.wait(0.2)
                        relook()
                        freeAt(b, ctx and ctx.keepB)
                        VIM:SendTouchEvent(id, 0, b.X, b.Y)
                        task.wait(0.06)
                        VIM:SendTouchEvent(id, 2, b.X, b.Y)
                    end
                    return
                end
                freeAt(a, ctx and ctx.keepA) -- (before the pointer arrives, so the item is what it hovers)
                VIM:SendMouseMoveEvent(a.X, a.Y, game)
                task.wait(0.04)
                if method == 4 then
                    VIM:SendMouseButtonEvent(a.X, a.Y, 0, true, game, 0)
                    task.wait(0.05)
                    VIM:SendMouseButtonEvent(a.X, a.Y, 0, false, game, 0)
                    task.wait(0.2)
                    relook()
                    VIM:SendMouseMoveEvent(b.X, b.Y, game)
                    task.wait(0.1)
                    freeAt(b, ctx and ctx.keepB)
                    VIM:SendMouseButtonEvent(b.X, b.Y, 0, true, game, 0)
                    task.wait(0.05)
                    VIM:SendMouseButtonEvent(b.X, b.Y, 0, false, game, 0)
                    return
                end
                local hold, steps, stepWait, hover
                if method == 1 then hold, steps, stepWait, hover = 0.03, 3, 0.004, 0.02
                elseif method == 2 then hold, steps, stepWait, hover = 0.28, 12, 0.025, 0.15
                else hold, steps, stepWait, hover = 0.55, 28, 0.035, 0.35 end
                VIM:SendMouseButtonEvent(a.X, a.Y, 0, true, game, 0)
                task.wait(hold) -- hold so the backpack treats it as a drag
                -- a tiny wiggle first: many backpacks only start a drag after the pointer has moved a bit
                VIM:SendMouseMoveEvent(a.X + 4, a.Y + 4, game)
                task.wait(0.015)
                for i = 1, steps do
                    local t = i / steps
                    VIM:SendMouseMoveEvent(a.X + (b.X - a.X) * t, a.Y + (b.Y - a.Y) * t, game)
                    task.wait(stepWait)
                end
                task.wait(hover) -- hover over the slot before letting go
                local before = b
                relook()
                if (b - before).Magnitude > 2 then -- the slot moved while we were gliding: follow it
                    VIM:SendMouseMoveEvent(b.X, b.Y, game)
                    task.wait(0.04)
                end
                freeAt(b, ctx and ctx.keepB)
                VIM:SendMouseButtonEvent(b.X, b.Y, 0, false, game, 0)
            end)
            restoreClickPath(held)
            if not ok then -- never leave the virtual finger / button held down
                if method >= 5 then
                    pcall(function() VIM:SendTouchEvent(11, 2, b.X, b.Y) end)
                else
                    release(b)
                end
            end
            return ok
        end

        ------------------------------------------------------------
        -- Hands-free mode: with the backpack CLOSED, it opens the backpack by itself (the game's own
        -- toggle key), drags the weapon into place, then closes it again. Only while you're idle.
        ------------------------------------------------------------
        local TOGGLE_KEYS = { Enum.KeyCode.H, Enum.KeyCode.Backquote } -- the game's "Close H"; Roblox's default is `

        local function searchBoxVisible() -- fallback "is the inventory screen up?" when its frame isn't known yet
            return autoFix.findSearch() ~= nil
        end

        local function inventoryIsOpen()
            local known = false
            if invWatchDefault and invWatchDefault.Parent then
                known = true
                if chainShown(invWatchDefault) then return true end
            end
            if invWatchGrid and invWatchGrid.Parent then
                known = true
                if chainShown(invWatchGrid) then return true end
            end
            if known then return false end
            return searchBoxVisible()
        end

        local function tapKey(code)
            SynthDragging = true
            pcall(function()
                VIM:SendKeyEvent(true, code, false, game)
                task.wait(0.04)
                VIM:SendKeyEvent(false, code, false, game)
            end)
            task.wait(0.08)
            SynthDragging = false
        end

        local function waitForOpenState(wantOpen, timeout)
            local t0 = os.clock()
            while os.clock() - t0 < timeout do
                if inventoryIsOpen() == wantOpen then return true end
                task.wait(0.05)
            end
            return inventoryIsOpen() == wantOpen
        end

        local function openInventory()
            if inventoryIsOpen() then return true end
            local order = {}
            if autoFix.key then order[1] = autoFix.key end
            for _, k in ipairs(TOGGLE_KEYS) do if k ~= autoFix.key then order[#order + 1] = k end end
            for _, k in ipairs(order) do
                tapKey(k)
                if waitForOpenState(true, 1.1) then
                    autoFix.key = k -- remember which key worked
                    return true
                end
            end
            return false
        end

        local function closeInventory()
            if not inventoryIsOpen() or not autoFix.key then return end
            tapKey(autoFix.key)
            if waitForOpenState(false, 1.3) then return end
            tapKey(autoFix.key) -- one more try, then leave it be
            waitForOpenState(false, 1.0)
        end

        local function rescanAll()
            pcall(resolveSlotFrames)
            pcall(scanInventory)
            for _, g2 in ipairs(glows) do pcall(checkSlot, g2) end
        end

        ------------------------------------------------------------
        -- Equippables (knuckles/gloves, boots, cloak, crown): they are NOT moved into a slot. Each is clicked
        -- in the backpack, then the empty screen is clicked ("click off"), then the item is put back out of your
        -- hands so it stays equipped. Once per spawn. (The Fist, in slot 8, uses the knuckles.)
        ------------------------------------------------------------
        -- Listens to the game's console output (LogService), so the script can hear when the game itself says
        -- something about equipping. Anything mentioning equip / knuckles / brass is remembered (and echoed as
        -- "[AutoFix] heard: ..." so you can see exactly what your game prints).
        local heard = {}
        game:GetService("LogService").MessageOut:Connect(function(msg)
            if type(msg) ~= "string" then return end
            if msg:find("[AutoFix]", 1, true) or msg:find("[Exotica]", 1, true) then return end
            local l = msg:lower()
            if l:find("equip", 1, true) or l:find("knuckle", 1, true) or l:find("brass", 1, true) or l:find("gloves", 1, true) then
                heard[#heard + 1] = { t = os.clock(), l = l }
                if #heard > 30 then table.remove(heard, 1) end
                warn("[AutoFix] heard:", msg:sub(1, 140))
            end
        end)

        -- The game also shows an "Equipped" message on screen (near the hotbar) when gear goes on. This watches the
        -- player GUI for it: it confirms an equip the script just did, and shows when YOU equipped something yourself
        -- (the message is stored with the console lines above, so isGearEquipped reads both the same way).
        autoFix.guiMsgAt = 0 -- when the last "equipped" message appeared
        autoFix.equipWindow = 0 -- while the script is equipping, its own put-away click is not counted as "unequipped"
        do
            local seenMsg = setmetatable({}, { __mode = "k" })
            local function noteMsg(obj)
                if not isCurrentInstance() then return end
                local okT, txt = pcall(function() return obj.Text end)
                if not okT or type(txt) ~= "string" or #txt < 6 or #txt > 140 then return end
                local l = txt:lower()
                if not l:find("equip", 1, true) then return end
                if obj:IsDescendantOf(sg) then return end
                -- the backpack's own item badges are not messages
                for _, root in ipairs({ invWatchDefault, invWatchGrid }) do
                    if root and root.Parent and obj:IsDescendantOf(root) then return end
                end
                local now = os.clock()
                local prev = seenMsg[obj]
                if prev and prev.l == l and now - prev.t < 1 then return end
                seenMsg[obj] = { l = l, t = now }
                local un = l:find("unequip", 1, true) or l:find("de-equip", 1, true) or l:find("not equipped", 1, true)
                if un and now < autoFix.equipWindow then return end
                heard[#heard + 1] = { t = now, l = l }
                if #heard > 30 then table.remove(heard, 1) end
                if not un then autoFix.guiMsgAt = now end
                warn("[AutoFix] on-screen message:", txt:sub(1, 100))
            end
            local function watchLabel(obj)
                if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                    noteMsg(obj)
                    obj:GetPropertyChangedSignal("Text"):Connect(function() pcall(noteMsg, obj) end)
                end
            end
            task.spawn(function()
                local pg0 = p:WaitForChild("PlayerGui", 10)
                if not pg0 then return end
                local count = 0
                for _, d in ipairs(pg0:GetDescendants()) do
                    count = count + 1
                    if count > 3000 then break end
                    pcall(watchLabel, d)
                end
                pg0.DescendantAdded:Connect(function(d) pcall(watchLabel, d) end)
            end)
        end

        -- Not every piece of gear shows a message when it goes on (the Baddie Mask doesn't), so there are backups. The
        -- character is snapshotted before the click and compared after it: a new part, accessory or attribute means
        -- something went on. Also, a gear Tool that moves into your Character without the script's help means YOU
        -- equipped it (hookTool, further down). Gear is never re-clicked just because nothing could be read: a second
        -- click can take it off again.
        autoFix.charKeys = function()
            local keys = {}
            local ch = p.Character
            if not ch then return keys end
            local n = 0
            for _, d in ipairs(ch:GetDescendants()) do
                n = n + 1
                if n > 700 then break end
                if not d:FindFirstAncestorWhichIsA("Tool") and not d:IsA("Tool") then
                    keys[d.ClassName .. ":" .. d.Name] = true
                end
            end
            for _, holder in ipairs({ ch, p }) do
                for k, v in pairs(holder:GetAttributes()) do keys["A:" .. tostring(k) .. "=" .. tostring(v)] = true end
            end
            return keys
        end
        autoFix.charChanged = function(before, after)
            local added = 0
            for k in pairs(after) do
                if not before[k] and not k:find("RightGrip", 1, true) then added = added + 1 end
            end
            return added
        end
        -- true only when the game or console said, by name, that this gear came off (a plain "can't read it" is not enough)
        autoFix.explicitlyOff = function(tool)
            local words = {}
            for w in tostring(tool.Name):lower():gmatch("%a+") do if #w >= 4 then words[#words + 1] = w end end
            for i = #heard, 1, -1 do
                local h = heard[i]
                if h.t >= (autoFix.spawnAt or 0) then
                    local hit = h.l:find(tostring(tool.Name):lower(), 1, true)
                    if not hit then for _, w in ipairs(words) do if h.l:find(w, 1, true) then hit = true break end end end
                    if hit then
                        return (h.l:find("unequip", 1, true) or h.l:find("de-equip", 1, true) or h.l:find("not equipped", 1, true)) ~= nil
                    end
                end
            end
            return false
        end

        -- true when something shows this piece of gear is on you: in your hands, a matching part on your
        -- character, an attribute naming it, the game saying "equipped", or (backpack open) an "Equipped" mark
        local function isGearEquipped(tool, cell)
            local ch = p.Character
            if ch and tool.Parent == ch then return true end
            local want = nz(tool.Name)
            local words = {}
            for w in tostring(tool.Name):lower():gmatch("%a+") do if #w >= 4 then words[#words + 1] = w end end
            if ch then
                for _, d in ipairs(ch:GetDescendants()) do
                    if not d:IsA("Tool") and not d:IsDescendantOf(tool) then
                        local n = nz(d.Name)
                        if #n >= 6 and (n == want or n:find(want, 1, true) or want:find(n, 1, true)) then return true end
                    end
                end
                for _, holder in ipairs({ ch, p }) do
                    for k, v in pairs(holder:GetAttributes()) do
                        local kk, vv = nz(k), (type(v) == "string") and nz(v) or ""
                        if kk:find(want, 1, true) or (#vv >= 4 and vv:find(want, 1, true)) then
                            if v ~= false and v ~= 0 and v ~= "" then return true end
                        end
                    end
                end
            end
            local state
            for _, h in ipairs(heard) do
                if h.t >= (autoFix.spawnAt or 0) then
                    local hit = h.l:find(tostring(tool.Name):lower(), 1, true)
                    if not hit then for _, w in ipairs(words) do if h.l:find(w, 1, true) then hit = true break end end end
                    if hit then
                        if h.l:find("unequip", 1, true) or h.l:find("de-equip", 1, true) or h.l:find("not equipped", 1, true) then state = false
                        elseif h.l:find("equip", 1, true) then state = true end
                    end
                end
            end
            if state ~= nil then return state end
            if cell then
                for _, d in ipairs(cell:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible and tostring(d.Text):lower():find("equipped", 1, true)
                        and not tostring(d.Text):lower():find("un", 1, true) then
                        return true
                    end
                end
            end
            return false
        end

        local function equipQueue()
            local list = {}
            if not AutoEquipEnabled then return list end
            local ch = p.Character
            for _, t in ipairs(PLAN.equip) do
                local et = WEAPONS.tool(t)
                if t.Parent and not (et and ConfigStore.equipOn[et.group] == false)
                    and not autoFix.equipDone[t.Name] and (autoFix.equipTries[t.Name] or 0) < 3
                    and not (ch and t.Parent == ch) and not isGearEquipped(t) then
                    list[#list + 1] = t
                end
            end
            -- knuckles first (they matter most), then the rest in a steady order
            table.sort(list, function(a, b)
                local ea, eb = WEAPONS.tool(a), WEAPONS.tool(b)
                local ka, kb = (ea and ea.group == "knuckle") and 0 or 1, (eb and eb.group == "knuckle") and 0 or 1
                if ka ~= kb then return ka < kb end
                return a.Name < b.Name
            end)
            return list
        end
        local function brassNeeded() return #equipQueue() > 0 end

        -- the top-bar offset for things that aren't tied to one cell (the empty screen the click-off goes to)
        local function globalInset()
            if autoFix.addInset ~= nil then return autoFix.addInset end
            return probeInset() and true or false
        end

        local function tapAt(pt, cell)
            SynthDragging = true
            -- a click on a cell goes THROUGH whatever sits on top of that point (never the cell itself)
            local freed = cell and autoFix.clear(pt, cell, cell) or nil
            pcall(function()
                if (autoFix.method or 0) >= 5 then
                    VIM:SendTouchEvent(12, 0, pt.X, pt.Y)
                    task.wait(0.06)
                    VIM:SendTouchEvent(12, 2, pt.X, pt.Y)
                else
                    VIM:SendMouseMoveEvent(pt.X, pt.Y, game)
                    task.wait(0.05)
                    VIM:SendMouseButtonEvent(pt.X, pt.Y, 0, true, game, 0)
                    task.wait(0.05)
                    VIM:SendMouseButtonEvent(pt.X, pt.Y, 0, false, game, 0)
                end
            end)
            task.wait(0.04)
            if freed then restoreClickPath(freed) end
            SynthDragging = false
        end

        -- a spot on the screen that is outside the backpack and not on any button, so a click there only "clicks off"
        local function freeScreenPoint()
            local cam = workspace.CurrentCamera
            if not cam then return nil end
            local size = cam.ViewportSize
            local inset = GuiService_:GetGuiInset()
            local pg = p:FindFirstChildOfClass("PlayerGui")
            local panel = invWatchDefault and invWatchDefault.Parent and invWatchDefault or autoFix.findPanel()
            for _, f in ipairs({ { 0.5, 0.07 }, { 0.35, 0.07 }, { 0.65, 0.07 }, { 0.5, 0.14 }, { 0.12, 0.4 }, { 0.88, 0.4 } }) do
                local mx, my = size.X * f[1], size.Y * f[2]
                local gx, gy = mx, my
                if globalInset() then gx, gy = mx - inset.X, my - inset.Y end
                local free = true
                local okq = pcall(function()
                    local function bad(list)
                        for _, o in ipairs(list) do
                            if not o:IsDescendantOf(sg) and (o:IsA("GuiButton") or o:IsA("TextBox") or o:IsA("ScrollingFrame") or o.Active) then
                                return true
                            end
                        end
                        return false
                    end
                    if pg and bad(pg:GetGuiObjectsAtPosition(gx, gy)) then free = false end
                    if panel and chainShown(panel) then
                        local ap, az = panel.AbsolutePosition, panel.AbsoluteSize
                        if gx >= ap.X and gx <= ap.X + az.X and gy >= ap.Y and gy <= ap.Y + az.Y then free = false end
                    end
                end)
                if okq and free then return Vector2.new(mx, my) end
            end
            return nil
        end

        -- the hotbar cell currently showing this tool, if it is on your hotbar
        local function hotbarCellFor(tool)
            for _, c in pairs(hotCellsByPos) do
                if c.Parent and c.AbsoluteSize.X > 4 and cellMatchesTool(c, tool) then return c end
            end
            return nil
        end

        -- Equippables (knuckles, gloves, boots, cloak, crown, mask, skates) don't belong on the hotbar: they get clicked on
        -- to equip and then live in the backpack. This finds one that's sitting on the hotbar. It does not depend on the
        -- Auto Equip switch or on the per-item switches: gear never stays on the hotbar, equipped or not.
        local function planEquipEvict()
            if not AutoFixEnabled then return nil end
            -- items that must never sit on the hotbar (Crew Spray) are taken off whatever the Auto Equip switch says
            for _, tool in ipairs(PLAN.noHotbar or {}) do
                if (autoFix.tries["x" .. tool.Name] or 0) < 4 and tool.Parent ~= p.Character then
                    local c = hotbarCellFor(tool)
                    if c then return tool, c end
                end
            end
            for _, tool in ipairs(PLAN.equipAll) do
                if (autoFix.tries["x" .. tool.Name] or 0) < 4 and tool.Parent ~= p.Character then
                    local c = hotbarCellFor(tool)
                    if c then return tool, c end
                end
            end
            return nil
        end

        -- A spot on the open backpack screen to drop an item onto, so it goes back INTO the backpack. The drop always lands
        -- inside the backpack box (the scrolling list first, then the rest of the panel around it), never on the hotbar, on an
        -- item, or on a button such as the Search box. Candidates are ranked by how close they are to the items (a short drag
        -- is a quick one); an empty slot is the best target of all. Anything that is merely drawn over the list without taking
        -- clicks (an invisible full-screen frame, a label) does not count against a spot. `attempt` picks a different,
        -- well-separated spot on each retry. Returns the point (mouse coordinates) and the list it is in, and never gives up
        -- while a backpack is on screen: if every spot looks covered it falls back to the least bad ones and says so.
        local function emptyInventorySpot(cells, attempt)
            attempt = attempt or 1
            local pg = p:FindFirstChildOfClass("PlayerGui")
            local panelKnown = autoFix.findPanel()
            -- the list the items sit in: the scrolling list (or grid) that holds the most cells
            local container
            do
                local groups, best = {}, nil
                for _, c in ipairs(cells or {}) do
                    local g = c:FindFirstAncestorWhichIsA("ScrollingFrame") or c.Parent
                    if g then
                        groups[g] = (groups[g] or 0) + 1
                        if not best or groups[g] > groups[best] then best = g end
                    end
                end
                container = best
            end
            if panelKnown and container and container ~= panelKnown and not container:IsDescendantOf(panelKnown) then
                container = panelKnown -- the cells found belong to some other screen: trust the backpack panel
            end
            if not container or container.AbsoluteSize.X < 80 or container.AbsoluteSize.Y < 80 then
                if panelKnown then container = panelKnown
                elseif invWatchGrid and invWatchGrid.Parent and chainShown(invWatchGrid) then container = invWatchGrid
                elseif invWatchDefault and invWatchDefault.Parent and chainShown(invWatchDefault) then container = invWatchDefault end
            end
            if not container then return nil end
            autoFix.settle(container, 0.4)
            local box = autoFix.panelAround(container) or container
            local cx1, cy1, cx2, cy2 = autoFix.visibleRect(container)
            local bx1, by1, bx2, by2 = autoFix.visibleRect(box)
            local hx1, hy1, hx2, hy2
            do
                local hot = rowRef and rowRef.cell and rowRef.cell.Parent
                if hot and hot:IsA("GuiObject") then hx1, hy1, hx2, hy2 = autoFix.visibleRect(hot) end
            end
            local live = {}
            for _, c in ipairs(cells or {}) do
                if c.Parent and c.AbsoluteSize.X > 4 and (c == container or c:IsDescendantOf(container)) then live[#live + 1] = c end
            end
            -- where the items are (the drag should be short): the middle of the cells, else the middle of the list
            local ax, ay = (cx1 + cx2) / 2, (cy1 + cy2) / 2
            if #live > 0 then
                local sx, sy = 0, 0
                for _, c in ipairs(live) do
                    sx = sx + c.AbsolutePosition.X + c.AbsoluteSize.X / 2
                    sy = sy + c.AbsolutePosition.Y + c.AbsoluteSize.Y / 2
                end
                ax, ay = sx / #live, sy / #live
            end
            local function nearCell(px, py)
                for _, c in ipairs(live) do
                    local cp, csz = c.AbsolutePosition, c.AbsoluteSize
                    if px >= cp.X - 6 and px <= cp.X + csz.X + 6 and py >= cp.Y - 6 and py <= cp.Y + csz.Y + 6 then return true end
                end
                return false
            end
            local function inHotbar(px, py)
                return hx1 ~= nil and px >= hx1 - 8 and px <= hx2 + 8 and py >= hy1 - 8 and py <= hy2 + 8
            end
            -- nothing that takes clicks sits on this point, except the list itself (an item or a button inside it does)
            local function guiOk(px, py)
                if not pg then return true end
                local okq, list = pcall(function() return pg:GetGuiObjectsAtPosition(px, py) end)
                if not okq then return true end
                for _, o in ipairs(list) do
                    if not o:IsDescendantOf(sg) then
                        local mine = (o == container) or o:IsDescendantOf(container) or container:IsDescendantOf(o)
                        if mine then
                            if o:IsA("GuiButton") and o ~= container then return false end
                        elseif o:IsA("GuiButton") or o:IsA("TextBox") or o.Active then
                            return false
                        end
                    end
                end
                return true
            end
            local function emptyCell(c)
                local imgs = readSlotImages({ frame = c, slot = "" })
                if imgs and next(imgs) then return false end
                for _, str in ipairs(harvestSlotStrings({ frame = c }) or {}) do
                    if #nz(str) >= 3 then return false end
                end
                return true
            end
            local function inRect(px, py, x1, y1, x2, y2) return px >= x1 and px <= x2 and py >= y1 and py <= y2 end

            local picks, weak, seen = {}, {}, 0
            local function far(list, px, py)
                for _, v in ipairs(list) do
                    if (v[1] - px) ^ 2 + (v[2] - py) ^ 2 < 4900 then return false end
                end
                return true
            end
            -- an empty slot is the best target of all (same size as the other cells, not covered, inside the list)
            for _, c in ipairs(live) do
                if emptyCell(c) then
                    local ap, az = c.AbsolutePosition, c.AbsoluteSize
                    local mx, my = ap.X + az.X / 2, ap.Y + az.Y / 2
                    if inRect(mx, my, cx1, cy1, cx2, cy2) and not inHotbar(mx, my)
                        and autoFix.hits(toMouse(Vector2.new(mx, my), c), c, true) then
                        picks[#picks + 1] = { mx, my, ((mx - ax) ^ 2 + (my - ay) ^ 2) - 1e9, 0 }
                    end
                end
            end
            -- bare space: a grid of points over the backpack box, the list's own area first
            local pts = {}
            do
                local m = 10
                local stepX = math.max(24, (bx2 - bx1 - 2 * m) / 14)
                local stepY = math.max(24, (by2 - by1 - 2 * m) / 10)
                local y = by1 + m
                while y <= by2 - m do
                    local x = bx1 + m
                    while x <= bx2 - m do
                        if not inHotbar(x, y) and not nearCell(x, y) then
                            local tier = inRect(x, y, cx1, cy1, cx2, cy2) and 1 or 2
                            pts[#pts + 1] = { x, y, (x - ax) ^ 2 + (y - ay) ^ 2, tier }
                        end
                        x = x + stepX
                    end
                    y = y + stepY
                end
                table.sort(pts, function(u, v)
                    if u[4] ~= v[4] then return u[4] < v[4] end
                    return u[3] < v[3]
                end)
            end
            for _, c in ipairs(pts) do
                if #picks >= 6 then break end
                if far(picks, c[1], c[2]) then
                    if guiOk(c[1], c[2]) then
                        picks[#picks + 1] = c
                    elseif #weak < 6 then
                        weak[#weak + 1] = c
                    end
                end
            end
            local how = "clear"
            if #picks == 0 then
                -- every spot looks covered by something that takes clicks: use the least bad ones, the list's own area first
                how = "covered"
                for _, c in ipairs(pts) do
                    if #picks >= 6 then break end
                    if far(picks, c[1], c[2]) then picks[#picks + 1] = c end
                end
            end
            if #picks == 0 then
                how = "centre"
                picks[1] = { (cx1 + cx2) / 2, (cy1 + cy2) / 2, 0, 3 }
                if inHotbar(picks[1][1], picks[1][2]) then
                    picks[1] = { (bx1 + bx2) / 2, by1 + 14, 0, 3 }
                end
            end
            local pick = picks[((attempt - 1) % #picks) + 1]
            local fl = math.floor
            afLog(string.format("drop spot for attempt %d: (%d,%d) %s | list %s %dx%d, box %dx%d, %d choices (%s)", attempt,
                fl(pick[1]), fl(pick[2]), pick[4] == 0 and "on an empty slot" or (pick[4] == 1 and "in the list" or "in the panel"),
                container.Name, fl(cx2 - cx1), fl(cy2 - cy1), fl(bx2 - bx1), fl(by2 - by1), #picks, how))
            if how ~= "clear" and pg then
                local okd, hitList = pcall(function() return pg:GetGuiObjectsAtPosition(pick[1], pick[2]) end)
                if okd then
                    local names = {}
                    for n, o in ipairs(hitList) do
                        if n > 5 then break end
                        names[#names + 1] = o.ClassName .. ":" .. o.Name .. (o.Active and "*" or "")
                    end
                    afLog("  on top of that spot:", table.concat(names, " > "))
                end
            end
            return toMouse(Vector2.new(pick[1], pick[2]), container), container
        end

        -- Some gear (for example the Gorilla Gel) is not a tool at all: it only exists as an item in the backpack screen.
        -- When the backpack is open, any item whose name matches these words is clicked once per spawn.
        local GEAR_WORDS = { "gorilla", "hairglue", "hairgel", "snure" }
        autoFix.guiGear = function()
            if ConfigStore.equipOn.gorilla == false then return nil end
            local cells = inventoryCells()
            if #cells == 0 then cells = looseCells() end
            local function gearRank(c)
                for _, str in ipairs(harvestSlotStrings({ frame = c }) or {}) do
                    local n = nz(str)
                    for i, w in ipairs(GEAR_WORDS) do
                        if n:find(w, 1, true) and not autoFix.equipDone["gui:" .. w] then return i end
                    end
                end
                return nil
            end
            local seenGear = false
            for _, c in ipairs(cells) do if gearRank(c) then seenGear = true break end end
            if not seenGear and not autoFix.scrolled.gui and AutoFixMemory.guiGear then
                autoFix.scrolled.gui = true
                local okS, c2, cs2 = pcall(autoFix.scrollPick, gearRank)
                if okS and c2 then cells = cs2 end
            end
            for _, c in ipairs(cells) do
                for _, str in ipairs(harvestSlotStrings({ frame = c }) or {}) do
                    local n = nz(str)
                    for _, w in ipairs(GEAR_WORDS) do
                        local key = "gui:" .. w
                        if n:find(w, 1, true) and not autoFix.equipDone[key] then
                            autoFix.equipDone[key] = true
                            AutoFixMemory.guiGear = true -- next time, open the backpack at spawn to equip it
                            calibrateOffset(c)
                            local pt = autoFix.safePoint(c, 1)
                            if pt then
                                tapAt(pt, c)
                                task.wait(0.08)
                                local away = freeScreenPoint()
                                if not away then
                                    local cam = workspace.CurrentCamera
                                    if cam then away = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.08) end
                                end
                                if away then
                                    local freed = freeClickPath(away.X, away.Y, globalInset())
                                    tapAt(away)
                                    restoreClickPath(freed)
                                end
                                task.wait(0.06)
                                afLog("equipped backpack item:", str)
                                return str
                            end
                        end
                    end
                end
            end
            return nil
        end

        -- 3.2: nothing is moved while you're dead, and slot fixes pause if a fight starts mid-run
        autoFix.raw = { planFix = planFix, planEvict = planEvict, planEquipEvict = planEquipEvict,
            equipQueue = equipQueue, guiGear = autoFix.guiGear }
        autoFix.gate = function(checkFight)
            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return false end
            if checkFight and autoFix.busy and not autoFix.forced() and os.clock() - LastCombat < 8 then return false end
            return true
        end
        planFix = function() if not autoFix.gate(true) then return nil end return autoFix.raw.planFix() end
        planEvict = function() if not autoFix.gate(true) then return nil end return autoFix.raw.planEvict() end
        planEquipEvict = function() if not autoFix.gate(false) then return nil end return autoFix.raw.planEquipEvict() end
        equipQueue = function() if not autoFix.gate(false) then return {} end return autoFix.raw.equipQueue() end
        autoFix.guiGear = function() if not autoFix.gate(false) then return nil end return autoFix.raw.guiGear() end

        -- click on the empty screen. If a button or panel is on that spot, the click goes through it to what's
        -- behind it (the same click-through the aim assist uses), so it can never press a UI.
        local function clickOff()
            local away = freeScreenPoint()
            if not away then
                local cam = workspace.CurrentCamera
                if cam then away = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.08) end
            end
            if away then
                local freed = freeClickPath(away.X, away.Y, globalInset())
                tapAt(away)
                restoreClickPath(freed)
            end
        end

        -- Every piece of gear is equipped the same way as the knuckles: click it, then click off. With more gear waiting
        -- (isLast == false) it goes straight on to the next piece. Only the LAST piece is put away: it is clicked once
        -- more so it isn't left highlighted, then click off again.
        local function equipGear(tool, isLast)
            autoFix.equipTries[tool.Name] = (autoFix.equipTries[tool.Name] or 0) + 1
            if isGearEquipped(tool) then autoFix.equipDone[tool.Name] = true return true end
            -- it may be sitting on your hotbar (the game drops new gear into the first free slot) or in the
            -- backpack screen. The hotbar is always visible, so try it first.
            local cell = hotbarCellFor(tool)
            local where = "hotbar"
            if not cell then
                where = "backpack"
                local cells = inventoryCells()
                if #cells == 0 then cells = looseCells() end
                for _, c in ipairs(cells) do
                    if cellMatchesTool(c, tool) then cell = c break end
                end
                if not cell then -- below the fold of a long backpack: scroll for it
                    local okS, c = pcall(autoFix.scrollPick, function(cc) if cellMatchesTool(cc, tool) then return 1 end end)
                    if okS and c then cell = c end
                end
            end
            if not cell then afLog(tool.Name .. ": not found on the hotbar or in the backpack screen") return false end
            afLog(tool.Name .. ": found on the " .. where)
            calibrateOffset(cell)
            local tapPt = autoFix.safePoint(cell, autoFix.equipTries[tool.Name] or 1)
            if not tapPt then afLog(tool.Name, ": couldn't aim a safe click at it, skipped") return false end
            autoFix.equipWindow = os.clock() + 8
            local t0 = os.clock()
            local before = autoFix.charKeys()
            local wasHeld = tool.Parent == p.Character
            tapAt(tapPt, cell) -- click the item
            task.wait(0.08)
            clickOff()
            -- the game puts an "Equipped" message on screen when it worked: give it a moment to appear
            local msgOk = false
            local msgBy = os.clock() + 1.0
            while os.clock() < msgBy do
                if autoFix.guiMsgAt >= t0 then msgOk = true break end
                if not wasHeld and tool.Parent == p.Character then break end -- in your hand now: that is the answer, no need to wait for a message
                task.wait(0.03)
            end
            if not msgOk and tool.Parent ~= p.Character then -- no message and not in hand: use Roblox's own equip call
                pcall(function()
                    local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                    ConfigStore.pace()
                    if hum then hum:EquipTool(tool) end
                end)
                task.wait(0.06)
            end
            local inHand = tool.Parent == p.Character
            if inHand and isLast ~= false then
                -- the last piece: click it again so it isn't left highlighted, then click off
                local cell2 = (cell and cell.Parent) and cell or hotbarCellFor(tool)
                if not cell2 then
                    local cs = inventoryCells()
                    if #cs == 0 then cs = looseCells() end
                    for _, c in ipairs(cs) do
                        if cellMatchesTool(c, tool) then cell2 = c break end
                    end
                end
                local pt2 = cell2 and autoFix.safePoint(cell2, autoFix.equipTries[tool.Name] or 1)
                if pt2 then
                    tapAt(pt2, cell2)
                    task.wait(0.08)
                    clickOff()
                    task.wait(0.08)
                end
                if tool.Parent == p.Character then -- still in hand: put it away with Roblox's own call
                    pcall(function()
                        local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                        if hum then hum:UnequipTools() end
                    end)
                    task.wait(0.04)
                end
            end
            autoFix.equipWindow = os.clock() + 1.2 -- (a late "unequipped" line from the put-away click is still ignored)
            -- how do we know it went on? the message, the tool in hand, a change on the character, or anything isGearEquipped sees
            local how = msgOk and "message" or (inHand and "hand") or nil
            if not how and autoFix.charChanged(before, autoFix.charKeys()) > 0 then how = "character" end
            if not how and isGearEquipped(tool, cell) then how = "state" end
            local ok = how ~= nil
            if ok then
                autoFix.equipDone[tool.Name] = true
                autoFix.equipHow[tool.Name] = how
            elseif (autoFix.equipTries[tool.Name] or 0) >= 2 then
                -- two clicks and nothing readable: stop here rather than risk toggling it off. Counted as done for this life.
                autoFix.equipDone[tool.Name] = true
                autoFix.equipHow[tool.Name] = "assumed"
                afLog(tool.Name, ": no sign it went on after two tries, assuming it did and leaving it alone")
            end
            afLog(tool.Name, "| evidence:", how or "none", "| was in hand:", inHand, "| message seen:", msgOk, "| back out of hand:", tool.Parent ~= p.Character)
            return ok
        end

        local function checkAll() for _, g2 in ipairs(glows) do pcall(checkSlot, g2) end end

        local function runAutoFix(handsFree, equipOnly)
            autoFix.busy = true
            local moved, failed, extra = {}, {}, {}
            local opened, weOpened = false, false
            autoFix.grid = nil
            autoFix.scrolled = {}
            autoFix.yielded = false
            local okRun, errRun = pcall(function()
                if handsFree then
                    local n = #equipQueue()
                    if planEquipEvict() then n = n + 1 end -- gear sitting on the hotbar
                    if not equipOnly then
                        for _, g in ipairs(glows) do if needsFix(g) then n = n + 1 end end
                        if planEvict() then n = n + 1 end
                    end
                    autoFix.closedCycles = autoFix.closedCycles + 1
                    autoFix.cool = os.clock() + 20
                    if autoFixStatus then pcall(autoFixStatus, n, equipOnly) end
                    autoFix.silent = true -- no backpack hum for this quick visit
                    afLog("opening the backpack, things to do:", n)
                    pcall(resolveSlotFrames) -- fresh hotbar cells (your GUI is rebuilt on every spawn)
                    local onHotbar = false -- gear has to come off the hotbar, which needs the backpack open
                    if false then
                        for _, t in ipairs(equipQueue()) do
                            if not hotbarCellFor(t) then onHotbar = false break end
                        end
                    end
                    if onHotbar then
                        opened = true -- nothing to open: your gear is on the hotbar already
                        afLog("gear is on the hotbar, no need to open the backpack")
                    else
                        local wasOpen = inventoryIsOpen()
                        if not openInventory() then
                            afLog("could not open the backpack with H or `")
                            autoFix.cool = os.clock() + (equipOnly and 12 or 120)
                            return
                        end
                        opened, weOpened = true, not wasOpen
                        task.wait(0.08) -- let it draw, then read it fresh
                        rescanAll()
                    end
                end
                -- equippables don't belong on the hotbar: drag them back into the backpack first
                for _ = 1, 6 do
                    if not AutoFixEnabled then break end
                    if not (opened or autoOpen) then break end
                    if not equipOnly and not autoFix.forced() and ((os.clock() - ConfigStore.pressAt < 0.25 or autoFix.userHolding()) or Engine.run ~= nil) then
                        if autoFix.userTookOver() then autoFix.yielded = true end
                        break
                    end
                    local tool, hcell = planEquipEvict()
                    if not tool then break end
                    autoFix.grid = nil
                    local cells = inventoryCells()
                    if #cells == 0 then cells = looseCells() end
                    local key = "x" .. tool.Name
                    autoFix.tries[key] = (autoFix.tries[key] or 0) + 1
                    local spot, dropTree = emptyInventorySpot(cells, autoFix.tries[key])
                    if not spot then afLog("no backpack screen found to drop", tool.Name, "into") break end
                    calibrateOffset(hcell)
                    local nTry = autoFix.tries[key]
                    local src = autoFix.safePoint(hcell, nTry)
                    if not src then break end
                    local method = ((autoFix.method or (TOUCH_FIRST and 5 or 1)) - 1 + nTry - 1) % METHODS + 1
                    SynthDragging = true
                    moveWith(method, function() return autoFix.safePoint(hcell, nTry) or src end, spot, { keepA = hcell, keepB = dropTree })
                    task.wait(0.05)
                    SynthDragging = false
                    task.wait(0.05)
                    pcall(resolveSlotFrames)
                    if not hotbarCellFor(tool) then
                        extra[#extra + 1] = "Moved " .. tool.Name .. " off your hotbar."
                        playEmbedded("confirm", 0.6, 0.891, 1)
                        afLog(tool.Name, "moved off the hotbar (method", method .. ")")
                    else
                        afLog(tool.Name, "is still on the hotbar after method", method)
                    end
                end
                autoFix.grid = nil
                for _ = 1, (equipOnly and 0 or 12) do
                    if not AutoFixEnabled then break end
                    if not (opened or autoOpen) then break end
                    if not autoFix.forced() and (os.clock() - ConfigStore.pressAt < 0.25 or autoFix.userHolding()) then -- you pressed or dragged something just now: step back
                        if autoFix.userTookOver() then autoFix.yielded = true end
                        break
                    end
                    if Engine.run ~= nil then break end
                    local g, cell = planFix()
                    local evictDst, evictName, evictTree
                    if not g then
                        g = planEvict()
                        if not g then break end
                        cell = g.frame
                        evictName = slotItemName(g)
                        local ecells = autoFix.grid or inventoryCells()
                        if #ecells == 0 then ecells = looseCells() end
                        evictDst, evictTree = emptyInventorySpot(ecells, (autoFix.tries["e" .. g.slot] or 0) + 1)
                        if not evictDst then
                            afLog("no backpack screen found to drop", evictName, "into")
                            autoFix.tries["e" .. g.slot] = 4
                            break
                        end
                    end
                    calibrateOffset(cell)
                    local tkey = evictDst and ("e" .. g.slot) or g.slot
                    local tries = (autoFix.tries[tkey] or 0) + 1
                    autoFix.tries[tkey] = tries
                    local src, dst = autoFix.safePoint(cell, tries), evictDst or targetCenter(g)
                    if not (src and dst) then afLog("no safe screen position for slot", g.slot) break end
                    if g.frame and not evictDst and g.frame.Parent and not autoFix.hits(dst, g.frame) then
                        dst = autoFix.safePoint(g.frame, tries)
                        if not dst then afLog("the drop point for slot", g.slot, "would have missed, skipped") break end
                    end
                    local method, probing = autoFix.pickMethod(tries)
                    afLog(string.format("slot %s (%s): method %d, from %s (%d,%d, %dx%d) to (%d,%d)", g.slot, tostring(g.status), method,
                        cell:GetFullName():sub(-60), math.floor(src.X), math.floor(src.Y), math.floor(cell.AbsoluteSize.X),
                        math.floor(cell.AbsoluteSize.Y), math.floor(dst.X), math.floor(dst.Y)))
                    -- the press/release watchers are only for diagnosing; skipped once a method is known to work
                    local watching = autoFix.method == nil
                    local srcRec = watching and watchHits(cell) or { began = 0, ended = 0, entered = false, stop = function() end }
                    local dstRec = watching and g.frame and watchHits(g.frame) or nil
                    SynthDragging = true
                    local dstNow = dst
                    if g.frame and not evictDst then
                        dstNow = function() return (g.frame.Parent and autoFix.safePoint(g.frame, tries)) or dst end
                    end
                    moveWith(method, function() return autoFix.safePoint(cell, tries) or src end, dstNow,
                        { keepA = cell, keepB = evictDst and evictTree or g.frame })
                    task.wait(0.05)
                    SynthDragging = false
                    if watching then afLog(string.format("  item: pointer entered=%s, press landed=%d, release landed=%d | slot: entered=%s, press=%d, release=%d",
                        tostring(srcRec.entered), srcRec.began, srcRec.ended,
                        tostring(dstRec and dstRec.entered), dstRec and dstRec.began or 0, dstRec and dstRec.ended or 0)) end
                    srcRec.stop()
                    if dstRec then dstRec.stop() end
                    task.wait(0.03)
                    checkAll() -- did it land?
                    if probing then -- a failed fast-method test must not push the retry onto an even slower method
                        local good
                        if evictDst then good = not slotFilled(g) else good = g.status == "ok" end
                        if not good then autoFix.tries[tkey] = tries - 1 end
                    end
                    if evictDst then
                        if not slotFilled(g) then
                            autoFix.method = method
                            AutoFixMemory.method = method
                            extra[#extra + 1] = "Moved " .. evictName .. " out of slot " .. g.slot .. " and back to your inventory."
                            playEmbedded("confirm", 0.6, 0.891, 1)
                            afLog("slot", g.slot, "cleared of", evictName)
                        end
                    elseif g.status == "ok" then
                        autoFix.method = method -- the game responds to this one, use it first from now on
                        AutoFixMemory.method = method
                        moved[#moved + 1] = g
                        g.flashUntil = os.clock() + 3.2 -- the slot flashes on screen (see the glow loop)
                        playEmbedded("confirm", 0.7, ({ 0.891, 1, 1.122, 1.335, 1.498 })[math.max(1, math.min(#moved, 5))], 1)
                        afLog("slot", g.slot, "fixed with method", method)
                    end
                end
                -- equippables, once per spawn (knuckles/gloves, boots, cloak, crown, mask, skates)
                local ranGear = false
                for _ = 1, 8 do
                    if not (opened or autoOpen) then break end
                    -- right after a respawn (equipOnly) it equips no matter what you're doing
                    if not equipOnly and not autoFix.forced() and ((os.clock() - ConfigStore.pressAt < 0.25 or autoFix.userHolding()) or Engine.run ~= nil) then
                        if autoFix.userTookOver() then autoFix.yielded = true end
                        break
                    end
                    local q = equipQueue()
                    if #q == 0 then
                        -- gear marked done that is no longer on (the game pulled it off): put it back in the queue
                        for _, t in ipairs(PLAN.equipAll) do
                            if autoFix.equipDone[t.Name] and t.Parent and autoFix.explicitlyOff(t) and (autoFix.equipTries[t.Name] or 0) < 3 then
                                autoFix.equipDone[t.Name] = nil
                            end
                        end
                        q = equipQueue()
                    end
                    if #q == 0 then break end
                    ranGear = true
                    if equipGear(q[1], #q == 1) then
                        extra[#extra + 1] = "Equipped your " .. q[1].Name .. "."
                    else
                        failed[#failed + 1] = "Couldn't equip " .. q[1].Name .. " yet."
                    end
                end
                -- a piece left in hand for the next one (and the next one failed): put it away now
                for _, gt in ipairs(ranGear and PLAN.equipAll or {}) do
                    if gt.Parent == p.Character then
                        pcall(function()
                            local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
                            if hum then hum:UnequipTools() end
                        end)
                        break
                    end
                end
                -- gear that only exists in the backpack screen (Gorilla Gel and similar)
                if AutoEquipEnabled and (opened or autoOpen) then
                    local got = autoFix.guiGear()
                    if got then extra[#extra + 1] = "Equipped your " .. got .. "." end
                end
                -- say so when slot 1 got a stand-in because there is no Taser
                for _, g in ipairs(moved) do
                    if g.slot == "1" and PLAN.slot1Fallback then
                        extra[#extra + 1] = "No Taser found, so " .. PLAN.slot1Fallback.Name .. " went into slot 1."
                    end
                end
                -- anything still not right: say why, so it can be reported and fixed
                for _, g in ipairs(glows) do
                    if not equipOnly and needsFix(g) and g.status ~= "ok" then
                        local nm = (g.label:gsub("^.-· ", ""))
                        if (autoFix.tries[g.slot] or 0) == 0 then
                            failed[#failed + 1] = "Couldn't see " .. nm .. " in your backpack view."
                        else
                            failed[#failed + 1] = nm .. " didn't move after " .. autoFix.tries[g.slot] .. " methods."
                        end
                    end
                end
            end)
            if not okRun then
                warn("[Exotica] Auto Slot Fix error: " .. tostring(errRun))
                pcall(ConfigStore.reportBug, "autofix", errRun)
                failed[#failed + 1] = "Internal error: " .. tostring(errRun):sub(1, 90)
                autoFix.lastError = tostring(errRun)
            end
            SynthDragging = false
            -- only close it if the script was the one that opened it, and never while you are using it
            if autoFix.yielded then autoFix.handsOff = true end -- you took over mid-run: leave it open and untouched
            if autoFix.scrollHome and not autoFix.yielded then
                local sh = autoFix.scrollHome
                pcall(function() if sh.sf.Parent then sh.sf.CanvasPosition = sh.pos end end)
            end
            autoFix.scrollHome = nil
            if weOpened and not autoFix.yielded then pcall(closeInventory) end
            autoFix.silent = false
            autoFix.busy = false
            if handsFree and #moved == 0 and #extra == 0 then
                autoFix.cool = os.clock() + 180 -- nothing to do or nothing worked: don't pop up again for a while
            end
            if #moved > 0 or #extra > 0 then
                autoFix.closedCycles = 0 -- it's working, keep going next time
                if autoFixNotify then pcall(autoFixNotify, moved, extra) end
            elseif #failed > 0 and handsFree then
                for _, f in ipairs(failed) do afLog(f) end
                local sig = table.concat(failed, "|")
                if sig ~= autoFix.lastFailSig or os.clock() - autoFix.lastFailAt > 300 then
                    autoFix.lastFailSig, autoFix.lastFailAt = sig, os.clock()
                    if autoFixFail then pcall(autoFixFail, failed) end
                end
            end
        end

        local function autoFixTick(now)
            if not AutoFixEnabled or autoFix.busy then return end

            if now >= autoFix.rearmAt then -- check again periodically, even after earlier give-ups
                autoFix.rearmAt = now + 90
                autoFix.closedCycles = 0
                autoFix.cool = math.min(autoFix.cool, now)
                autoFix.equipTries = {} -- gear that failed three times gets three more tries (gear that is on stays marked done)
            end

            if autoOpen then -- backpack is open (you opened it)
                if autoFix.openSince == 0 then
                    autoFix.openSince = now
                    autoFix.clickMark = ConfigStore.clickAt or 0
                end
                -- the tap or key that opened the backpack can land a moment after it is noticed: it never counts as
                -- you taking over, so the work starts as soon as the backpack is up
                if now - autoFix.openSince < 0.6 then autoFix.clickMark = ConfigStore.clickAt or 0 end
                if now < autoFix.nextTick then return end
                autoFix.nextTick = now + 0.06
                if now - autoFix.openSince < 0.1 then return end -- a brief moment to finish opening, then go
                -- a brief beat after you open it (moving the mouse doesn't count), then it gets to work
                if os.clock() - ConfigStore.pressAt < 0.35 or autoFix.userHolding() or Engine.run ~= nil then return end
                -- you clicked or dragged something in this backpack yourself: it is yours until it's closed, no re-sorting under your hand
                if (ConfigStore.clickAt or 0) > (autoFix.clickMark or 0) then autoFix.handsOff = true end
                if autoFix.handsOff and not autoFix.forced() then return end
                if os.clock() - LastCombat < 4 then return end -- mid-fight: never touch the backpack
                for _, g in ipairs(glows) do
                    if needsFix(g) and (autoFix.tries[g.slot] or 0) < MAXTRIES then
                        task.spawn(runAutoFix, false)
                        return
                    end
                end
                if brassNeeded() or planEvict() or planEquipEvict() then task.spawn(runAutoFix, false) end
                return
            end

            -- backpack is closed
            autoFix.openSince = 0
            autoFix.handsOff = false
            autoFix.tries = {}
            if now < autoFix.nextClosed then return end
            if now < autoFix.cool or autoFix.closedCycles >= 3 or HighPing then
                autoFix.nextClosed = now + 1.5
                return
            end
            -- right after the script starts or you respawn it only needs a short pause; otherwise it waits for a quiet moment
            local idleNeeded = (now < autoFix.relaxUntil) and 1.0 or 3
            -- (also busy while the character is actually walking: the sorting waits for you to stand still, or asks first)
            local hum0 = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
            local walking = hum0 ~= nil and hum0.MoveDirection.Magnitude > 0.1
            local busy = os.clock() - LastUserInput < idleNeeded or Engine.run ~= nil or os.clock() - LastCombat < 10 or walking
            local forced = autoFix.forced()
            autoFix.nextClosed = now + ((busy and not forced) and 6 or 1.5)
            rescanAll()
            local need = false
            for _, g in ipairs(glows) do
                if needsFix(g) then need = true break end
            end
            if brassNeeded() or planEvict() or planEquipEvict() then need = true end
            if busy and not forced then
                -- you're busy: ask instead of interrupting (tap the prompt to fix now, or it waits for a quiet moment)
                autoFix.badStreak = need and (autoFix.badStreak + 1) or 0
                if need and autoFix.badStreak >= 2 and now - autoFix.lastPrompt > 120 then
                    autoFix.lastPrompt = now
                    if slotGlow.promptFix then pcall(slotGlow.promptFix) end
                end
                return
            end
            autoFix.badStreak = need and (autoFix.badStreak + 1) or 0
            if autoFix.badStreak >= 2 or (forced and need) then -- the same problem twice in a row, so it isn't a blip
                autoFix.badStreak = 0
                task.spawn(runAutoFix, true)
            end
        end


        -- right after a spawn (and when the script first loads): wait for your tools to arrive, then open the backpack,
        -- equip your knuckles/gear, and close it. This ignores idle and combat checks on purpose.
        -- wait until the new character is fully there: alive, appearance loaded, your hotbar drawn, and your
        -- tools finished arriving (their count stable for a moment). Starting earlier is why it used to fail.
        local function waitForSpawnReady()
            local t0 = os.clock()
            while os.clock() - t0 < 10 do
                local ch = p.Character
                local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 and ch:FindFirstChild("HumanoidRootPart") then
                    local okA, loaded = pcall(function() return p:HasAppearanceLoaded() end)
                    if (not okA) or loaded then break end
                end
                task.wait(0.1)
            end
            local last, since = -1, os.clock()
            while os.clock() - t0 < 14 do
                pcall(resolveSlotFrames)
                local bp = p:FindFirstChildOfClass("Backpack")
                local n = (bp and #bp:GetChildren() or 0)
                if p.Character then
                    for _, c in ipairs(p.Character:GetChildren()) do if c:IsA("Tool") then n = n + 1 end end
                end
                if n ~= last then last, since = n, os.clock() end
                local barUp = rowRef and rowRef.cell and rowRef.cell.Parent and chainShown(rowRef.cell.Parent)
                if os.clock() - since > 0.35 and barUp then break end
                task.wait(0.05)
            end
            task.wait(0.1)
        end

        -- right after a spawn (and when the script first loads): wait for the spawn to finish, then open the
        -- backpack, equip your knuckles/gear, and close it. Ignores idle and combat checks on purpose.
        local function respawnEquip()
            if not (AutoEquipEnabled or AutoFixEnabled) then return end -- (gear is taken off the hotbar even with Auto Equip off)
            waitForSpawnReady()
            for attempt = 1, 3 do
                pcall(scanInventory)
                if #equipQueue() == 0 and not planEquipEvict() and not (AutoEquipEnabled and ConfigStore.equipOn.gorilla and AutoFixMemory.guiGear) then return end
                local w0 = os.clock()
                while autoFix.busy and os.clock() - w0 < 10 do task.wait(0.1) end
                if autoFix.busy then return end
                autoFix.cool = 0
                runAutoFix(true, true)
                if #equipQueue() == 0 and not planEquipEvict() then return end
                task.wait(attempt == 1 and 0.8 or 1.6) -- another go after a short pause if anything is still not on
                autoFix.equipTries = {}
            end
        end
        task.spawn(respawnEquip)

        -- run a check shortly after the script starts, and every time you respawn
        autoFix.relaxUntil = os.clock() + 30
        autoFix.nextClosed = os.clock() + 5
        -- notice fights: taking damage or swinging a tool counts as combat
        autoFix.hooked = setmetatable({}, { __mode = "k" })
        autoFix.hookTool = function(t) -- one Activated listener per tool, no matter how often it moves Backpack <-> Character
            if t:IsA("Tool") and not autoFix.hooked[t] then
                autoFix.hooked[t] = true
                t.AncestryChanged:Connect(function(_, parent)
                    if parent ~= p.Character or os.clock() < (autoFix.equipWindow or 0) then return end
                    local ge = WEAPONS.tool(t)
                    if ge and ge.kind == "equip" and not autoFix.equipDone[t.Name] then
                        autoFix.equipDone[t.Name] = true
                        autoFix.equipHow[t.Name] = "you"
                        afLog(t.Name, "moved into your hands without the script: counted as equipped by you")
                    end
                end)
                t.Activated:Connect(function()
                    LastCombat = os.clock()
                    -- your own shots teach the aim the real projectile speed too (macro shots are logged by the macro itself)
                    if Engine.run == nil then
                        local wk = Projectile.weaponOf(t)
                        if wk then registerShot(wk) end
                    end
                end)
            end
        end
        local function hookCombat(char)
            task.spawn(function()
                local hum = char:WaitForChild("Humanoid", 8)
                if hum then
                    local last = hum.Health
                    hum.HealthChanged:Connect(function(h)
                        if h < last then LastCombat = os.clock() end
                        last = h
                    end)
                end
            end)
            for _, t in ipairs(char:GetChildren()) do autoFix.hookTool(t) end
            char.ChildAdded:Connect(autoFix.hookTool)
        end
        if p.Character then hookCombat(p.Character) end
        p.CharacterAdded:Connect(hookCombat)
        -- the Backpack is destroyed and recreated on every respawn, so each new one is hooked
        autoFix.hookBackpack = function(bpack)
            -- a tool just appeared in your backpack (bought, found, given): re-plan and check again right away
            bpack.ChildAdded:Connect(function(t)
                if not t:IsA("Tool") then return end
                autoFix.nextClosed = 0
                autoFix.cool = 0
                autoFix.closedCycles = 0
                autoFix.badStreak = 1
                autoFix.relaxUntil = os.clock() + 20
            end)
            for _, t in ipairs(bpack:GetChildren()) do autoFix.hookTool(t) end
            bpack.ChildAdded:Connect(autoFix.hookTool)
        end
        if p:FindFirstChildOfClass("Backpack") then autoFix.hookBackpack(p:FindFirstChildOfClass("Backpack")) end
        p.ChildAdded:Connect(function(c) if c:IsA("Backpack") then autoFix.hookBackpack(c) end end)

        p.CharacterAdded:Connect(function()
            autoFix.equipDone = {}
            autoFix.equipHow = {}
            autoFix.equipTries = {}
            autoFix.spawnAt = os.clock()
            task.spawn(respawnEquip)
            autoFix.cool = 0
            autoFix.closedCycles = 0
            autoFix.badStreak = 1
            autoFix.nextClosed = os.clock() + 5
            autoFix.relaxUntil = os.clock() + 30
        end)

        -- Calm looping tone for as long as the backpack is open. Its volume swells and dips with
        -- the SAME pulse as the glow, so the sound and the flashing slots breathe together.
        -- Fades in when the backpack opens, fades out when it closes. Respects the "Sounds" switch.
        local INV_VOLUME = 0.25 -- loudest point of each pulse; lower = quieter, higher = louder
        local INV_FLOOR = 0.15  -- how quiet it gets between pulses (0 = fully silent, 1 = no pulsing)
        local invLoop, invGain, invWant, invLoading = nil, 0, false, false

        local function stopInventoryLoop()
            invWant = false -- updateInventoryLoop fades it out and cleans it up
        end

        local function startInventoryLoop()
            if not SoundsEnabled then return end
            if invLoop then invWant = true return end -- still fading out from before: just bring it back
            if invLoading then return end
            invLoading = true
            task.spawn(function()
                local id = loadSoundAsset("invhum")
                invLoading = false
                if not id or invLoop or not autoOpen then return end -- it may have closed while loading
                pcall(function()
                    local s = Instance.new("Sound")
                    s.Name = "ExoticaInventoryAmbience"
                    s.SoundId = id
                    s.Looped = true
                    s.Volume = 0
                    s.Parent = SoundService
                    s:Play()
                    invGain, invWant, invLoop = 0, true, s
                end)
            end)
        end

        -- runs every frame: fade in/out + follow the glow's pulse
        local function updateInventoryLoop(dt, now)
            local s = invLoop
            if not s then return end
            if invWant then
                invGain = math.min(1, invGain + dt / 2.0)   -- ~2s fade in
            else
                invGain = math.max(0, invGain - dt / 0.6)   -- ~0.6s fade out
                if invGain <= 0.001 then
                    invLoop = nil
                    pcall(function() s:Destroy() end)
                    return
                end
            end
            local pulse = 0.5 + 0.5 * math.sin(now * 4.5)   -- identical to the glow's pulse
            pcall(function() s.Volume = INV_VOLUME * invGain * (INV_FLOOR + (1 - INV_FLOOR) * pulse) end)
        end

        local expiry, pinned, alpha, nextCheck, nextResolve, nextWatch, nextIdleScan, nextGuiScan = 0, false, 0, 0, 0, 0, 0, 0
        -- true when something is out of place (re-reads your hotbar first); nil if it can't tell yet
        function slotGlow.anythingToFix()
            if #PLAN.allTools == 0 then pcall(scanInventory) end
            if #PLAN.allTools == 0 then return nil end
            rescanAll()
            for _, g in ipairs(glows) do
                if needsFix(g) then return true end
            end
            return (brassNeeded() or planEvict() ~= nil or planEquipEvict() ~= nil)
        end
        -- which hotbar slot a named weapon is in right now (nil if it isn't on the hotbar)
        function slotGlow.slotOfName(name)
            for _, tool in ipairs(PLAN.allTools) do
                if tool.Name == name then
                    for pos, c in pairs(hotCellsByPos) do
                        if c.Parent and cellMatchesTool(c, tool) then return pos end
                    end
                end
            end
            return nil
        end

        -- the Tool currently shown in hotbar slot `pos` (1..10, 10 = key 0), read live from that cell
        function slotGlow.toolAtSlot(pos)
            local cell = hotCellsByPos[pos]
            if not (cell and cell.Parent) then return nil end
            local best, bestLen = nil, -1
            local function consider(t)
                if t:IsA("Tool") and cellMatchesTool(cell, t) then
                    local len = #nz(t.Name) -- longest name wins ("Golden Snowball Launcher" over "Snowball Launcher")
                    if len > bestLen then best, bestLen = t, len end
                end
            end
            local bp = p:FindFirstChildOfClass("Backpack")
            if bp then for _, t in ipairs(bp:GetChildren()) do consider(t) end end
            if p.Character then for _, t in ipairs(p.Character:GetChildren()) do consider(t) end end
            return best
        end
        -- true = handled by EquipTool (no key needed); false = caller sends the real key
        Engine.equipSlot = function(pos)
            local ch = p.Character
            local hum = ch and ch:FindFirstChildOfClass("Humanoid")
            if not hum or hum.Health <= 0 then return false end
            local tool = slotGlow.toolAtSlot(pos)
            if not tool then return false end
            if tool.Parent ~= ch then hum:EquipTool(tool) end -- already in hand: stays in hand (a key press would have unequipped it)
            return true
        end
        function slotGlow.refreshSlots()
            pcall(scanInventory)
            pcall(resolveSlotFrames)
        end
        -- your weapons, for the custom macro builder: { name, kind, slot }
        function slotGlow.ownedWeapons()
            local out = {}
            for _, t in ipairs(PLAN.owned) do
                local e = WEAPONS.tool(t)
                if e and (e.kind == "rpg" or e.kind == "taser" or e.kind == "dps" or e.kind == "acc" or e.kind == "fixed" or e.kind == "loveboard"
                    or (e.kind == "nohotbar" and e.macroKey)) then
                    out[#out + 1] = { name = t.Name, kind = e.kind, slot = slotGlow.slotOfName(t.Name) }
                end
            end
            table.sort(out, function(a, b) return a.name:lower() < b.name:lower() end)
            return out
        end
        function slotGlow.requestFixNow()
            autoFix.forceUntil = os.clock() + 40
            autoFix.nextClosed = 0
            autoFix.cool = 0
            autoFix.badStreak = 1
        end
        -- what the notices use: which required weapons you're missing, and which of your picks are low grade
        function slotGlow.comboReport()
            local rep = { ready = false, missing = {}, low = {} }
            if #PLAN.allTools == 0 then return rep end
            rep.ready = true
            local need = {
                { "1", "a Taser (slot 1)", true }, { "4", "a high-DPS weapon for slot 4", true },
                { "5", "an RPG (slot 5)", true }, { "8", "your Fist with knuckles, or a high-DPS weapon (slot 8)", true },
                { "0", "a high-DPS weapon for slot 0", true },
                { "6", "the Loveboard (slot 6)", false }, { "7", "the Golden Snowball Launcher (slot 7)", false },
                { "9", "the Snowball Launcher (slot 9)", false },
            }
            for _, n in ipairs(need) do
                local have
                if n[3] then have = PLAN.slotTool[n[1]] ~= nil else have = expected[n[1]] and expected[n[1]].found end
                if not have then rep.missing[#rep.missing + 1] = n[2] end
            end
            local hasKnuckle = false
            for _, t in ipairs(PLAN.equipAll) do
                local e = WEAPONS.tool(t)
                if e and e.group == "knuckle" then hasKnuckle = true end
            end
            for _, slot in ipairs({ "4", "8", "0" }) do
                local t = PLAN.slotTool[slot]
                local e = t and WEAPONS.tool(t)
                if e and e.kind == "dps" and e.tier <= 50 then
                    rep.low[#rep.low + 1] = t.Name
                elseif e and e.kind == "fist" and not hasKnuckle then
                    rep.low[#rep.low + 1] = "Fist without knuckles"
                end
            end
            return rep
        end
        function slotGlow.flash(seconds) expiry = math.max(expiry, clock() + seconds) end
        function slotGlow.pin(on) pinned = on end

        slotGlow.conn = RunService.RenderStepped:Connect(function(dt)
            if not isCurrentInstance() then -- an older copy of the script: stop its loop (autoFixTick, glow, hum)
                slotGlow.conn:Disconnect()
                if invLoop then pcall(function() invLoop:Destroy() end) invLoop = nil end
                return
            end
            local now = clock()
            if now >= nextWatch then -- cheap: is the backpack/inventory open right now?
                nextWatch = now + 0.25
                local open = false
                if invWatchDefault and invWatchDefault.Parent and chainShown(invWatchDefault) then open = true end
                if invWatchGrid and invWatchGrid.Parent and chainShown(invWatchGrid) then open = true end
                if open ~= autoOpen then
                    autoOpen = open
                    if open then
                        if not autoFix.silent then startInventoryLoop() end
                    else
                        stopInventoryLoop()
                    end
                end
                if invLoop and not SoundsEnabled then stopInventoryLoop() end
            end
            do
                local ok1, e1 = pcall(updateInventoryLoop, dt, now)
                local ok2, e2 = pcall(autoFixTick, now)
                if (not ok1 or not ok2) and not autoFix.tickWarned then
                    autoFix.tickWarned = true
                    warn("[Exotica] Slot loop error: " .. tostring(ok1 and e2 or e1))
                    pcall(ConfigStore.reportBug, "slotloop", ok1 and e2 or e1)
                end
            end
            local flashing = false
            for _, g in ipairs(glows) do
                if (g.flashUntil or 0) > now then flashing = true break end
            end
            AssistSettings.LockPause = (autoOpen or autoFix.busy or SynthDragging) and true or false -- Lock On stays off the cursor while the backpack is in use
            -- hotbar "out of balance" cue: with the backpack closed, slots that hold the wrong weapon pulse amber
            if autoOpen or pinned then
                slotGlow.unbal, slotGlow.unbalCount = false, 0
            elseif now >= (slotGlow.nextUnbal or 0) then
                slotGlow.nextUnbal = now + 1
                local any = false
                if AutoFixEnabled and os.clock() - LastCombat > 3 and not autoFix.busy then
                    pcall(scanInventory)
                    for _, g in ipairs(glows) do
                        pcall(checkSlot, g)
                        if needsFix(g) then any = true end
                    end
                end
                slotGlow.unbalCount = any and ((slotGlow.unbalCount or 0) + 1) or 0
                slotGlow.unbal = slotGlow.unbalCount >= 3 -- must persist a few seconds so a swap in progress doesn't flicker it
            end
            local want = pinned or now < expiry or autoOpen or flashing
            -- thin light that travels along the top of the hotbar while its weapons are out of order (a short green sweep when they get fixed)
            do
                local bar = slotGlow.bar
                if not bar then
                    bar = Instance.new("Frame")
                    bar.Name = "HotbarOrderBar"
                    bar.BackgroundColor3 = Color3.new(1, 1, 1)
                    bar.BorderSizePixel = 0
                    bar.ZIndex = 45
                    bar.Visible = false
                    corner(bar, 2)
                    local gr = Instance.new("UIGradient")
                    gr.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.35, 1),
                        NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(0.65, 1), NumberSequenceKeypoint.new(1, 1),
                    })
                    gr.Parent = bar
                    bar.Parent = sg
                    slotGlow.bar, slotGlow.barGrad = bar, gr
                end
                if slotGlow.unbal then
                    slotGlow.wasUnbal, slotGlow.okUntil = true, 0
                elseif slotGlow.wasUnbal and not autoOpen then
                    slotGlow.wasUnbal, slotGlow.okUntil = false, now + 1.6
                end
                local mode = slotGlow.unbal and "bad" or ((now < (slotGlow.okUntil or 0)) and "ok" or nil)
                local x1, x2, y1
                if mode and not autoOpen then
                    local o, sc = sg.AbsolutePosition, sg.AbsoluteSize
                    for _, g in ipairs(glows) do
                        local ps, sz = slotRect(g, o, sc)
                        if ps then
                            x1 = math.min(x1 or ps.X, ps.X)
                            x2 = math.max(x2 or ps.X + sz.X, ps.X + sz.X)
                            y1 = math.min(y1 or ps.Y, ps.Y)
                        end
                    end
                end
                if x1 and x2 > x1 then
                    bar.Visible = true
                    bar.Position = UDim2.fromOffset(x1, y1 - 9)
                    bar.Size = UDim2.fromOffset(x2 - x1, 4)
                    bar.BackgroundColor3 = (mode == "ok") and COLORS.green or COLORS.accent
                    slotGlow.barGrad.Offset = Vector2.new(((now * 0.9) % 1.6) - 0.8, 0)
                else
                    bar.Visible = false
                end
            end
            local flashOnly = flashing and not (pinned or now < expiry or autoOpen)
            if not want and alpha < 0.01 and now >= nextIdleScan then
                nextIdleScan = now + 2.5 -- idle: keep an eye out for the inventory so opening it can auto-show the glow
                pcall(resolveSlotFrames)
            end
            alpha = alpha + ((want and 1 or 0) - alpha) * math.min(1, dt * 10)
            if alpha < 0.01 then
                if layer.Visible then layer.Visible = false end
                return
            end
            layer.Visible = true

            if clock() >= nextCheck then
                nextCheck = clock() + 0.25
                if clock() >= nextResolve then
                    nextResolve = clock() + 1.5
                    pcall(resolveSlotFrames)
                end
                pcall(scanGlobalTools)
                if clock() >= nextGuiScan then
                    nextGuiScan = clock() + 3
                    pcall(scanGuiNames)
                end
                pcall(scanInventory)
                for _, g in ipairs(glows) do pcall(checkSlot, g) end
            end

            local origin, screen = sg.AbsolutePosition, sg.AbsoluteSize
            local pulse = 0.5 + 0.5 * math.sin(clock() * 4.5)
            for _, g in ipairs(glows) do
                local pos, size = slotRect(g, origin, screen)
                local isFlash = (g.flashUntil or 0) > now
                if flashOnly and not isFlash then pos = nil end -- only the slots it just fixed light up
                g.box.Visible = pos ~= nil
                g.tag.Visible = pos ~= nil
                if not pos then continue end
                g.box.Position = UDim2.fromOffset(pos.X, pos.Y)
                g.box.Size = UDim2.fromOffset(size.X, size.Y)
                if isFlash then -- "just moved here": a faster, brighter green pulse
                    local fp = 0.5 + 0.5 * math.sin(clock() * 14)
                    g.box.BackgroundTransparency = 1 - alpha * (0.30 + 0.40 * fp)
                    g.edge.Transparency = 1 - alpha * (0.8 + 0.2 * fp)
                    g.haloEdge.Transparency = 1 - alpha * (0.5 + 0.5 * fp)
                else
                    g.box.BackgroundTransparency = 1 - alpha * (0.08 + 0.12 * pulse)
                    g.edge.Transparency = 1 - alpha * (0.6 + 0.4 * pulse)
                    g.haloEdge.Transparency = 1 - alpha * (0.2 + 0.35 * pulse)
                end
                -- stagger tags (alternating heights) so neighbouring slots don't overlap
                local lift = (g.pos % 2 == 0) and 8 or 26
                g.tag.Position = UDim2.fromOffset(pos.X + size.X / 2, pos.Y - lift)
                g.tag.BackgroundTransparency = 1 - alpha * 0.7
                g.tag.TextTransparency = 1 - alpha
            end
        end)
    end, function(err)
        warn("[Exotica] slot features failed to start:", tostring(err))
        task.delay(4, function() pcall(ConfigStore.reportBug, "slots", err) end) -- after the menu is up, so the banner can show
    end)


    -- opens the slot panel beside the main panel (flips to the left if there's no room)
    local function openInfo()
        local screen = sg.AbsoluteSize
        local h = math.min(infoContentH + 64, screen.Y * 0.85)
        info.Size = UDim2.new(0, INFO_W, 0, h)
        local px, py = main.Position.X, main.Position.Y
        local fitsRight = (main.AbsolutePosition.X + PANEL_W + 10 + INFO_W) <= screen.X
        local xOff = fitsRight and (px.Offset + PANEL_W + 10) or (px.Offset - INFO_W - 10)
        info.Position = UDim2.new(px.Scale, xOff, py.Scale, py.Offset)
        if not infoCtrl.open then infoCtrl.show() end
        slotGlow.pin(true)
    end

    -- opens the weapon-tier panel beside the main panel, the same way
    local function openTiers()
        if UI2.hideTargets then UI2.hideTargets() end -- the target list and the side panels share the same spot
        local screen = sg.AbsoluteSize
        local h = math.min(tiersContentH + 64, screen.Y * 0.85)
        tiers.Size = UDim2.new(0, TIER_W, 0, h)
        local px, py = main.Position.X, main.Position.Y
        local fitsRight = (main.AbsolutePosition.X + PANEL_W + 10 + TIER_W) <= screen.X
        local xOff = fitsRight and (px.Offset + PANEL_W + 10) or (px.Offset - TIER_W - 10)
        tiers.Position = UDim2.new(px.Scale, xOff, py.Scale, py.Offset)
        if infoCtrl.open then infoCtrl.hide() slotGlow.pin(false) end -- one side panel at a time
        if UI2.guide.ctrl.open then UI2.guide.ctrl.hide() end
        if OSB.ctrl.open then OSB.ctrl.hide() end
        if UI2.custom and UI2.custom.ctrl.open then UI2.custom.ctrl.hide() end
        if not tiersCtrl.open then tiersCtrl.show() end
    end

