            xmark = function()
                part(2, 9, -7, -7, -45) part(2, 9, 7, 7, -45) part(2, 9, 7, -7, 45) part(2, 9, -7, 7, 45)
            end,
            none = function() end, -- nothing to see; a faint ring appears only while you are placing it
        }
        local function buildStyle(style)
            for _, f in ipairs(parts.live) do f:Destroy() end
            parts.live, parts.fills, parts.strokes, parts.ghost = {}, {}, {}, nil
            local fn = BUILD[style] or BUILD.classic
            fn()
            if style == "none" then
                local g = ringPart(26, 1, 0.45)
                g.Visible = false
                parts.ghost = g
            end
        end
