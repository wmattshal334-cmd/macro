local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, 64 do B64_LOOKUP[B64_CHARS:sub(i, i)] = i - 1 end

local function b64decode(data)
    data = data:gsub("[^%w%+/=]", "")
    local out, n = {}, 0
    for i = 1, #data, 4 do
        local c1, c2, c3, c4 = data:sub(i, i), data:sub(i + 1, i + 1), data:sub(i + 2, i + 2), data:sub(i + 3, i + 3)
        local a, b = B64_LOOKUP[c1], B64_LOOKUP[c2]
        local c, d = B64_LOOKUP[c3], B64_LOOKUP[c4]
        if not (a and b) then break end
        local v = a * 262144 + b * 4096 + (c or 0) * 64 + (d or 0)
        n = n + 1
        if c3 == "=" or not c then
            out[n] = string.char(math.floor(v / 65536))
        elseif c4 == "=" or not d then
            out[n] = string.char(math.floor(v / 65536), math.floor(v / 256) % 256)
        else
            out[n] = string.char(math.floor(v / 65536), math.floor(v / 256) % 256, v % 256)
        end
    end
    return table.concat(out)
end

local soundAssets = {}
local function loadSoundAsset(key)
    if soundAssets[key] ~= nil then return soundAssets[key] or nil end
    local asset = nil
    pcall(function()
        local getAsset = getcustomasset or getsynasset
        local info = SOUND_DATA[key]
        if not (getAsset and writefile and readfile and isfile and info) then return end
        local path = "Exotica_" .. key .. "." .. (info.ext or "mp3")
        local okSize = false
        if isfile(path) then
            local existing = readfile(path)
            okSize = existing ~= nil and #existing == info.size
        end
        if not okSize then
            writefile(path, b64decode(info.data))
        end
        asset = getAsset(path)
    end)
    soundAssets[key] = asset or false
    return asset
end

-- plays one sound; after maxLen seconds it fades out and cleans itself up
local function playSound(id, volume, speed, maxLen)
    if not isCurrentInstance() then return end -- an older copy of the script must not play sounds too
    pcall(function()
        local s = Instance.new("Sound")
        s.SoundId = id
        s.Volume = volume or 0.6
        s.PlaybackSpeed = speed or 1
        s.Parent = SoundService
        s:Play()
        task.delay(maxLen or 10, function()
            pcall(function() TweenService:Create(s, TweenInfo.new(0.12), { Volume = 0 }):Play() end)
            task.delay(0.15, function() s:Destroy() end)
        end)
    end)
end

-- plays one of the embedded sounds. Already-loaded sounds play instantly; the first
-- time, it loads (decode + write the file) and then plays.
local function playEmbedded(key, volume, speed, maxLen, force)
    if not SoundsEnabled and not force then return end
    local asset = soundAssets[key]
    if asset ~= nil then
        local id = asset or (FALLBACK_KEYS[key] and FALLBACK_SOUND)
        if id then playSound(id, volume, speed, maxLen) end
        return
    end
    task.spawn(function()
        local id = loadSoundAsset(key) or (FALLBACK_KEYS[key] and FALLBACK_SOUND)
        if id then playSound(id, volume, speed, maxLen) end
    end)
end

-- load + preload everything in the background, startup sound first
task.spawn(function()
    for _, key in ipairs({ "startup", "panel", "click", "tick", "confirm", "warning", "popup", "slideout", "off", "deepclick", "cycle", "invhum", "combo", "reveal", "pop", "chime", "cancel", "menuopen", "hover", "loaded" }) do
        local id = loadSoundAsset(key)
        if id then
            pcall(function()
                local s = Instance.new("Sound")
                s.SoundId = id
                ContentProvider:PreloadAsync({ s })
                s:Destroy()
            end)
        end
    end
end)

local function playStartupChime()
    playEmbedded("startup", 0.7, 1, nil, true)
end

local COLORS = {
    glass = Color3.fromRGB(28, 30, 40),
    white = Color3.fromRGB(255, 255, 255),
    subtext = Color3.fromRGB(200, 205, 220),
    muted = Color3.fromRGB(160, 166, 185),
    blue = Color3.fromRGB(10, 132, 255),
    accent = Color3.fromRGB(90, 180, 255),   -- light iOS blue: key text, values, weapons group
    accent2 = Color3.fromRGB(190, 130, 255), -- violet: combo slots group
    warn = Color3.fromRGB(255, 190, 70),     -- amber: slot warning
    green = Color3.fromRGB(48, 209, 88),
    red = Color3.fromRGB(255, 95, 87),
    gray = Color3.fromRGB(120, 120, 130),
}

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = obj
    return c
end

local function stroke(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Transparency = transparency
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- bright glass edge on the top-left, fading toward the bottom-right
local function edgeGradient(strokeObj)
    local g = Instance.new("UIGradient")
    g.Rotation = 125
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.45, 0.7),
        NumberSequenceKeypoint.new(1, 0.9),
    })
    g.Parent = strokeObj
    return g
end

-- Frosted glass card: translucent dark base, a soft sheen on its own layer (a gradient
-- on the card itself would also fade the text), and a gradient edge highlight.
local function makeGlass(parent, radius)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = COLORS.glass
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Parent = parent
    corner(frame, radius)

    local sheenFrame = Instance.new("Frame")
    sheenFrame.Name = "Sheen"
    sheenFrame.Size = UDim2.new(1, 0, 1, 0)
    sheenFrame.BackgroundColor3 = COLORS.white
    sheenFrame.BorderSizePixel = 0
    sheenFrame.Parent = frame
    corner(sheenFrame, radius)
    local sheen = Instance.new("UIGradient")
    sheen.Rotation = 115
    sheen.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 160, 190)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 75, 100)),
    })
    sheen.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.82),
        NumberSequenceKeypoint.new(0.5, 0.92),
        NumberSequenceKeypoint.new(1, 0.85),
    })
    sheen.Parent = sheenFrame

    edgeGradient(stroke(frame, COLORS.white, 0.55, 1.25))
    return frame
end

-- Per-element fade (no CanvasGroup, so nothing gets dimmed). Build it AFTER the card's
-- contents exist: it remembers every element's normal transparency and can fade to/from it.
local function makeFader(root)
    local list = {}
    local function add(inst, prop)
        table.insert(list, { inst = inst, prop = prop, orig = inst[prop] })
    end
    local function collect(inst)
        if inst:IsA("GuiObject") then
            add(inst, "BackgroundTransparency")
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                add(inst, "TextTransparency")
            end
            if inst:IsA("ScrollingFrame") then
                add(inst, "ScrollBarImageTransparency")
            end
        elseif inst:IsA("UIStroke") then
            add(inst, "Transparency")
        end
    end
    collect(root)
    for _, d in ipairs(root:GetDescendants()) do collect(d) end

    local fader = {}
    function fader.hideNow()
        for _, it in ipairs(list) do it.inst[it.prop] = 1 end
    end
    function fader.set(visible, time)
        local last
        for _, it in ipairs(list) do
            last = tween(it.inst, { [it.prop] = visible and it.orig or 1 }, time)
        end
        return last
    end
    return fader
end

-- Show/hide controller for a card: fade + gentle scale, safe against rapid toggling.
local function makePanelController(frame, uiScale, fader)
    local ctrl = { open = false }
    local token = 0
    frame.Visible = false
    fader.hideNow()

    function ctrl.show(silent)
        token += 1
        ctrl.open = true
        frame.Visible = true
        uiScale.Scale = 0.92
        fader.set(true, 0.4)
        tween(uiScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
        if not silent then playEmbedded("panel", 0.8, 1, 1) end
    end
    function ctrl.hide(silent)
        if not ctrl.open then return end
        token += 1
        local mine = token
        ctrl.open = false
        if not silent then playEmbedded("panel", 0.8, 0.82, 1) end
        fader.set(false, 0.25)
        tween(uiScale, { Scale = 0.94 }, 0.25)
        task.delay(0.27, function()
            if token == mine then frame.Visible = false end
        end)
    end
    function ctrl.toggle()
        if ctrl.open then ctrl.hide() else ctrl.show() end
    end
    return ctrl
end

local function makeDraggable(handle, target)
    local state = { moved = false }
    local dragging, dragStart, startPos, dragInput = false, nil, nil, nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, state.moved = true, false
            dragInput = input
            dragStart, startPos = input.Position, target.Position
            local conn
            conn = input.Changed:Connect(function()
                local st = input.UserInputState
                if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
                    if dragInput == input then dragging = false end
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        local isMine = (input == dragInput)
            or (dragInput and dragInput.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)
        if isMine then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then state.moved = true end
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return state
end

local function newLabel(parent, props)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Font = Enum.Font.Gotham
    l.TextColor3 = COLORS.white
    l.TextSize = 12
    for k, v in pairs(props) do l[k] = v end
    l.Parent = parent
    return l
end

-- soft tick every ~40px of scrolling, only while the panel is on screen
local function hookScrollSound(sf, root)
    local lastY = sf.CanvasPosition.Y
    local lastTime = 0
    sf:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
        local y = sf.CanvasPosition.Y
        if root.Visible and math.abs(y - lastY) >= 40 and (clock() - lastTime) > 0.05 then
            lastY = y
            lastTime = clock()
            playEmbedded("tick", 0.45, 0.95 + math.random() * 0.15, 0.6)
        end
    end)
end

