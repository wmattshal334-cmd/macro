local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = obj
    return c
end

local function stroke(parent, color, transparency, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Transparency = transparency
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

local function tween(obj, props, time, style, dir)
    local t = TweenService:Create(obj, TweenInfo.new(time or 0.3, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

-- bright glass edge on the top-left, fading toward the bottom-right
local function edgeGradient(strokeObj)
    local g = Instance.new("UIGradient")
    g.Rotation = 125
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.45, 0.7),
        NumberSequenceKeypoint.new(1, 0.9),
    })
    g.Parent = strokeObj
    return g
end

-- Frosted glass card: translucent dark base, a soft sheen on its own layer (a gradient
-- on the card itself would also fade the text), and a gradient edge highlight.
local function makeGlass(parent, radius)
    local frame = Instance.new("Frame")
    frame.BackgroundColor3 = COLORS.glass
    frame.BackgroundTransparency = 0.15
    frame.BorderSizePixel = 0
    frame.Parent = parent
    corner(frame, radius)

    local sheenFrame = Instance.new("Frame")
    sheenFrame.Name = "Sheen"
    sheenFrame.Size = UDim2.new(1, 0, 1, 0)
    sheenFrame.BackgroundColor3 = COLORS.white
    sheenFrame.BorderSizePixel = 0
    sheenFrame.Parent = frame
    corner(sheenFrame, radius)
    local sheen = Instance.new("UIGradient")
    sheen.Rotation = 115
    sheen.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(150, 160, 190)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(70, 75, 100)),
    })
    sheen.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.82),
        NumberSequenceKeypoint.new(0.5, 0.92),
        NumberSequenceKeypoint.new(1, 0.85),
    })
    sheen.Parent = sheenFrame

    edgeGradient(stroke(frame, COLORS.white, 0.55, 1.25))
    return frame
end

-- Per-element fade (no CanvasGroup, so nothing gets dimmed). Build it AFTER the card's
-- contents exist: it remembers every element's normal transparency and can fade to/from it.
local function makeFader(root)
    local list = {}
    local function add(inst, prop)
        table.insert(list, { inst = inst, prop = prop, orig = inst[prop] })
    end
    local function collect(inst)
        if inst:IsA("GuiObject") then
            add(inst, "BackgroundTransparency")
            if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
                add(inst, "TextTransparency")
            end
            if inst:IsA("ScrollingFrame") then
                add(inst, "ScrollBarImageTransparency")
            end
        elseif inst:IsA("UIStroke") then
            add(inst, "Transparency")
        end
    end
    collect(root)
    for _, d in ipairs(root:GetDescendants()) do collect(d) end

    local fader = {}
    function fader.hideNow()
        for _, it in ipairs(list) do it.inst[it.prop] = 1 end
    end
    function fader.set(visible, time)
        local last
        for _, it in ipairs(list) do
            last = tween(it.inst, { [it.prop] = visible and it.orig or 1 }, time)
        end
        return last
    end
    return fader
end

-- Show/hide controller for a card: fade + gentle scale, safe against rapid toggling.
local function makePanelController(frame, uiScale, fader)
    local ctrl = { open = false }
    local token = 0
    frame.Visible = false
    fader.hideNow()

    function ctrl.show(silent)
        token += 1
        ctrl.open = true
        frame.Visible = true
        uiScale.Scale = 0.92
        fader.set(true, 0.4)
        tween(uiScale, { Scale = 1 }, 0.5, Enum.EasingStyle.Back)
        if not silent then playEmbedded("panel", 0.8, 1, 1) end
    end
    function ctrl.hide(silent)
        if not ctrl.open then return end
        token += 1
        local mine = token
        ctrl.open = false
        if not silent then playEmbedded("panel", 0.8, 0.82, 1) end
        fader.set(false, 0.25)
        tween(uiScale, { Scale = 0.94 }, 0.25)
        task.delay(0.27, function()
            if token == mine then frame.Visible = false end
        end)
    end
    function ctrl.toggle()
        if ctrl.open then ctrl.hide() else ctrl.show() end
    end
    return ctrl
end

local function makeDraggable(handle, target)
    local state = { moved = false }
    local dragging, dragStart, startPos = false, nil, nil

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, state.moved = true, false
            dragStart, startPos = input.Position, target.Position
            local conn
            conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if conn then conn:Disconnect() end
                end
            end)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 5 then state.moved = true end
            target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    return state
end

