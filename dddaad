        local function rowIn(item, delay, dx, mine)
            for _, it in ipairs(item.list) do it.inst[it.prop] = 1 end
            item.frame.Position = UDim2.new(0, dx, 0, item.y)
            task.delay(delay, function()
                if mine ~= S.tok then return end
                for _, it in ipairs(item.list) do tween(it.inst, { [it.prop] = it.orig }, 0.35) end
                tween(item.frame, { Position = UDim2.new(0, 0, 0, item.y) }, 0.55, Enum.EasingStyle.Back)
            end)
        end

