        render = function()
            capture = nil -- a pending "press a key" must not outlive the screen it was asked on
            CM.armed, CM.delArmed, CM.nameBox = false, nil, nil
            local changed = CM.lastPage ~= CM.page
            if changed then
                CM.lastPage = CM.page
                body.CanvasPosition = Vector2.new(0, 0)
            end
            for _, c in ipairs(body:GetChildren()) do c:Destroy() end
            local pg = CM.page
            if pg == "build" and CM.draft then renderBuild()
            elseif pg == "add" and CM.draft then renderAdd()
            elseif pg == "pick" and CM.draft then renderPick()
            elseif pg == "key" and CM.draft then renderKey()
            elseif pg == "templates" then renderTemplates()
            else
                CM.page = "list"
                renderList()
            end
            if changed then -- a new page: its items slide in one after another
                local n = 0
                for _, c in ipairs(body:GetChildren()) do
                    if c:IsA("GuiObject") and n < 26 then
                        n = n + 1
                        local target = c.Position
                        c.Position = target + UDim2.new(0, 18, 0, 0)
                        task.delay(0.018 * n, function()
                            if c.Parent then tween(c, { Position = target }, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out) end
                        end)
                    end
                end
            end
        end
        CM.render = render

