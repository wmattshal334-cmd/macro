        local nameBox
        local function renderBuild()
            local d = CM.draft
            if os.clock() - (CM.lastRefresh or 0) > 3 then -- read the hotbar again so missing-weapon warnings are current
                CM.lastRefresh = os.clock()
                if slotGlow.refreshSlots then pcall(slotGlow.refreshSlots) end
            end
            local info = CM.analyze(d)
            local nSteps = #d.steps
            local loops = CM.loopsOf(d)
            local y = 0

            -- name
            mkLabel(body, "Name (tap the box to rename)", 0, y, ROW_W, 14, 10, COLORS.muted)
            y = y + 16
            local nb = Instance.new("TextBox")
            nb.Position = UDim2.new(0, 0, 0, y)
            nb.Size = UDim2.new(0, ROW_W, 0, 32)
