        Players.PlayerAdded:Connect(function() if ctrl.open then pcall(rebuild) end end)
    end

    -- put back the buttons you had last time; if you already placed some, start locked so taps work straight away
    OSB.load()
    for _, name in ipairs(OSB.order) do
        if OSB.saved[name] and OSB.saved[name].on then
