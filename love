ConfigStore.bugCode = function(kind, detail)
    local str = tostring(kind) .. "|" .. string.sub(tostring(detail), 1, 160)
    local h = 5381
    for i = 1, #str do h = (h * 33 + string.byte(str, i)) % 16777216 end
    return string.format("EX%s-%s-%06X", (string.gsub(SCRIPT_VERSION, "%.", "")), string.upper(string.sub(tostring(kind), 1, 3)), h)
end
