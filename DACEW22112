        CM.stepColor = function(st)
            if st.t == "weapon" or st.t == "slot" then return COLORS.blue
            elseif st.t == "wait" then return COLORS.warn
            elseif st.t == "key" then return COLORS.green
            elseif st.aim then return COLORS.accent2 end
            return COLORS.gray
        end
        CM.defColor = function(def) -- a steady colour per macro, picked from its name
            local pal = { COLORS.blue, COLORS.accent2, COLORS.green, COLORS.warn, COLORS.accent }
            local h = 0
            for i = 1, #def.name do h = (h * 31 + def.name:byte(i)) % 997 end
            return pal[h % #pal + 1]
        end
        local function describe(st)
            if st.t == "weapon" then return "🔫 Equip " .. st.name
            elseif st.t == "slot" then return "🔫 Hotbar slot " .. CM.keyLabel(KEYS[st.slot] or tostring(st.slot))
            elseif st.t == "key" then return "⌨ Press " .. CM.keyLabel(st.key)
            elseif st.t == "click" then return st.aim and "🎯 Aimed click" or "🖱 Click"
            else return "⏱ Wait" end
        end
