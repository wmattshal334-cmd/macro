            mkBtn(rr, "−", ROW_W - 120, 8, 28, 28, COLORS.gray, function()
                CM.edit(function() d.loops = math.max(1, loops - 1) end)
            end)
            newLabel(rr, { Size = UDim2.new(0, 40, 0, 28), Position = UDim2.new(0, ROW_W - 90, 0, 8), Font = Enum.Font.GothamBold,
                Text = loops .. "×", TextSize = 13, TextColor3 = COLORS.accent })
            mkBtn(rr, "+", ROW_W - 46, 8, 28, 28, COLORS.gray, function()
                CM.edit(function() d.loops = math.min(CM.LOOP_MAX, loops + 1) end)
            end)
            y = y + 50

            local kr = mkRow(y, 44)
            newLabel(kr, { Size = UDim2.new(0, 130, 0, 16), Position = UDim2.new(0, 10, 0, 6), Font = Enum.Font.GothamMedium,
                Text = "⌨ Start with a key", TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left })
            newLabel(kr, { Size = UDim2.new(0, 130, 0, 14), Position = UDim2.new(0, 10, 0, 24), Text = "needs a keyboard",
                TextSize = 9, TextColor3 = COLORS.muted, TextXAlignment = Enum.TextXAlignment.Left })
            local keyLabelText = d.key and ("Key: " .. CM.keyLabel(d.key)) or "Set key"
            local keyBtn
            keyBtn = mkBtn(kr, keyLabelText, ROW_W - 134, 8, d.key and 92 or 126, 28, COLORS.blue, function()
                if capture then -- tap again to cancel
                    capture = nil
                    keyBtn.Text = keyLabelText
