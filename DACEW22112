        CM.sync = function() -- copy the name box into the draft before anything redraws
            local nb = CM.nameBox
            if CM.draft and nb and nb.Parent then CM.draft.name = nb.Text end
        end
        CM.go = function(page)
            CM.sync()
            CM.page = page
