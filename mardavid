        cross.InputBegan:Connect(function(i)
            if not editing then return end
            local t = i.UserInputType
            if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.Touch then return end
            dragIn = i
            local conn
            conn = i.Changed:Connect(function()
                local s = i.UserInputState
                if s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel then
                    if dragIn == i then dragIn = nil end
                    conn:Disconnect()
                end
            end)
        end)
        UIS.InputChanged:Connect(function(i)
            if not dragIn then return end
            if i == dragIn or (dragIn.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement) then
                local cam = workspace.CurrentCamera
                if not cam then return end
                local ins = inset()
