            CM.render()
        end
        CM.addStep = function(step)
            CM.sync()
            local d = CM.draft
            if not d then return end
            if #d.steps >= CM.MAX_STEPS then
                say("Too many steps", "A macro can have up to " .. CM.MAX_STEPS .. " steps.")
                return
            end
            d.steps[#d.steps + 1] = step
            CM.dirty = true
            CM.focusStep = #d.steps -- the editor scrolls to the new step
            CM.page = "build"
            CM.render()
        end

