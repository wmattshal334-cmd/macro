    -- First-trigger slot warning (shown once, the first time any macro fires)
    local function showSlotWarning()
        showNotification({
            title = "Checking Your Slots",
            body = "Making sure everything is in order for you...",
            hint = "Tap for Slot Setup",
            onTap = openInfo,
            duration = 4,
            sounds = { "chime" },
        })
        slotGlow.flash(4)
        -- then do the check for real: all fine, or ask to fix what's out of place
        task.spawn(function()
            task.wait(1.4)
            local need = slotGlow.anythingToFix and slotGlow.anythingToFix()
            if need == nil then return end
            if need then
                slotGlow.promptFix()
            else
                pcall(showNotification, {
                    title = "All Set",
                    badge = "OK",
                    badgeSize = 12,
                    color = COLORS.green,
                    body = "Your slots are in order. You're good to go.",
                    hint = "Tap to dismiss",
                    duration = 3.5,
                    sounds = { "chime" },
                })
            end
        end)
    end

    -- Auto Slot Fix: tells you what it detected and moved (one banner for the whole batch, with a sound)
    autoFixNotify = function(moved, extra)
        local lines = {}
        local combo = #moved > 0
        for _, e in ipairs(extra or {}) do
            if e:find("^Moved ") then combo = true end
        end
        if combo then lines[1] = "The best combo has been selected for you." end
        for _, g in ipairs(moved) do
            local item = (g.label:gsub("^.-· ", ""))
            lines[#lines + 1] = "Detected " .. item .. " and moved it to slot " .. g.slot .. "."
        end
        for _, e in ipairs(extra or {}) do lines[#lines + 1] = e end
        showNotification({
            title = combo and "Best Combo Selected" or "Gear Equipped",
            badge = "OK",
            badgeSize = 12,
            color = COLORS.green,
            width = 330,
            duration = 7 + 1.5 * #lines,
            hint = "Auto Slot Fix",
            sounds = combo and { "combo" } or { "chime" },
            items = lines,
        })
    end

    -- shown when it tried and couldn't, with the reason (so you know what to tell me)
    autoFixFail = function(lines)
        showNotification({
            title = "Auto Slot Fix",
            badge = "!",
            color = COLORS.warn,
            width = 330,
            duration = 10,
            hint = "Couldn't finish",
            sounds = { "popup" },
            items = lines,
        })
    end

    -- quiet "working on it" banner shown when it opens your backpack by itself
    autoFixStatus = function(count, equipOnly)
        showNotification({
            title = "Auto Slot Fix",
            badge = "FIX",
            badgeSize = 11,
            color = COLORS.accent,
            width = 320,
            duration = 6,
            hint = "Working...",
            sounds = {},
            body = equipOnly and "Respawned. Opening your backpack to sort your gear."
                or ((count > 1)
                    and ("Detected " .. count .. " things to fix. Opening your backpack to sort them.")
                    or "Detected something to fix. Opening your backpack to sort it."),
            bodyHeight = 42,
        })
    end

    local lastMacroTime = -100 -- when a macro last fired (the update notice waits for a quiet moment)
    triggerMacro = function(name)
        if not Macros[name] then return end
        lastMacroTime = clock()
        LastCombat = os.clock()
        if not hasShownSlotWarning then
            hasShownSlotWarning = true
            pcall(showSlotWarning) -- a toast rendering issue must never block the macro from firing
        end
        Macros[name]()
    end

