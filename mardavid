    OSB.save = function()
        local data = {}
        for _, name in ipairs(OSB.order) do
            local b = OSB.buttons[name]
            local prev = OSB.saved[name] or {}
            data[name] = {
                on = b ~= nil,
                x = b and b.Position.X.Scale or prev.x,
                y = b and b.Position.Y.Scale or prev.y,
            }
        end
        OSB.saved = data
        AutoFixMemory.osb = data
        pcall(function()
            if writefile then writefile(OSB.file, game:GetService("HttpService"):JSONEncode(data)) end
        end)
    end
    OSB.load = function()
        local ok, data = pcall(function()
            if isfile and isfile(OSB.file) then return game:GetService("HttpService"):JSONDecode(readfile(OSB.file)) end
            return AutoFixMemory.osb
        end)
        if ok and type(data) == "table" then
            local clean = {}
            for _, name in ipairs(OSB.order) do
                local s = data[name]
                if type(s) == "table" then
                    clean[name] = {
                        on = s.on == true,
                        x = type(s.x) == "number" and math.clamp(s.x, 0, 1) or nil,
                        y = type(s.y) == "number" and math.clamp(s.y, 0, 1) or nil,
                    }
                end
            end
            OSB.saved = clean
        end
    end
    OSB.refresh = function()
        for name, b in pairs(OSB.buttons) do
            local st = b:FindFirstChildOfClass("UIStroke")
            if st then
                st.Color = OSB.editMode and COLORS.warn or OSB.spec[name].color
                st.Transparency = OSB.editMode and 0.05 or 0.3
            end
            local ic, lb = b:FindFirstChild("Icon"), b:FindFirstChild("Label")
            if ic then ic.Text = OSB.spec[name].icon end
            if lb then
                lb.Text = OSB.editMode and "Drag me" or OSB.spec[name].label
                lb.TextColor3 = OSB.editMode and COLORS.warn or COLORS.white
            end
        end
    end
    -- sizes the icon and the name to the button
    OSB.layout = function(b, px)
        local ic, lb = b:FindFirstChild("Icon"), b:FindFirstChild("Label")
        if ic then
            ic.TextSize = math.max(14, math.floor(px * 0.36 + 0.5))
            ic.Size, ic.Position = UDim2.new(1, 0, 0.46, 0), UDim2.new(0, 0, 0.14, 0)
        end
        if lb then
            lb.TextSize = math.max(8, math.floor(px / 68 * 11 + 0.5))
            lb.Size, lb.Position = UDim2.new(1, -6, 0.26, 0), UDim2.new(0, 3, 0.6, 0)
        end
    end
    OSB.fire = function(name, b)
        local sc = b:FindFirstChildOfClass("UIScale")
        if sc then
            sc.Scale = 0.88
            tween(sc, { Scale = 1 }, 0.18, Enum.EasingStyle.Back)
        end
        pcall(function() -- a ring that spreads out from the button, so a tap is seen to land
            local r = Instance.new("Frame")
            r.AnchorPoint = Vector2.new(0.5, 0.5)
            r.Position = UDim2.new(0.5, 0, 0.5, 0)
            r.Size = UDim2.new(1, 0, 1, 0)
            r.BackgroundTransparency = 1
            r.ZIndex = 59
            r.Parent = b
            corner(r, 999)
            local rs = stroke(r, OSB.spec[name].color, 0.15, 2)
            tween(r, { Size = UDim2.new(1.6, 0, 1.6, 0) }, 0.45)
            tween(rs, { Transparency = 1 }, 0.45)
            task.delay(0.5, function() r:Destroy() end)
        end)
        warn("[Exotica] screen button:", name)
        if triggerMacro then
            -- unaimed clicks of THIS run go to the middle of the screen, not to the button under your finger
            Engine.pending = Engine.center()
            local ok, err = pcall(triggerMacro, name)
            Engine.pending = nil -- startSequence has consumed it by now; never leave it for a keyboard macro
            if not ok then warn("[Exotica] screen button failed:", tostring(err)) end
        end
    end
    OSB.make = function(name)
        if OSB.buttons[name] then return end
        local spec, saved = OSB.spec[name], OSB.saved[name]
        local b = Instance.new("TextButton")
        b.Name = "OSB_" .. name
        local px = OSB.sizes[ConfigStore.osbSize or 2] or 68
        b.Size = UDim2.new(0, px, 0, px)
        b.AnchorPoint = Vector2.new(0.5, 0.5)
        b.Position = UDim2.new((saved and saved.x) or spec.dx, 0, (saved and saved.y) or spec.dy, 0)
        b.BackgroundColor3 = COLORS.glass
        b.BackgroundTransparency = 0.34
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Font = Enum.Font.GothamBold
        b.Text = "" -- the icon and the name are labels on top of the glass sheen
        b.ZIndex = 60
        b.Parent = sg
        corner(b, px // 2)
        stroke(b, spec.color, 0.3, 1.5)
        do -- the same frosted look as the panels: soft light across the top, a bright rim at the top-left
            local sheen = Instance.new("Frame")
            sheen.Name = "Sheen"
            sheen.Size = UDim2.new(1, 0, 1, 0)
            sheen.BackgroundColor3 = COLORS.pure
            sheen.BorderSizePixel = 0
            sheen.ZIndex = 60
            sheen.Parent = b
            corner(sheen, 999)
            local shine = Instance.new("UIGradient")
            shine.Rotation = 115
            shine.Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(0.5, 0.9), NumberSequenceKeypoint.new(1, 0.86),
            })
            shine.Parent = sheen
            edgeGradient(stroke(sheen, Color3.new(1, 1, 1), 0.5, 1))
            newLabel(b, { Name = "Icon", Font = Enum.Font.GothamBold, ZIndex = 62, Text = "" })
            newLabel(b, { Name = "Label", Font = Enum.Font.GothamBold, ZIndex = 62, Text = "", TextTruncate = Enum.TextTruncate.AtEnd })
            OSB.layout(b, px)
        end
        local sc = Instance.new("UIScale")
        sc.Parent = b
        OSB.buttons[name] = b
        -- A quick tap runs the macro. To move the button: press and hold for a moment, then drag (or turn Move mode on).
        local down, grabbed, moved, pressedAt, startMouse, startPos = false, false, false, 0, Vector2.new(), b.Position
        local myInput = nil -- the exact finger / mouse press that started on this button
        local function finished(inp)
            local s = inp.UserInputState
            return s == Enum.UserInputState.End or s == Enum.UserInputState.Cancel
        end
        b.InputBegan:Connect(function(i)
            local t = i.UserInputType
            if not (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) then return end
            -- a previous press that ended / was cancelled without us hearing about it must not block this one
            if down and myInput and myInput ~= i and finished(myInput) then
                down = false
                sc.Scale = 1
            end
            if down then return end
            myInput = i
            down, grabbed, moved = true, false, false
            pressedAt = os.clock()
            startMouse = Vector2.new(i.Position.X, i.Position.Y)
            startPos = b.Position
            local conn
            conn = i.Changed:Connect(function()
                if not finished(i) then return end
                conn:Disconnect()
                if myInput ~= i then return end -- a newer press already took over
                local cancelled = i.UserInputState == Enum.UserInputState.Cancel
                down = false
                sc.Scale = 1
                if grabbed then
                    OSB.save()
                    OSB.refresh()
                elseif not cancelled and not moved and not OSB.editMode and os.clock() - pressedAt < 1.2 then
                    OSB.fire(name, b)
                end
            end)
        end)
        local moveConn
        moveConn = game:GetService("UserInputService").InputChanged:Connect(function(i)
            if not b.Parent then moveConn:Disconnect() return end -- button was removed: drop this listener
            -- only the finger that pressed this button counts: a second finger on the movement stick must not cancel the tap
            local mine = down and myInput and (i == myInput
                or (myInput.UserInputType == Enum.UserInputType.MouseButton1 and i.UserInputType == Enum.UserInputType.MouseMovement))
            if mine then
                local d = Vector2.new(i.Position.X, i.Position.Y) - startMouse
                if d.Magnitude > 12 then
                    if OSB.editMode or (os.clock() - pressedAt) >= 0.3 then
                        if not grabbed then
                            grabbed = true
                            sc.Scale = 1.12
                            local st = b:FindFirstChildOfClass("UIStroke")
                            if st then st.Color = COLORS.warn st.Transparency = 0.05 end
                        end
                    else
                        moved = true -- swiped before the hold: not a tap, not a move
                    end
                end
                if grabbed then
                    local screen = sg.AbsoluteSize
                    local px = math.clamp(startPos.X.Scale * screen.X + d.X, 34, screen.X - 34)
                    local py = math.clamp(startPos.Y.Scale * screen.Y + d.Y, 34, screen.Y - 34)
                    b.Position = UDim2.new(px / screen.X, 0, py / screen.Y, 0)
                end
            end
        end)
        OSB.refresh()
    end
