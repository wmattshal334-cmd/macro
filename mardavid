        local SIZE_NAME = { "Small", "Medium", "Large" }
        -- a bar or dot, placed by its offset from the middle of the 46x46 frame; `fixed` = a colour that never changes
        local function part(w, h, ox, oy, rot, round, z, fixed)
            local f = Instance.new("Frame")
