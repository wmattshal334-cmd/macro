            if nSteps == 0 then
                mkLabel(body, "Nothing here yet. Tap Add step to start.", 0, y, ROW_W, 16, 11, COLORS.muted)
                y = y + 22
            end
            local focusY
            for i, st in ipairs(d.steps) do
                local row = mkRow(y, 40, CM.stepColor(st))
                if CM.focusStep == i then focusY = y end
