        local function rowIn(item, delay, dx, mine)
            for _, it in ipairs(item.list) do it.inst[it.prop] = 1 end
            item.frame.Position = UDim2.new(0, dx, 0, item.y)
            task.delay(delay, function()
                if mine ~= S.tok then return end
                for _, it in ipairs(item.list) do tween(it.inst, { [it.prop] = it.orig }, 0.35) end
                tween(item.frame, { Position = UDim2.new(0, 0, 0, item.y) }, 0.55, Enum.EasingStyle.Back)
            end)
        end

        -- the three keycaps on page 1 press themselves, one after another
        local function keyLoop(mine)
            task.spawn(function()
                task.wait(1.1)
                while mine == S.tok and ctrl.open and S.page == 1 do
                    for _, c in ipairs(S.caps) do
                        if mine ~= S.tok then return end
                        tween(c.cap, { Position = UDim2.new(0, c.x, 0, 3), BackgroundTransparency = 0.55 }, 0.09)
                        task.wait(0.16)
                        tween(c.cap, { Position = UDim2.new(0, c.x, 0, 0), BackgroundTransparency = 0.84 }, 0.3, Enum.EasingStyle.Back)
                        task.wait(0.55)
                    end
                    task.wait(1.2)
                end
            end)
        end
        -- a soft ring that spreads out from the page badge while the guide is open
        local function pulse(mine)
            task.spawn(function()
                task.wait(0.5)
                while mine == S.open and ctrl.open do
                    ring.Size = UDim2.fromOffset(46, 46)
                    ringStroke.Transparency = 0.45
                    tween(ring, { Size = UDim2.fromOffset(80, 80) }, 1.5, Enum.EasingStyle.Quad)
                    tween(ringStroke, { Transparency = 1 }, 1.5, Enum.EasingStyle.Quad)
                    task.wait(1.9)
                end
            end)
        end

        local function goTo(i, dir)
            i = math.clamp(i, 1, #PAGES)
            S.page = i
            S.tok += 1
            local mine = S.tok
            local pd = PAGES[i]
            for j, pg in ipairs(pages) do pg.frame.Visible = (j == i) end
            pages[i].frame.CanvasPosition = Vector2.new(0, 0)
            if i == 1 then
                for _, c in ipairs(S.caps) do
                    local cfg = Config[c.cfg]
                    c.cap.Text = (cfg and cfg.Key and cfg.Key.Name) or c.fallback
                end
            end
            for n, item in ipairs(pages[i].items) do
                rowIn(item, 0.08 + 0.08 * (n - 1), (dir < 0) and -30 or 30, mine)
            end
