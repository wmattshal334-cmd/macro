        local function paint()
            local col = editing and COLORS.warn or COLORS.accent
            for _, f in ipairs(parts.fills) do f.BackgroundColor3 = col end
            for _, s in ipairs(parts.strokes) do s.Color = col end
            if parts.ghost then parts.ghost.Visible = editing end
            cross.Active = editing
            tween(crossScale, { Scale = SIZE_SCALE[AssistSettings.CrossSize] * (editing and 1.25 or 1) }, 0.18)
