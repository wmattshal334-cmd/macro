            -- Test / Save / Cancel
            local testBtn
            testBtn = mkBtn(body, Engine.run and "Stop" or "Test", 0, y, 94, 32, COLORS.green, function()
                CM.sync()
                if Engine.run then stopEngine() testBtn.Text = "Test" return end
                if #d.steps == 0 then say("No steps", "Add a step first, then test it.") return end
                local snap = CM.copyDef(d) -- tests what's on screen, saved or not
                Macros["__CMTest"] = function() startSequence(buildEvents(snap)) end
                Engine.pending = Engine.center()
                pcall(triggerMacro, "__CMTest")
                Engine.pending = nil
                local run = Engine.run
                if run then
                    testBtn.Text = "Stop"
                    task.spawn(function()
                        while Engine.run == run and testBtn.Parent do task.wait(0.1) end
                        if testBtn.Parent then testBtn.Text = "Test" end
                    end)
                end
            end)
            mkBtn(body, "Save", 101, y, 94, 32, COLORS.blue, function()
                CM.sync()
                if #d.steps == 0 then say("No steps", "Add at least one step first.") return end
                local old = CM.editing and CM.defs[CM.editing]
                local name = CM.cleanName(d.name)
                if name == "" then name = "Macro " .. (#CM.defs + 1) end
                local def = CM.copyDef(d)
                def.loops = CM.loopsOf(d)
                def.name = CM.uniqueName(name, old)
                addDef(def)
                if def.name ~= name then say("Saved as " .. def.name, "That name was already taken.") end
                playEmbedded("chime", 0.7, 1, 1)
                CM.draft, CM.editing, CM.dirty, CM.page = nil, nil, false, "list"
                CM.render()
            end)
            local cancelBtn
            cancelBtn = mkBtn(body, "Cancel", 202, y, 94, 32, COLORS.gray, function()
                CM.sync()
                if CM.dirty and not CM.armed then -- unsaved changes: ask once
