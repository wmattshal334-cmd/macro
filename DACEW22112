        g.DisplayOrder = 10000
        g.Parent = core
        local t = Instance.new("TextLabel")
        t.Size = UDim2.new(0.9, 0, 0, 96)
        t.Position = UDim2.new(0.05, 0, 0.04, 0)
        t.BackgroundColor3 = Color3.fromRGB(120, 20, 20)
