        local photo = mk("ImageLabel", {
            AnchorPoint = C5, Position = UDim2.new(0.5, 0, 0.5, 0), Size = px(88), BackgroundColor3 = Color3.fromRGB(16, 22, 44),
            BackgroundTransparency = 1, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Crop, Image = "", ImageTransparency = 1, ZIndex = 2,
        }, avWrap)
        round(photo)
        local ringStroke = mk("UIStroke", { Thickness = 3, Color = WHITE, Transparency = 1 }, photo)
        local ringGrad = mk("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, PAL[1]), ColorSequenceKeypoint.new(0.35, PAL[3]),
                ColorSequenceKeypoint.new(0.7, PAL[4]), ColorSequenceKeypoint.new(1, PAL[1]),
            }),
        }, ringStroke)
        local initial = mk("TextLabel", { -- the first letter of your name, until the photo has loaded
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Font = Enum.Font.GothamBold,
            Text = string.upper(string.sub(p.DisplayName, 1, 1)), TextSize = 36, TextColor3 = WHITE, TextTransparency = 1, ZIndex = 3,
        }, photo)
        local photoLoaded = false
        task.spawn(function()
            local okT, img = pcall(function()
                return Players:GetUserThumbnailAsync(p.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size180x180)
            end)
            if okT and img and photo.Parent then
                photo.Image = img
                photoLoaded = true
            end
        end)

        -- texts
        local function lbl(text, y, size, font, color, w)
            return mk("TextLabel", {
                AnchorPoint = C5, Position = at(0, y), Size = px(w or 400, size + 8), BackgroundTransparency = 1, Font = font,
                Text = text, TextSize = size, TextColor3 = color, TextTransparency = 1, ZIndex = 6,
                TextTruncate = Enum.TextTruncate.AtEnd,
            }, stage)
        end
        local hello = lbl("W E L C O M E   B A C K", HELLO_Y, 11, Enum.Font.GothamMedium, Color3.fromRGB(150, 168, 210))
        local nameL = lbl(p.DisplayName, NAME_Y, 24, Enum.Font.GothamBold, Color3.fromRGB(244, 247, 255))
        local userL = lbl("@" .. p.Name, USER_Y, 12, Enum.Font.GothamMedium, Color3.fromRGB(122, 142, 188))
        local sc = UI2.stage.color
        local stageHex = string.format("rgb(%d,%d,%d)", math.floor(sc.R * 255 + 0.5), math.floor(sc.G * 255 + 0.5), math.floor(sc.B * 255 + 0.5))
        local sub = lbl("M A C R O S    ·    <font color=\"" .. stageHex .. "\">v" .. SCRIPT_VERSION .. " " .. string.upper(SCRIPT_STAGE) .. "</font>",
            SUB_Y, 11, Enum.Font.GothamBold, Color3.fromRGB(150, 168, 210))
        sub.RichText = true
        local status = lbl("Starting up", STAT_Y, 11, Enum.Font.GothamMedium, Color3.fromRGB(132, 150, 194))

        -- the wordmark, one label per letter so each can ignite on its own
        local WORD, FS, GAP = "EXOTICA", 46, 7
        local wmFont = Enum.Font.GothamBlack
        pcall(function() wmFont = Enum.Font.Michroma end)
        local letters, widths, totalW = {}, {}, 0
        for i = 1, #WORD do
            local w = FS * 0.8
            pcall(function() w = game:GetService("TextService"):GetTextSize(string.sub(WORD, i, i), FS, wmFont, Vector2.new(500, 200)).X end)
            widths[i] = w
            totalW = totalW + w
        end
        totalW = totalW + GAP * (#WORD - 1)
        local xcur = -totalW / 2
        for i = 1, #WORD do
            local w = widths[i]
            local lab = mk("TextLabel", {
                Name = "Letter" .. i, AnchorPoint = C5, Position = at(xcur + w / 2, WM_Y), Size = px(w + 12, FS + 14),
                BackgroundTransparency = 1, Font = wmFont, Text = string.sub(WORD, i, i), TextSize = FS,
                TextColor3 = GHOST, TextTransparency = 1, ZIndex = 7,
            }, stage)
            letters[i] = {
                lab = lab, sc = mk("UIScale", { Scale = 1 }, lab),
                st = mk("UIStroke", { Thickness = 2, Color = PAL[1], Transparency = 1 }, lab),
            }
            xcur = xcur + w + GAP
        end

        -- progress line with a bright head
        local BAR_W = 250
        local track = mk("Frame", { AnchorPoint = C5, Position = at(0, BAR_Y), Size = UDim2.fromOffset(BAR_W, 3), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 6 }, stage)
        round(track)
        local fill = mk("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 7 }, track)
        local ink = mk("Frame", { Size = UDim2.fromOffset(BAR_W, 3), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 7 }, fill)
        mk("UIGradient", {
            Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, PAL[1]), ColorSequenceKeypoint.new(0.55, PAL[3]), ColorSequenceKeypoint.new(1, PAL[4]) }),
        }, ink)
        local head = mk("Frame", { AnchorPoint = C5, Position = UDim2.new(0, 0, 0.5, 0), Size = px(16), BackgroundColor3 = PAL[1], BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 8 }, track)
        round(head)
        local headCore = mk("Frame", { AnchorPoint = C5, Position = UDim2.new(0.5, 0, 0.5, 0), Size = px(6), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9 }, head)
        round(headCore)

        -- sparkles drifting up
        local sparks = {}
        local function hash(i, k) return (math.sin(i * 12.9898 + k * 78.233) * 43758.5453) % 1 end
        for i = 1, 26 do
            local sz = 2 + (i % 3)
            local f = mk("Frame", {
                AnchorPoint = C5, Size = px(sz), BackgroundColor3 = pal(i / 26), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 2,
            }, overlay)
            round(f)
            sparks[i] = { f = f, x = hash(i, 1), y = hash(i, 2), v = 0.035 + hash(i, 3) * 0.06, ph = hash(i, 4) * 6.28, sw = 0.006 + hash(i, 5) * 0.012 }
        end

        -- the moment the swell arrives: a flash, two rings and a streak of light through the wordmark
        local flash = mk("Frame", { Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 20 }, overlay)
        local rings = {}
        for i = 1, 2 do
            local r = mk("Frame", {
                AnchorPoint = C5, Position = UDim2.new(0.5, 0, 0.5, WM_Y * fitScale), Size = px(10), BackgroundTransparency = 1,
                BorderSizePixel = 0, ZIndex = 10, Visible = false,
            }, overlay)
            round(r)
            rings[i] = { f = r, st = mk("UIStroke", { Thickness = 2, Color = (i == 1) and PAL[1] or PAL[4], Transparency = 1 }, r) }
        end
        local flare = mk("Frame", {
            AnchorPoint = C5, Position = UDim2.new(0.5, 0, 0.5, WM_Y * fitScale), Size = UDim2.fromOffset(0, 2), BackgroundColor3 = WHITE,
            BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 9, Visible = false,
        }, overlay)
        mk("UIGradient", { Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1),
        }) }, flare)
        local skipHint = mk("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(300, 16), BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium, Text = "Tap anywhere to skip", TextSize = 10, TextColor3 = Color3.fromRGB(150, 168, 210),
            TextTransparency = 1, ZIndex = 6,
        }, overlay)

        -- the startup track (the sound's own playback position is the clock of everything above)
        local snd, ours = nil, false
        do
            local id = soundAssets.startup
            if id == nil then id = loadSoundAsset("startup") end
            if id then ours = true else id = FALLBACK_SOUND end
            snd = playSound(id, 0.8, 1, CUE.length + 0.6)
        end
        local t0, lastPos, lastAdvance, audioBad = nil, 0, 0, not ours
        local function trackTime() -- seconds into the track
            local c = os.clock()
            local pos = 0
            if ours and snd and not audioBad then
                local okp, v = pcall(function() return snd.IsPlaying and snd.TimePosition or 0 end)
                pos = (okp and type(v) == "number") and v or 0
                if pos > lastPos + 0.0005 then lastPos, lastAdvance = pos, c end
            end
            if not t0 then
                if pos > 0.01 then
                    t0 = c - pos
                elseif c - created > 1 or audioBad then
                    t0 = c -- the track never started: the picture runs on its own
                    audioBad = true
                else
                    return 0
                end
            elseif pos > 0.01 and not audioBad then
                if c - lastAdvance < 0.25 then
                    if math.abs(pos - (c - t0)) > 0.12 then t0 = c - pos end -- the track is the truth
                elseif c - lastAdvance > 0.6 then
                    audioBad = true -- it stopped moving: trust the wall clock from here
                end
            end
            return c - t0
        end

        local function stopSound(fade)
            local s = snd
            if not s then return end
            snd = nil
            pcall(function()
                if fade then TweenService:Create(s, TweenInfo.new(fade), { Volume = 0 }):Play() end
                task.delay((fade or 0) + 0.05, function() pcall(function() s:Destroy() end) end)
            end)
        end
        local function callDone()
            if doneCalled then return end
            doneCalled = true
            done()
        end
        local function finish() -- always runs exactly once, so the menu can never get stuck behind the loader
            if finished then return end
            finished = true
            for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
            pcall(function() if blur then blur:Destroy() end end)
            pcall(function() overlay:Destroy() end)
            if skipped then stopSound(0.4) end
            callDone()
        end
        task.delay(CUE.out + CUE.outLen + 4, finish) -- safety net

        local function skip()
            if skipped or finished then return end
            skipped = true
            local t = trackTime()
            if t < CUE.out then
                CUE.out, CUE.outLen = t, 0.3
            end
            stopSound(0.5)
        end
        local hit = mk("TextButton", {
            Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false, ZIndex = 30,
        }, overlay)
        conns[#conns + 1] = hit.Activated:Connect(skip)

        local function appear(label, t, t1, a, y0, vis) -- fades in and slides up a little
            local k = smooth((t - t1) / 0.55)
            label.TextTransparency = 1 - k * vis * a
            label.Position = at(0, y0 + (1 - k) * 8)
        end
        local function status_text(p01)
            if p01 < 0.22 then return "Loading sounds" elseif p01 < 0.5 then return "Reading your inventory"
            elseif p01 < 0.78 then return "Getting your slots ready" elseif p01 < 0.985 then return "Almost there" end
            return "Ready"
        end

        local function render(t, wall, dt)
            local reveal = CUE.reveal
            local outP = clamp01((t - CUE.out) / CUE.outLen)
            local vis = smooth(wall / 0.45) * (1 - smooth(outP))
            local eAll, eLo, eHi = envAt("all", t), envAt("lo", t), envAt("hi", t)

            overlay.BackgroundTransparency = 1 - 0.8 * vis
            if blur then blur.Size = 16 * vis end
            stageScale.Scale = fitScale * (1 + 0.04 * smooth(outP))

            -- light behind everything
            local swell = smooth((t - 1.4) / 1.5)
            local after = reveal + 0.05
            local boost = (t > after) and math.exp(-(t - after) / 0.5) or 0
            setGlow(glowAv, vis * smooth(t / 0.9) * (0.09 + 0.17 * eAll + 0.08 * eLo))
            setGlow(glowAv2, vis * smooth(t / 0.9) * (0.05 + 0.10 * eLo))
            setGlow(glowWm, vis * swell * (0.05 + 0.13 * eHi + 0.15 * boost))
            setGlow(glowWm2, vis * swell * (0.04 + 0.10 * eHi + 0.20 * boost))

            -- avatar
            local aIn = smooth((t - 0.10) / 0.75)
            avScale.Scale = 0.6 + 0.4 * outBack((t - 0.10) / 0.8)
            local pulse = 0
            for _, n in ipairs(NOTES) do
                if t > n then pulse = math.max(pulse, math.exp(-(t - n) / 0.2)) end
            end
            photo.ImageTransparency = photoLoaded and (1 - aIn * vis) or 1
            photo.BackgroundTransparency = 1 - aIn * vis
            initial.TextTransparency = photoLoaded and 1 or (1 - aIn * vis)
            ringStroke.Transparency = 1 - aIn * vis
            ringStroke.Thickness = 2.5 + 1.5 * pulse + 2.5 * eLo
            ringGrad.Rotation = (t * 110) % 360
            haloStroke.Transparency = 1 - vis * aIn * (0.25 + 0.5 * pulse + 0.25 * eLo)
            local hs = 104 + 8 * pulse + 16 * eLo + 54 * boost
            halo.Size = px(hs)

            -- greeting and name slide in one after the other
            appear(hello, t, 0.45, 0.9, HELLO_Y, vis)
            appear(nameL, t, 0.60, 1, NAME_Y, vis)
            appear(userL, t, 0.80, 0.85, USER_Y, vis)
            appear(sub, t, 1.10, 0.9, SUB_Y, vis)

            -- progress
            local p01 = smooth((t - 0.5) / (reveal - 0.5 + 0.2))
            local barIn = smooth((t - 0.9) / 0.5) * vis
            track.BackgroundTransparency = 1 - 0.14 * barIn
            fill.Size = UDim2.new(p01, 0, 1, 0)
            ink.BackgroundTransparency = 1 - barIn
            head.Position = UDim2.new(p01, 0, 0.5, 0)
            head.BackgroundTransparency = 1 - barIn * (0.25 + 0.35 * eHi) * (1 - smooth((t - reveal - 0.3) / 0.4))
            headCore.BackgroundTransparency = 1 - barIn * (1 - smooth((t - reveal - 0.3) / 0.4))
            status.TextTransparency = 1 - smooth((t - 0.9) / 0.5) * vis * 0.9
            local st = status_text(p01)
            if status.Text ~= st then
                status.Text = st
                status.TextColor3 = (st == "Ready") and PAL[1] or Color3.fromRGB(132, 150, 194)
            end

            -- the wordmark: dim until the swell arrives, then the letters ignite one after the other and the colours start to flow
            local ghost = smooth((t - 1.0) / 0.9) * 0.22
            local flow = t * ((t < CUE.settle) and 0.17 or 0.09)
            for i, L in ipairs(letters) do
                local ig = clamp01((t - (reveal + (i - 1) * 0.05)) / 0.3)
                if ig <= 0 then
                    L.lab.TextColor3 = GHOST
                    L.lab.TextTransparency = 1 - ghost * vis
                    L.st.Transparency = 1
                    L.sc.Scale = 1
                else
                    local c = pal(flow + (i - 1) * 0.1)
                    local d1 = (t - (reveal + 0.15) - (i - 1) * 0.06) / 0.11 -- a pass of light along the word right after it ignites,
                    local d2 = (t - (CUE.settle - 0.2) - (i - 1) * 0.06) / 0.11 -- and a softer one when it settles
                    local sheen = math.max(0.9 * math.exp(-d1 * d1), 0.45 * math.exp(-d2 * d2))
                    L.lab.TextColor3 = WHITE:Lerp(c, smooth(ig * 1.5)):Lerp(WHITE, clamp01(sheen))
                    L.lab.TextTransparency = 1 - vis
                    L.sc.Scale = 1.22 - 0.22 * outBack(ig)
                    L.st.Color = c
                    L.st.Thickness = 1 + 1.6 * eHi + 1.8 * (1 - ig)
                    L.st.Transparency = 1 - vis * (0.18 + 0.25 * eHi + 0.35 * (1 - ig))
                end
            end

            -- flash, rings, streak
            local d = t - reveal
            local shape = 0
            if d > 0 then shape = (d < 0.05) and (d / 0.05) or math.exp(-(d - 0.05) / 0.12) end
            flash.BackgroundTransparency = 1 - 0.12 * shape * vis
            for i, R in ipairs(rings) do
                local r = clamp01((d - (i - 1) * 0.14) / 0.8)
                R.f.Visible = r > 0 and r < 1
                if R.f.Visible then
                    R.f.Size = px((30 + 500 * outCubic(r)) * fitScale)
                    R.st.Thickness = (2.4 - 1.8 * r) * (i == 1 and 1 or 0.7)
                    R.st.Transparency = 1 - vis * (1 - r) * 0.65
                end
            end
            local fr = clamp01(d / 0.7)
            flare.Visible = fr > 0 and fr < 1
            if flare.Visible then
                flare.Size = UDim2.fromOffset(900 * fitScale * outCubic(fr), 2)
                flare.BackgroundTransparency = 1 - vis * (1 - fr) * 0.9
            end

            -- sparkles: they rise faster and brighter as the sparkle band of the track gets louder
            dt = math.min(dt or 1 / 60, 0.1)
            for i, s in ipairs(sparks) do
                s.y = (s.y - s.v * dt * (1 + 2.5 * eHi)) % 1
                local twinkle = 0.5 + 0.5 * math.sin(t * 3 + s.ph)
                local edge = math.sin(math.pi * s.y)
                local a = vis * smooth((t - 0.3) / 0.8) * (0.15 + 0.85 * eHi) * (0.35 + 0.65 * twinkle) * edge
                s.f.Position = UDim2.new(s.x + s.sw * math.sin(t * 0.8 + s.ph), 0, s.y, 0)
                s.f.BackgroundTransparency = 1 - clamp01(a)
            end

            skipHint.TextTransparency = 1 - smooth((t - 1.2) / 0.6) * vis * 0.55

            if t >= CUE.out + 0.18 then callDone() end -- the menu comes up while the screen dissolves
            if t >= CUE.out + CUE.outLen + 0.02 then finish() end
        end

        conns[#conns + 1] = RunService.RenderStepped:Connect(function(dt)
            if finished then return end
            local ok = pcall(function()
                if not overlay.Parent then finish() return end
                render(trackTime(), os.clock() - created, dt)
            end)
            if not ok then
                frameErrors = frameErrors + 1
                if frameErrors >= 3 then finish() end -- a broken picture must never trap the menu behind it
            end
        end)
    end

