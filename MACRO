-- Exotica Hotbar Diagnostic (standalone, does NOT change anything, only listens and logs)
-- Run it by itself (no other Exotica script needed), then reproduce the disappearing hotbar.
-- Everything is printed to the console (F9) and saved to Exotica_Hotbar_Diagnostic.txt.
-- Press RightShift at any time to print a full snapshot of the hotbar state right now.

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")
local p = Players.LocalPlayer

local FILE = "Exotica_Hotbar_Diagnostic.txt"
local t0 = os.clock()
local lines, flushQueued, inLog = {}, false, false

local function log(...)
    if inLog then return end
    inLog = true
    local parts = { string.format("[%7.2f]", os.clock() - t0) }
    for _, v in ipairs({ ... }) do parts[#parts + 1] = tostring(v) end
    local line = table.concat(parts, " ")
    print("[HotbarDiag] " .. line)
    lines[#lines + 1] = line
    if #lines > 1500 then table.remove(lines, 1) end
    if writefile and not flushQueued then
        flushQueued = true
        task.delay(1.5, function()
            flushQueued = false
            pcall(writefile, FILE, table.concat(lines, "\n"))
        end)
    end
    inLog = false
end

local function trace(skip)
    return (debug.traceback("", skip or 2):gsub("\n", " <- "))
end


-- runs one step; if it errors, the error is LOGGED and the rest of the script keeps going
local function step(name, fn)
    local ok, err = pcall(fn)
    if ok then log("step ok:", name) else log("step FAILED:", name, "|", tostring(err)) end
end

-- sets t[k] = v even if the table is read-only (frozen), when the executor allows it
local function patch(t, k, v)
    local ok = pcall(function() t[k] = v end)
    if ok then return true end
    pcall(function() if setreadonly then setreadonly(t, false) end end)
    local ok2, err = pcall(function() t[k] = v end)
    if ok2 then return true end
    log("could not patch", k, "|", tostring(err), "| table readonly:", tostring(isreadonly and isreadonly(t)), "| frozen:", tostring(table.isfrozen and table.isfrozen(t)))
    return false
end

------------------------------------------------------------
-- find the game's pieces
------------------------------------------------------------
local Satchel, Ctrl
pcall(function() Satchel = require(RS:WaitForChild("Modules", 15):WaitForChild("Satchel", 15)) end)
pcall(function()
    Ctrl = require(p:WaitForChild("PlayerScripts", 15):WaitForChild("Controllers", 30):WaitForChild("BackpackController", 30))
end)
log("Satchel:", Satchel and "found" or "MISSING", "| BackpackController:", type(Ctrl) == "table" and "found" or "MISSING")

local function getGui()
    local pg = p:FindFirstChildOfClass("PlayerGui")
    local g = pg and pg:FindFirstChild("BackpackGui")
    local backpack = g and g:FindFirstChild("Backpack")
    local hotbar = backpack and backpack:FindFirstChild("Hotbar")
    return g, backpack, hotbar
end

local function activeAttributes()
    local on = {}
    for k, v in pairs(p:GetAttributes()) do
        if v then on[#on + 1] = k .. "=" .. tostring(v) end
    end
    table.sort(on)
    return #on > 0 and table.concat(on, ", ") or "(none)"
end

local function toolList()
    local names = {}
    local c = p.Character
    if c then
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") then names[#names + 1] = t.Name end
        end
    end
    return #names > 0 and table.concat(names, ", ") or "(none)"
end

local function snapshot(reason)
    local g, backpack, hotbar = getGui()
    local topbar
    pcall(function() topbar = StarterGui:GetCore("TopbarEnabled") end)
    local visibleSlots, totalSlots = 0, 0
    if hotbar then
        for _, s in ipairs(hotbar:GetChildren()) do
            if s:IsA("GuiObject") then
                totalSlots = totalSlots + 1
                if s.Visible then visibleSlots = visibleSlots + 1 end
            end
        end
    end
    local satchelOn
    if Satchel then pcall(function() satchelOn = Satchel:GetBackpackEnabled() end) end
    log("SNAPSHOT", reason or "",
        "| Satchel enabled:", satchelOn,
        "| TopbarEnabled:", topbar,
        "| BackpackGui:", g and ("Enabled=" .. tostring(g.Enabled)) or "MISSING",
        "| Backpack.Visible:", backpack and tostring(backpack.Visible) or "MISSING",
        "| Hotbar.Visible:", hotbar and tostring(hotbar.Visible) or "MISSING",
        "| slot frames visible:", visibleSlots .. "/" .. totalSlots,
        "| game attributes on:", activeAttributes(),
        "| tools held:", toolList())
end

------------------------------------------------------------
-- 1) Satchel on/off calls, with who called
------------------------------------------------------------
step("hook Satchel:SetBackpackEnabled", function()
    if not Satchel then error("Satchel missing") end
    local orig = Satchel.SetBackpackEnabled
    patch(Satchel, "SetBackpackEnabled", function(self, value, ...)
        log("Satchel:SetBackpackEnabled(" .. tostring(value) .. ") | attributes on:", activeAttributes())
        log("   caller:", trace(2))
        return orig(self, value, ...)
    end)
end)

------------------------------------------------------------
-- 2) the game's own backpack controller (anti-spam and toggles)
------------------------------------------------------------
step("hook BackpackController", function()
    if type(Ctrl) ~= "table" then error("BackpackController missing") end
    for _, name in ipairs({ "_disableSpam", "_toggleBackpackTo", "_disable", "_enable" }) do
        local orig = Ctrl[name]
        if type(orig) == "function" then
            patch(Ctrl, name, function(self, a, ...)
                local arg = (name == "_toggleBackpackTo") and (" (" .. tostring(a) .. ")") or ""
                log("BackpackController." .. name .. arg .. " | _spamDelay:", tostring(self._spamDelay))
                if name == "_disableSpam" then
                    log("   >>> the game's ANTI-SPAM fired. Too many tool equips in a row.")
                end
                return orig(self, a, ...)
            end)
        else
            log("BackpackController." .. name .. " is not a function:", type(orig))
        end
    end
end)

------------------------------------------------------------
-- 3) calls into the engine we care about (needs an executor with hookmetamethod)
------------------------------------------------------------
if hookmetamethod and getnamecallmethod then
    local okHook, errHook = pcall(function()
        local old
        old = hookmetamethod(game, "__namecall", (newcclosure or function(f) return f end)(function(self, ...)
            local m = getnamecallmethod()
            if m == "UnequipTools" or m == "SetCore" or m == "SetCoreGuiEnabled" then
                local a, b = ... -- read the arguments here: a nested function can't use "..."
                pcall(function()
                    local ok = true
                    if m == "SetCore" then
                        ok = (a == "TopbarEnabled")
                    elseif m == "SetCoreGuiEnabled" then
                        ok = (a == Enum.CoreGuiType.Backpack or a == Enum.CoreGuiType.All)
                    end
                    if ok and not (checkcaller and checkcaller()) then
                        log("ENGINE CALL:", m, tostring(a), tostring(b))
                        log("   caller:", trace(2))
                    end
                end)
            end
            return old(self, ...)
        end))
    end)
    if okHook then
        log("namecall hook installed (UnequipTools / SetCore TopbarEnabled / SetCoreGuiEnabled)")
    else
        log("namecall hook FAILED, continuing without it:", tostring(errHook))
    end
else
    log("this executor has no hookmetamethod, engine calls will not be logged")
end

step("listeners", function()
    ------------------------------------------------------------
    -- 4) the visible state of the hotbar itself
    ------------------------------------------------------------
    local hooked = setmetatable({}, { __mode = "k" })
    local function hookProp(inst, prop, label)
        if not inst or hooked[inst] then return end
        hooked[inst] = true
        inst:GetPropertyChangedSignal(prop):Connect(function()
            log(label .. "." .. prop .. " changed to", tostring(inst[prop]))
            if prop == "Visible" or prop == "Enabled" then
                if inst[prop] == false then snapshot(label .. " turned OFF") end
            end
        end)
    end

    local function hookGui()
        local g, backpack, hotbar = getGui()
        hookProp(g, "Enabled", "BackpackGui")
        hookProp(backpack, "Visible", "Backpack")
        hookProp(hotbar, "Visible", "Hotbar")
        if hotbar then
            for _, s in ipairs(hotbar:GetChildren()) do hookProp(s, "Visible", "Slot " .. s.Name) end
        end
    end

    task.spawn(function()
        while true do
            hookGui()
            task.wait(1)
        end
    end)

    -- TopbarEnabled has no signal (the game's Heartbeat reads it every frame), so watch it
    local lastTopbar
    RunService.Heartbeat:Connect(function()
        local ok, v = pcall(function() return StarterGui:GetCore("TopbarEnabled") end)
        if ok and v ~= lastTopbar then
            lastTopbar = v
            log("TopbarEnabled is now", tostring(v))
            if v == false then snapshot("TopbarEnabled turned OFF") end
        end
    end)

    if Satchel then
        local lastSatchel
        RunService.Heartbeat:Connect(function()
            local ok, v = pcall(function() return Satchel:GetBackpackEnabled() end)
            if ok and v ~= lastSatchel then
                lastSatchel = v
                log("Satchel hotbar enabled is now", tostring(v))
                if v == false then snapshot("Satchel turned OFF") end
            end
        end)
    end

    ------------------------------------------------------------
    -- 5) player attributes (the game's reasons) and your tools
    ------------------------------------------------------------
    p.AttributeChanged:Connect(function(name)
        local v = p:GetAttribute(name)
        log("player attribute", name, "=", tostring(v))
    end)

    local function watchChar(char)
        if not char then return end
        char.ChildAdded:Connect(function(c) if c:IsA("Tool") then log("EQUIPPED  ", c.Name) end end)
        char.ChildRemoved:Connect(function(c) if c:IsA("Tool") then log("UNEQUIPPED", c.Name) end end)
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then hum.Died:Connect(function() log("character died") end) end
    end
    watchChar(p.Character)
    p.CharacterAdded:Connect(function(c) log("character respawned") watchChar(c) end)

    local bpFolder = p:FindFirstChildOfClass("Backpack")
    if bpFolder then
        bpFolder.ChildAdded:Connect(function(c) if c:IsA("Tool") then log("backpack +", c.Name) end end)
        bpFolder.ChildRemoved:Connect(function(c) if c:IsA("Tool") then log("backpack -", c.Name) end end)
    end

    ------------------------------------------------------------
    -- manual snapshot key
    ------------------------------------------------------------
    UIS.InputBegan:Connect(function(input, gpe)
        if input.KeyCode == Enum.KeyCode.RightShift then snapshot("manual (RightShift)") end
    end)

    snapshot("start")
    log("Listening. Equip a lot of tools fast until the hotbar disappears, then send me Exotica_Hotbar_Diagnostic.txt (or the console lines starting with HotbarDiag).")

end)
